<script>
  (function() {
    const form = document.getElementById('BulkEnquiryForm-{{ section.id }}');
    if (!form || form.__gtBound) return;
    form.__gtBound = true;

    const submitBtn = form.querySelector('[data-submit-btn]');
    const submitLabel = form.querySelector('[data-submit-label]');
    const defaultLabel = submitLabel ? submitLabel.textContent : 'Submit';
    const successBox = form.querySelector('[data-status-success]');
    const errorBox = form.querySelector('[data-status-error]');
    const errorText = form.querySelector('[data-error-text]');
    const resetBtn = form.querySelector('[data-reset-form]');

    const clearFieldError = (el) => {
      const wrap = el.closest('[data-field]');
      if (wrap) wrap.classList.remove('is-invalid');
    };

    const multiselects = Array.from(form.querySelectorAll('[data-multiselect]'));

    const closeMultiselect = (ms) => {
      ms.classList.remove('is-open');
      const trig = ms.querySelector('[data-multiselect-trigger]');
      if (trig) trig.setAttribute('aria-expanded', 'false');
    };

    const syncMultiselect = (ms) => {
      const tagsWrap = ms.querySelector('[data-multiselect-tags]');
      const placeholderEl = ms.querySelector('[data-multiselect-placeholder]');
      const emptyEl = ms.querySelector('[data-multiselect-empty]');
      const inputs = Array.from(ms.querySelectorAll('[data-multiselect-input]'));
      const optBtns = Array.from(ms.querySelectorAll('[data-multiselect-option]'));
      if (!tagsWrap) return;

      tagsWrap.textContent = '';
      let selectedCount = 0;

      inputs.forEach((input, idx) => {
        const optBtn = optBtns[idx];
        if (input.checked) {
          selectedCount += 1;
          if (optBtn) {
            optBtn.hidden = true;
            optBtn.setAttribute('aria-selected', 'true');
          }
          const tag = document.createElement('span');
          tag.className = 'bulk-enquiry__tag';

          const label = document.createElement('span');
          label.textContent = input.value;

          const removeBtn = document.createElement('button');
          removeBtn.type = 'button';
          removeBtn.className = 'bulk-enquiry__tag-remove';
          removeBtn.setAttribute('aria-label', 'Remove ' + input.value);
          removeBtn.textContent = '\u00D7';
          removeBtn.addEventListener('click', (ev) => {
            ev.stopPropagation();
            input.checked = false;
            syncMultiselect(ms);
          });

          tag.appendChild(label);
          tag.appendChild(removeBtn);
          tagsWrap.appendChild(tag);
        } else if (optBtn) {
          optBtn.hidden = false;
          optBtn.setAttribute('aria-selected', 'false');
        }
      });

      if (placeholderEl) placeholderEl.hidden = selectedCount > 0;
      if (emptyEl) emptyEl.hidden = selectedCount < inputs.length;
    };

    multiselects.forEach((ms) => {
      const trigger = ms.querySelector('[data-multiselect-trigger]');
      const inputs = Array.from(ms.querySelectorAll('[data-multiselect-input]'));
      const optBtns = Array.from(ms.querySelectorAll('[data-multiselect-option]'));

      const toggleOpen = () => {
        const nextOpen = !ms.classList.contains('is-open');
        multiselects.forEach((other) => {
          if (other !== ms) closeMultiselect(other);
        });
        ms.classList.toggle('is-open', nextOpen);
        if (trigger) trigger.setAttribute('aria-expanded', nextOpen ? 'true' : 'false');
      };

      if (trigger) {
        trigger.addEventListener('click', (ev) => {
          if (ev.target.closest('.bulk-enquiry__tag-remove')) return;
          toggleOpen();
        });
        trigger.addEventListener('keydown', (ev) => {
          if (ev.key === 'Enter' || ev.key === ' ') {
            ev.preventDefault();
            toggleOpen();
          } else if (ev.key === 'Escape') {
            closeMultiselect(ms);
          }
        });
      }

      optBtns.forEach((btn, idx) => {
        btn.addEventListener('click', () => {
          const input = inputs[idx];
          if (!input) return;
          input.checked = true;
          syncMultiselect(ms);
          clearFieldError(ms);
        });
      });

      syncMultiselect(ms);
    });

    document.addEventListener('click', (ev) => {
      multiselects.forEach((ms) => {
        if (!ms.contains(ev.target)) closeMultiselect(ms);
      });
    });

    document.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape') {
        multiselects.forEach((ms) => closeMultiselect(ms));
      }
    });

    form.querySelectorAll('input, select, textarea').forEach((el) => {
      el.addEventListener('input', () => clearFieldError(el));
      el.addEventListener('change', () => clearFieldError(el));
    });

    const resetFormUI = () => {
      form.reset();
      multiselects.forEach((ms) => {
        closeMultiselect(ms);
        syncMultiselect(ms);
      });
    };

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        resetFormUI();
        successBox.hidden = true;
        errorBox.hidden = true;
        form.querySelectorAll('[data-field].is-invalid').forEach((w) => w.classList.remove('is-invalid'));
      });
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      successBox.hidden = true;
      errorBox.hidden = true;

      // Honeypot bot guard
      const hp = form.querySelector('input[name="website"]');
      if (hp && hp.value.trim() !== '') return;

      let firstInvalid = null;
      form.querySelectorAll('[required], [data-checkbox-group][data-required="true"]').forEach((el) => {
        const wrap = el.closest('[data-field]');
        let valid = true;
        let focusEl = el;
        if (el.matches('[data-checkbox-group]')) {
          valid = el.querySelectorAll('input[type="checkbox"]:checked').length > 0;
          focusEl = el.querySelector('[data-multiselect-trigger]') || el.querySelector('input[type="checkbox"]') || el;
        } else {
          valid = el.checkValidity() && el.value.trim() !== '';
        }
        if (wrap) wrap.classList.toggle('is-invalid', !valid);
        if (!valid && !firstInvalid) firstInvalid = focusEl;
      });

      if (firstInvalid) {
        firstInvalid.focus();
        firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }

      const webhookUrl = (form.dataset.webhookUrl || '').trim();
      if (!webhookUrl) {
        errorText.textContent = 'Form destination is not configured yet. Please add your Google Apps Script Web App URL in Theme Editor -> Bulk Enquiry Form.';
        errorBox.hidden = false;
        return;
      }

      const fd = new FormData(form);
      const customiseSelected = fd.getAll('customise').map((v) => v.toString().trim()).filter(Boolean).join(', ');
      const payload = {
        looking_for: (fd.get('looking_for') || '').toString().trim(),
        customise: customiseSelected,
        other_requirements: '',
        idea_details: (fd.get('idea_details') || '').toString().trim(),
        quantity: (fd.get('quantity') || '').toString().trim(),
        budget: (fd.get('budget') || '').toString().trim(),
        needed_by: (fd.get('needed_by') || '').toString().trim(),
        occasion: (fd.get('occasion') || '').toString().trim(),
        delivery_location: (fd.get('delivery_location') || '').toString().trim(),
        name: (fd.get('name') || '').toString().trim(),
        company: (fd.get('company') || '').toString().trim(),
        email: (fd.get('email') || '').toString().trim(),
        phone: (fd.get('phone') || '').toString().trim(),
        additional_notes: (fd.get('additional_notes') || '').toString().trim(),
        page_url: window.location.href
      };

      submitBtn.disabled = true;
      if (submitLabel) submitLabel.textContent = 'Submitting...';

      try {
        // Use text/plain to avoid CORS preflight OPTIONS requests rejected by Google Apps Script
        const response = await fetch(webhookUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify(payload)
        });

        if (!response.ok) {
          throw new Error('HTTP ' + response.status);
        }

        const result = await response.json().catch(() => ({ ok: true }));
        if (result && result.ok === false) {
          throw new Error(result.error || 'Submission failed');
        }

        resetFormUI();
        successBox.hidden = false;
      } catch (err) {
        console.error('[BulkEnquiry] Submit failed:', err);
        errorText.textContent = 'Could not submit your enquiry right now. Please try again or email us at support@graffeinetales.com.';
        errorBox.hidden = false;
      } finally {
        submitBtn.disabled = false;
        if (submitLabel) submitLabel.textContent = defaultLabel;
      }
    });
  })();
</script>

