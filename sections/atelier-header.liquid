{{ 'atelier-header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'atelier-header.js' | asset_url }}" defer></script>
<atelier-header class="atelier-header" data-sticky="{{ section.settings.sticky }}" style="--header-background:{{ section.settings.background }};--header-text:{{ section.settings.text }};--header-accent:{{ section.settings.accent }};--header-logo-height:{{ section.settings.logo_height }}px;--header-mobile-logo-height:{{ section.settings.mobile_logo_height }}px;--header-desktop-height:{{ section.settings.height }}px;--header-mobile-height:{{ section.settings.mobile_height }}px;--header-width:{{ section.settings.width }}px;--header-menu-size:{{ section.settings.menu_font_size | default: 14 }}px;--header-menu-weight:{{ section.settings.menu_font_weight | default: 500 }};--header-menu-transform:{{ section.settings.menu_text_transform | default: 'none' }}">
<header class="atelier-header__bar" role="banner">
  <div class="atelier-header__inner">
    <button type="button" class="atelier-header__action atelier-header__hamburger" data-open-mobile aria-label="Open navigation menu" aria-haspopup="dialog">{% render 'header-icon', name: 'menu' %}</button>
    <a class="atelier-header__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {% if section.settings.show_cup %}<span class="atelier-header__cup{% if section.settings.animate_steam %} atelier-header__cup--steam{% endif %}">{% if section.settings.cup_image != blank %}{{ section.settings.cup_image | image_url: width: 120 | image_tag: loading: 'eager', widths: '60,120', alt: '' }}{% else %}<img src="{{ 'header-cup.png' | asset_url }}" width="30" height="44" loading="eager" alt="">{% endif %}<span class="atelier-header__steam" aria-hidden="true"></span><span class="atelier-header__steam atelier-header__steam--second" aria-hidden="true"></span></span>{% endif %}
      {% if section.settings.logo != blank %}{{ section.settings.logo | image_url: width: 440 | image_tag: class: 'atelier-header__wordmark', widths: '220,440', loading: 'eager', fetchpriority: 'high', alt: shop.name }}{% else %}<img class="atelier-header__wordmark" src="{{ 'brand-wordmark.png' | asset_url }}" width="140" height="44" loading="eager" fetchpriority="high" alt="{{ shop.name | escape }}">{% endif %}
    </a>
    <nav class="atelier-header__navigation" aria-label="Main navigation">
      <ul class="atelier-header__menu" role="list">
        {% assign menu_links = section.settings.menu.links | default: linklists.main-menu.links %}
        {% for link in menu_links %}
          <li>
            {% if link.links != blank %}
              <details class="atelier-header__dropdown" data-header-dropdown>
                <summary>{{ link.title | escape }}{% render 'header-icon', name: 'chevron' %}</summary>
                <div class="atelier-header__mega">
                  <ul class="atelier-header__submenu" role="list">
                    {% for child in link.links %}
                      <li>
                        <a href="{{ child.url }}"><span>{{ child.title | escape }}</span></a>
                        {% if child.links != blank %}
                          <ul role="list">
                            {% for grandchild in child.links %}
                              <li><a href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a></li>
                            {% endfor %}
                          </ul>
                        {% endif %}
                      </li>
                    {% endfor %}
                  </ul>
                  <a class="atelier-header__explore" href="{{ link.url }}">Explore {{ link.title | escape }}{% render 'header-icon', name: 'arrow' %}</a>
                </div>
              </details>
            {% else %}
              <a class="atelier-header__top-link" href="{{ link.url }}">{{ link.title | escape }}</a>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </nav>
    <div class="atelier-header__actions">
      {% if section.settings.show_search %}<div class="atelier-header__search">{% render 'header-search', input_id: 'AtelierSearchInput' %}</div>{% endif %}
      {% if section.settings.show_wishlist %}<button type="button" class="atelier-header__action atelier-header__wishlist" data-open-wishlist aria-label="Your saved stories" aria-haspopup="dialog">{% render 'header-icon', name: 'heart' %}<span class="atelier-header__badge" data-wishlist-count hidden>0</span></button>{% endif %}
      {% if section.settings.show_cart %}<a class="atelier-header__action header__icon--cart" id="cart-icon-bubble" href="{{ routes.cart_url }}" aria-label="{{ 'templates.cart.cart' | t }}">
        {% render 'header-icon', name: 'bag' %}
        <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
        {% if cart.item_count > 0 %}<div class="cart-count-bubble atelier-header__badge"><span aria-hidden="true">{{ cart.item_count }}</span><span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span></div>{% endif %}
      </a>{% endif %}
    </div>
  </div>
</header>
<dialog class="atelier-header__drawer atelier-header__mobile-drawer" data-mobile-dialog aria-labelledby="MobileMenuHeading-{{ section.id }}">
  <div class="atelier-header__drawer-heading">
    <h2 id="MobileMenuHeading-{{ section.id }}">Explore the atelier</h2>
    <button type="button" class="atelier-header__action" data-close-dialog aria-label="Close menu">{% render 'header-icon', name: 'close' %}</button>
  </div>
  <nav aria-label="Mobile navigation">
    {% assign mobile_links = section.settings.menu.links | default: linklists.main-menu.links %}
    {% for link in mobile_links %}
      {% if link.links != blank %}
        <details class="atelier-header__mobile-group">
          <summary>{{ link.title | escape }}{% render 'header-icon', name: 'chevron' %}</summary>
          <ul class="atelier-header__submenu" role="list">
            {% for child in link.links %}
              <li>
                <a href="{{ child.url }}">{{ child.title | escape }}</a>
                {% if child.links != blank %}
                  <ul role="list">
                    {% for grandchild in child.links %}
                      <li><a href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a></li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
          <a class="atelier-header__explore" href="{{ link.url }}">Explore {{ link.title | escape }}{% render 'header-icon', name: 'arrow' %}</a>
        </details>
      {% else %}
        <div class="atelier-header__mobile-item">
          <a href="{{ link.url }}">{{ link.title | escape }}</a>
        </div>
      {% endif %}
    {% endfor %}
  </nav>
  <div class="atelier-header__mobile-footer">
    {% if shop.customer_accounts_enabled %}
      <a class="atelier-header__mobile-footer-link" href="{{ routes.account_url }}">
        <span class="atelier-header__mobile-footer-icon">{% render 'header-icon', name: 'account' %}</span>
        <span>
          {%- if customer -%}
            {{ customer.first_name | default: 'Account' }}
          {%- else -%}
            {{ 'customer.log_in' | t | default: 'Account' }}
          {%- endif -%}
        </span>
      </a>
    {% endif %}
    {% if section.settings.show_wishlist %}
      <button type="button" class="atelier-header__mobile-footer-link" data-open-wishlist-from-menu aria-label="Wishlist">
        <span class="atelier-header__mobile-footer-icon">
          {% render 'header-icon', name: 'heart' %}
          <span class="atelier-header__badge" data-wishlist-count hidden>0</span>
        </span>
        <span>Wishlist</span>
      </button>
    {% endif %}
  </div>
</dialog>
<dialog class="atelier-header__drawer" data-wishlist-dialog aria-labelledby="WishlistHeading-{{ section.id }}" data-remove-label="Remove">
  <div class="atelier-header__drawer-heading">
    <h2 id="WishlistHeading-{{ section.id }}">Your saved stories</h2>
    <button type="button" class="atelier-header__action" data-close-dialog aria-label="Close wishlist">{% render 'header-icon', name: 'close' %}</button>
  </div>
  <div class="atelier-header__saved-items" data-saved-items></div>
  <div class="atelier-header__empty" data-wishlist-empty><p>Save the pieces you love. Your favourites will appear here.</p><a class="button" href="{{ routes.all_products_collection_url }}">Explore the collection</a></div>
</dialog>
</atelier-header>
{% schema %}
{
  "name": "Atelier header",
  "tag": "section",
  "class": "atelier-header-section",
  "limit": 1,
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main menu",
      "default": "main-menu",
      "info": "Select the primary navigation menu from Online Store → Navigation."
    },
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Wordmark",
      "info": "Uses the supplied Graffeine Tales wordmark until an image is selected."
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Desktop wordmark height",
      "min": 24,
      "max": 54,
      "step": 2,
      "unit": "px",
      "default": 38
    },
    {
      "type": "range",
      "id": "mobile_logo_height",
      "label": "Mobile wordmark height",
      "min": 20,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "image_picker",
      "id": "cup_image",
      "label": "Cup illustration"
    },
    {
      "type": "checkbox",
      "id": "show_cup",
      "label": "Show cup beside wordmark",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "animate_steam",
      "label": "Animate cup steam",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout and appearance"
    },
    {
      "type": "range",
      "id": "menu_font_size",
      "label": "Menu font size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "menu_font_weight",
      "label": "Menu font weight",
      "options": [
        { "value": "400", "label": "Normal (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semi-bold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ],
      "default": "500"
    },
    {
      "type": "select",
      "id": "menu_text_transform",
      "label": "Menu text casing",
      "options": [
        { "value": "none", "label": "Default (Normal)" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "capitalize", "label": "Capitalize" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "sticky",
      "label": "Sticky behaviour",
      "options": [
        {
          "value": "up",
          "label": "Show on scroll up"
        },
        {
          "value": "always",
          "label": "Always visible"
        },
        {
          "value": "none",
          "label": "Not sticky"
        }
      ],
      "default": "up"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Desktop height",
      "min": 54,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 48,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "width",
      "label": "Content width",
      "min": 1100,
      "max": 1500,
      "step": 20,
      "unit": "px",
      "default": 1340
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#F8F5ED"
    },
    {
      "type": "color",
      "id": "text",
      "label": "Text and icons",
      "default": "#363638"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Badges and highlights",
      "default": "#927B53"
    },
    {
      "type": "header",
      "content": "Actions"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show wishlist",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show bag",
      "default": true
    }
  ]
}
{% endschema %}
