  letter-spacing: 0.06em !important;
  text-transform: uppercase !important;
  color: #1E1814 !important;
  text-decoration: none !important;
  background: transparent !important;
  border-top: none !important;
  border-left: none !important;
  border-right: none !important;
  cursor: pointer !important;
  width: 100% !important;
  text-align: left !important;
  list-style: none !important;
  user-select: none !important;
  transition: color 0.2s ease !important;
}
.atelier-drawer__row-link:hover {
  color: #4D351D !important;
}
.atelier-drawer__row-title {
  display: inline-block !important;
  position: relative !important;
  transition: all 0.2s ease !important;
}
.atelier-drawer__accordion-item.is-open .atelier-drawer__row-title {
  border-bottom: 2px solid var(--header-accent, #4D351D) !important;
  padding-bottom: 3px !important;
  color: #1A120B !important;
}
.atelier-drawer__row-link::-webkit-details-marker,
.atelier-drawer__row-link::marker {
  display: none !important;
  content: "" !important;
}
.atelier-drawer__row-arrow {
  font-size: 16px !important;
  color: rgba(54, 54, 56, 0.45) !important;
  transition: transform 0.2s ease, color 0.2s ease !important;
}
.atelier-drawer__row-link:hover .atelier-drawer__row-arrow {
  color: #4D351D !important;
  transform: translateX(3px) !important;
}

/* Accordion Item & Chevron */
.atelier-drawer__accordion-item {
  border-bottom: none !important;
  list-style: none !important;
}
.atelier-drawer__accordion-item .atelier-drawer__row-link {
  border-bottom: 1px solid rgba(54, 54, 56, 0.12) !important;
}
.atelier-drawer__chev {
  display: grid !important;
  place-items: center !important;
  width: 20px !important;
  height: 20px !important;
  transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), color 0.25s ease !important;
  color: rgba(54, 54, 56, 0.45) !important;
}
.atelier-drawer__chev svg {
  width: 14px !important;
  height: 14px !important;
  stroke: currentColor !important;
}
.atelier-drawer__accordion-item.is-open .atelier-drawer__chev {
  transform: rotate(180deg) !important;
  color: #4D351D !important;
}

/* Superkicks-style smooth CSS Grid Accordion Dropdown */
.atelier-drawer__accordion-body {
  display: grid !important;
  grid-template-rows: 0fr !important;
  transition: grid-template-rows 0.35s cubic-bezier(0.22, 1, 0.36, 1) !important;
  padding: 0 !important;
  margin: 0 !important;
  overflow: hidden !important;
  border-bottom: 1px solid rgba(54, 54, 56, 0.12) !important;
}
.atelier-drawer__accordion-inner {
  min-height: 0 !important;
  overflow: hidden !important;
  opacity: 0 !important;
  transform: translateY(-8px) !important;
  transition: opacity 0.26s cubic-bezier(0.22, 1, 0.36, 1), transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), padding 0.35s cubic-bezier(0.22, 1, 0.36, 1) !important;
  padding: 0 2px 0 2px !important;
}
.atelier-drawer__accordion-item.is-open > .atelier-drawer__accordion-body {
  grid-template-rows: 1fr !important;
}
.atelier-drawer__accordion-item.is-open > .atelier-drawer__accordion-body > .atelier-drawer__accordion-inner {
  opacity: 1 !important;
  transform: translateY(0) !important;
  padding: 16px 2px 24px 2px !important;
}

/* Superkicks Multi-Column Layout (Image 2 Reference) */
.atelier-drawer__columns {
  display: flex !important;
  flex-direction: row !important;
  flex-wrap: wrap !important;
  align-items: flex-start !important;
  gap: 20px 32px !important;
}
.atelier-drawer__col {
  flex: 0 0 auto !important;
  min-width: 82px !important;
  display: flex !important;
  flex-direction: column !important;
  gap: 10px !important;
}
.atelier-drawer__col-heading {
  display: block !important;
  font-size: 11.5px !important;
  font-weight: 700 !important;
  letter-spacing: 0.08em !important;
  text-transform: uppercase !important;
  color: var(--header-accent, #4D351D) !important;
  text-decoration: none !important;
  margin-bottom: 2px !important;
  transition: opacity 0.2s ease !important;
}
.atelier-drawer__col-heading:hover {
  opacity: 0.75 !important;
}
.atelier-drawer__col-list {
  list-style: none !important;
  margin: 0 !important;
  padding: 0 !important;
  display: flex !important;
  flex-direction: column !important;
  gap: 10px !important;
}
.atelier-drawer__col-list li {
  list-style: none !important;
  margin: 0 !important;
  padding: 0 !important;
  border: none !important;
}
.atelier-drawer__sublink {
  display: block !important;
  font-size: 11px !important;
  font-weight: 700 !important;
  letter-spacing: 0.04em !important;
  text-transform: uppercase !important;
  color: #363638 !important;
  text-decoration: none !important;
  line-height: 1.35 !important;
  padding: 0 !important;
  min-height: auto !important;
  border-radius: 0 !important;
  background: transparent !important;
  transition: color 0.2s ease, transform 0.2s ease !important;
}
.atelier-drawer__sublink:hover,
.atelier-drawer__sublink:focus,
.atelier-drawer__sublink:active {
  color: var(--header-accent, #4D351D) !important;
  background: transparent !important;
  transform: translateX(2px) !important;
}
.atelier-drawer__sublist--flat {
  list-style: none !important;
  margin: 0 !important;
  padding: 0 !important;
  display: grid !important;
  grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
  gap: 12px 18px !important;
  background: transparent !important;
  border: none !important;
}
.atelier-drawer__sublist--flat li {
  list-style: none !important;
  margin: 0 !important;
  padding: 0 !important;
  border: none !important;
}

/* Drawer Pinned Footer */
.atelier-drawer__footer {
  flex-shrink: 0 !important;
  padding: 16px 20px 20px !important;
  border-top: 1px solid rgba(54, 54, 56, 0.09) !important;
  background: #F8F5ED !important;
  display: flex !important;
  flex-direction: column !important;
  gap: 12px !important;
}
.atelier-drawer__footer-actions {
  display: grid !important;
  grid-template-columns: 1fr 1fr !important;
  gap: 10px !important;
}
.atelier-drawer__btn {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 8px !important;
  height: 44px !important;
  border-radius: 999px !important;
  font-size: 13.5px !important;
  font-weight: 600 !important;
  text-decoration: none !important;
  cursor: pointer !important;
  transition: all 0.2s ease !important;
}
.atelier-drawer__btn--call {
  background: #ffffff !important;
  color: #363638 !important;
  border: 1.5px solid #363638 !important;
}
.atelier-drawer__btn--call:hover {
  background: #f5f2eb !important;
}
.atelier-drawer__btn--call svg {
  width: 16px !important;
  height: 16px !important;
  stroke: currentColor !important;
}
.atelier-drawer__btn--wa {
  background: #1E7E4E !important;
  color: #FFFFFF !important;
  border: 1.5px solid #1E7E4E !important;
  box-shadow: 0 2px 8px rgba(30, 126, 78, 0.25) !important;
}
.atelier-drawer__btn--wa:hover {
  background: #17653E !important;
  border-color: #17653E !important;
}
.atelier-drawer__btn--wa svg {
  width: 17px !important;
  height: 17px !important;
  fill: currentColor !important;
}
.atelier-drawer__footer-meta {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  font-size: 12.5px !important;
  color: rgba(54, 54, 56, 0.75) !important;
  padding-top: 2px !important;
}
.atelier-drawer__footer-account {
  display: inline-flex !important;
  align-items: center !important;
  gap: 6px !important;
  color: #363638 !important;
  text-decoration: none !important;
  font-weight: 500 !important;
  transition: color 0.2s ease !important;
}
.atelier-drawer__footer-account:hover {
  color: #4D351D !important;
}
.atelier-drawer__footer-account-icon svg {
  width: 16px !important;
  height: 16px !important;
}
.atelier-drawer__footer-hours {
  font-size: 11.5px !important;
  color: rgba(54, 54, 56, 0.55) !important;
  letter-spacing: 0.02em !important;
}
.atelier-drawer__footer-tagline {
  text-align: center !important;
  font-size: 11px !important;
  color: rgba(54, 54, 56, 0.5) !important;
  margin: 0 !important;
  line-height: 1.3 !important;
}

/* Clearances for non-banner pages */
body:not(.template-index):not(.template-collection) #MainContent > .shopify-section:first-child:not(:has(.atelier-col-hero)):not(:has(.atelier-hero)):not(:has(.image-banner)):not(:has(.slideshow)) {
  padding-top: calc(var(--header-height, 120px) + 24px) !important;
}

{%- endstyle -%}

<section
  id="shopify-section-{{ section.id }}"
  class="atelier-header-section{% if s.sticky %} is-sticky{% endif %}"
  data-section-id="{{ section.id }}"
>
  {%- comment -%} ==================== A. ANNOUNCEMENT BAR ==================== {%- endcomment -%}
  {%- if show_announcement -%}
    <aside
      class="atelier-announcement atelier-announcement--{{ s.announcement_visibility }}{% if s.announcement_scroll %} atelier-announcement--marquee{% endif %}"
      aria-label="Announcement"
    >
      <div class="atelier-announcement__inner">
        <div class="atelier-announcement__content atelier-announcement__content--{{ s.announcement_align }}">
          {%- if s.announcement_scroll -%}
            <div class="atelier-announcement__track">
              <span>{{ s.announcement_text | escape }}</span>
              <span>{{ s.announcement_text | escape }}</span>
              <span>{{ s.announcement_text | escape }}</span>
            </div>
          {%- else -%}
            {%- if s.announcement_link != blank -%}
              <a href="{{ s.announcement_link }}" class="atelier-announcement__link">
                <span>{{ s.announcement_text | escape }}</span>
                {{ icon_arrow }}
              </a>
            {%- else -%}
              <span>{{ s.announcement_text | escape }}</span>
            {%- endif -%}
          {%- endif -%}
        </div>

        {%- if s.show_country_selector -%}
          <div class="atelier-announcement__country">
            <span>IN</span>
            <span>({{ cart.currency.iso_code }})</span>
          </div>
        {%- endif -%}
      </div>
    </aside>
  {%- endif -%}

  {%- comment -%} ==================== B. MAIN HEADER FLOATING CONTAINER ==================== {%- endcomment -%}
  <atelier-header
    id="atelier-header-{{ section.id }}"
    class="atelier-header layout--{{ s.layout }} layout--{{ s.layout | replace: '_', '-' }}"
    data-layout="{{ s.layout }}"
    data-hide-on-scroll="{{ s.hide_on_scroll }}"
    data-money-format="{{ shop.money_format | escape }}"
  >
    <div class="atelier-header__bar">
      <div class="atelier-header__pill">

        {%- comment -%} ---------- LEFT AREA ---------- {%- endcomment -%}
        <div class="atelier-header__left">
          {%- comment -%} Mobile controls (Hamburger + Search) {%- endcomment -%}
          <div class="atelier-header__mobile-controls">
            <button
              type="button"
              class="atelier-icon-btn atelier-burger"
              data-open-drawer
              aria-label="Open mobile menu"
              aria-expanded="false"
            >
              {{ icon_burger }}
            </button>
            <button
              type="button"
              class="atelier-icon-btn atelier-search-btn atelier-search-btn--mobile"
              data-open-search
              aria-label="Search"
              aria-expanded="false"
            >
              {{ icon_search }}
            </button>
          </div>

          {%- comment -%} Capsule Search Pill (Used in Two-Rows layout) {%- endcomment -%}
          <button
            type="button"
            class="atelier-search-pill"
            data-open-search
            aria-label="Search journals and gifts"
            aria-expanded="false"
          >
            {{ icon_search }}
            <span>{{ s.search_placeholder | escape }}</span>
          </button>

          {%- comment -%} Desktop Navigation Menu (Always in DOM; position controlled by layout CSS) {%- endcomment -%}
          <nav class="atelier-header__nav" aria-label="Main navigation">
            <ul class="atelier-header__nav-list" role="list">
              {%- for link in menu -%}
                {%- liquid
                  assign bold = false
                  assign t_down = link.title | downcase
                  if s.bold_words != blank
                    assign words = s.bold_words | downcase | split: ','
                    for w in words
                      assign ww = w | strip
                      if ww != blank and t_down contains ww
                        assign bold = true
                      endif
                    endfor
                  endif
                -%}
                <li>
                  {%- if link.links.size > 0 -%}
                    <button
                      type="button"
                      class="atelier-nav__link{% if link.active or link.child_active %} is-current{% endif %}{% if bold %} is-bold{% endif %}"
                      data-mega-trigger="{{ forloop.index }}"
                      aria-expanded="false"
                    >
                      {{ link.title | escape }}{{ icon_chev }}
                    </button>
                  {%- else -%}
                    <a
                      class="atelier-nav__link{% if link.active %} is-current{% endif %}{% if bold %} is-bold{% endif %}"
                      href="{{ link.url }}"
                    >
                      {{ link.title | escape }}
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        </div>

        {%- comment -%} ---------- CENTER AREA (LOGO) ---------- {%- endcomment -%}
        <div class="atelier-header__center">
          {%- if request.page_type == 'index' and s.logo_h1 -%}
            <h1 style="margin: 0; line-height: 1;">{{ logo_markup }}</h1>
          {%- else -%}
            {{ logo_markup }}
          {%- endif -%}
        </div>

        {%- comment -%} ---------- RIGHT AREA (ACTION ICONS) ---------- {%- endcomment -%}
        <div class="atelier-header__right">
          {%- comment -%} Search icon button (Used in single-row layouts) {%- endcomment -%}
          <button
            type="button"
            class="atelier-icon-btn atelier-search-icon"
            data-open-search
            aria-label="Search"
          >
            {{ icon_search }}
          </button>

          {%- if s.show_phone and phone_clean != blank -%}
            <a
              class="atelier-icon-btn atelier-desk-only"
              href="tel:{{ phone_clean }}"
              aria-label="Call customer support"
            >
              {{ icon_phone }}
            </a>
          {%- endif -%}



          {%- comment -%} Desktop Account Icon (Beside Wishlist) {%- endcomment -%}
          {%- if s.show_account -%}
            <a
              class="atelier-icon-btn atelier-account-btn atelier-desk-only"
              href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
              aria-label="{% if customer %}My Account{% else %}Log in / Register{% endif %}"
            >
              {{ icon_account }}
            </a>
          {%- endif -%}

          {%- if s.show_wishlist -%}
            <button
              type="button"
              class="atelier-icon-btn atelier-desk-only"
              data-open-wishlist
              aria-label="Wishlist saved items"
            >
              {{ icon_heart }}
              <span class="atelier-badge" data-wishlist-count hidden>0</span>
            </button>
          {%- endif -%}

          {%- if s.show_cart -%}
            <a
              class="atelier-icon-btn"
              id="cart-icon-bubble"
              data-cart-btn
              href="{{ routes.cart_url }}"
              aria-label="Shopping Cart"
            >
              {{ icon_bag }}
              {%- if cart.item_count > 0 -%}
                <span class="atelier-badge cart-count-bubble">
                  <span aria-hidden="true">{{ cart.item_count }}</span>
                  <span class="visually-hidden">{{ cart.item_count }} items</span>
                </span>
              {%- endif -%}
            </a>
          {%- endif -%}
        </div>

      </div>

      {%- comment -%} ==================== C. DESKTOP MEGA MENUS ==================== {%- endcomment -%}
      {%- for link in menu -%}
        {%- if link.links.size == 0 -%}{%- continue -%}{%- endif -%}
        {%- assign lt = link.title | downcase | strip -%}
        <div
          class="atelier-mega"
          id="atelier-mega-{{ forloop.index }}"
          data-mega-panel="{{ forloop.index }}"
          role="region"
          aria-label="{{ link.title | escape }} sub-menu"
        >
          <div class="atelier-mega__inner">
            <div class="atelier-mega__main">
              <a class="atelier-mega__title" href="{{ link.url }}">
                Shop All {{ link.title | escape }}{{ icon_arrow }}
              </a>

              <ul class="atelier-mega__cols" role="list">
                {%- for child in link.links -%}
                  <li>
                    <a class="atelier-mega__head" href="{{ child.url }}">{{ child.title | escape }}</a>
                    {%- if child.links.size > 0 -%}
                      <ul class="atelier-mega__sub" role="list">
                        {%- for grandchild in child.links -%}
                          <li>
                            <a class="atelier-mega__a" href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </div>

            {%- comment -%} Promotional Photo Card on Right (UrbanDeco model: matches Menu item name) {%- endcomment -%}
            {%- for block in section.blocks -%}
              {%- assign bt = block.settings.heading | default: block.settings.menu_item | downcase | strip -%}
              {%- if bt == lt and block.settings.image != blank -%}
                <a
                  class="atelier-promo-card"
                  href="{{ block.settings.link | default: link.url }}"
                  {{ block.shopify_attributes }}
                >
                  <div class="atelier-promo-card__img">
                    {{ block.settings.image | image_url: width: 600 | image_tag: widths: '300, 480, 600', sizes: '280px', loading: 'lazy', alt: block.settings.heading | default: link.title | escape }}
                  </div>
                  <div class="atelier-promo-card__body">
                    <span class="atelier-promo-card__h">{{ block.settings.heading | default: link.title | escape }}</span>
                    {%- if block.settings.subheading != blank -%}
                      <span class="atelier-promo-card__s">{{ block.settings.subheading | escape }}{{ icon_arrow }}</span>
                    {%- else -%}
                      <span class="atelier-promo-card__s">Explore {{ link.title | escape }}{{ icon_arrow }}</span>
                    {%- endif -%}
                  </div>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}

      {%- comment -%} ==================== D. LIVE PREDICTIVE SEARCH DROPDOWN ==================== {%- endcomment -%}
      <div
        class="atelier-search-panel"
        data-search-panel
        role="dialog"
        aria-label="Product search"
      >
        <form class="atelier-search-form" action="{{ routes.search_url }}" method="get" role="search">
          {{ icon_search }}
          <input
            type="search"
            name="q"
            placeholder="{{ s.search_placeholder | escape }}"
            data-search-input
            autocomplete="off"
            aria-label="Search"
          >
          <input type="hidden" name="type" value="product">
          <button type="button" class="atelier-search-panel__close" data-close-search aria-label="Close search">
            {{ icon_close }}
          </button>
        </form>

        <div class="atelier-search-idle" data-search-idle>
          {%- if s.popular_searches != blank -%}
            <p class="atelier-search-recents-h">Popular Searches</p>
            <div class="atelier-search-chips">
              {%- assign popular = s.popular_searches | split: ',' -%}
              {%- for term in popular -%}
                {%- assign t_clean = term | strip -%}
                {%- if t_clean != blank -%}
                  <button type="button" class="atelier-search-chip" data-search-chip="{{ t_clean | escape }}">
                    {{ t_clean }}
                  </button>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

          <div data-recent-searches-wrap style="display: none; margin-top: 18px;">
            <p class="atelier-search-recents-h">Recent Searches</p>
            <div class="atelier-search-chips" data-recent-searches-list></div>
          </div>
        </div>

        <div class="atelier-search-results" data-search-results style="display: none;"></div>
      </div>

    </div>
  </atelier-header>

  {%- comment -%} ==================== E. MOBILE SLIDE-OUT DRAWER ==================== {%- endcomment -%}
  <div class="atelier-scrim" data-scrim aria-hidden="true"></div>

  <aside
    class="atelier-drawer"
    id="atelier-mobile-drawer"
    data-mobile-drawer
    aria-label="Mobile navigation"
    aria-hidden="true"
  >
    <div class="atelier-drawer__head">
      <div class="atelier-drawer__brand">
        {{ logo_markup }}
      </div>
      <button
        type="button"
        class="atelier-icon-btn atelier-drawer__close"
        data-close-drawer
        onclick="window.gtCloseMobileDrawer && window.gtCloseMobileDrawer();"
        aria-label="Close mobile menu"
      >
        {{ icon_close }}
      </button>
    </div>

    <div class="atelier-drawer__body">
      {%- if s.m_show_promo and s.promo_heading != blank -%}
        <a class="atelier-drawer__promo-banner" href="{{ s.promo_link | default: routes.all_products_collection_url }}">
          <span class="atelier-drawer__promo-h">{{ s.promo_heading | escape }}</span>
          {%- if s.promo_link_label != blank -%}<span class="atelier-drawer__promo-cta">{{ s.promo_link_label | escape }}{{ icon_arrow }}</span>{%- endif -%}
        </a>
      {%- endif -%}

      <nav class="atelier-drawer__nav" aria-label="Mobile main navigation">
        <ul class="atelier-drawer__rows" role="list">
          {%- for link in mobile_menu -%}
            <li>
              {%- if link.links.size > 0 -%}
                {%- assign has_grandkids = false -%}
                {%- for child in link.links -%}
                  {%- if child.links.size > 0 -%}
                    {%- assign has_grandkids = true -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}

                <details class="atelier-drawer__accordion-item" data-drawer-accordion>
                  <summary class="atelier-drawer__row-link" data-accordion-trigger>
                    <span class="atelier-drawer__row-title">{{ link.title | escape }}</span>
                    <span class="atelier-drawer__chev">{{ icon_chev }}</span>
                  </summary>
                  <div class="atelier-drawer__accordion-body">
                    <div class="atelier-drawer__accordion-inner">
                      {%- if has_grandkids -%}
                        <div class="atelier-drawer__columns">
                          {%- for child in link.links -%}
                            <div class="atelier-drawer__col">
                              <a href="{{ child.url }}" class="atelier-drawer__col-heading">{{ child.title | escape }}</a>
                              {%- if child.links.size > 0 -%}
                                <ul class="atelier-drawer__col-list" role="list">
                                  {%- for grandchild in child.links -%}
                                    <li><a class="atelier-drawer__sublink" href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a></li>
                                  {%- endfor -%}
                                </ul>
                              {%- endif -%}
                            </div>
                          {%- endfor -%}
                        </div>
                      {%- else -%}
                        <ul class="atelier-drawer__sublist--flat" role="list">
                          {%- for child in link.links -%}
                            <li><a class="atelier-drawer__sublink" href="{{ child.url }}">{{ child.title | escape }}</a></li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </div>
                  </div>
                </details>
              {%- else -%}
                <a class="atelier-drawer__row-link" href="{{ link.url }}">
                  <span class="atelier-drawer__row-title">{{ link.title | escape }}</span>
                  <span class="atelier-drawer__row-arrow" aria-hidden="true">→</span>
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    </div>
    <div class="atelier-drawer__footer">
      <div class="atelier-drawer__footer-actions">
        <a class="atelier-drawer__btn atelier-drawer__btn--call" href="tel:{{ phone_clean | default: '919876543210' }}">
          {{ icon_phone }}
          <span>Call us</span>
        </a>
        <a class="atelier-drawer__btn atelier-drawer__btn--wa" href="https://wa.me/{{ whatsapp_clean | default: '919876543210' }}" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M20.52 3.48A11.9 11.9 0 0 0 12.06 0C5.5 0 .16 5.34.16 11.9a11.83 11.83 0 0 0 1.62 6L0 24l6.29-1.65a11.87 11.87 0 0 0 5.77 1.48h.01c6.56 0 11.9-5.34 11.9-11.9a11.8 11.8 0 0 0-3.45-8.45zM12.06 21.82h-.01a9.86 9.86 0 0 1-5.02-1.38l-.36-.21-3.73.98 1-3.64-.23-.37a9.84 9.84 0 0 1-1.51-5.3c0-5.45 4.44-9.89 9.89-9.89a9.8 9.8 0 0 1 7 2.89 9.8 9.8 0 0 1 2.9 7c0 5.46-4.44 9.9-9.89 9.9z"/></svg>
          <span>WhatsApp</span>
        </a>
      </div>
      <div class="atelier-drawer__footer-meta">
        <a class="atelier-drawer__footer-account" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">
          <span class="atelier-drawer__footer-account-icon" aria-hidden="true">{{ icon_account }}</span>
          <span>{% if customer %}My Account{% else %}Log in / Register{% endif %}</span>
        </a>
        <span class="atelier-drawer__footer-hours">{{ s.m_hours | default: 'Mon–Sat 10am–7pm' }}</span>
      </div>
      {%- if s.tagline != blank -%}
        <p class="atelier-drawer__footer-tagline">{{ s.tagline | escape }}</p>
      {%- endif -%}
    </div>
  </aside>
</section>

