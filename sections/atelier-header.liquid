  color: rgba(54, 54, 56, 0.6) !important;
  line-height: 1.2 !important;
}
.atelier-drawer__account-arrow {
  font-size: 16px !important;
  color: rgba(54, 54, 56, 0.4) !important;
  flex-shrink: 0 !important;
}

/* Action Buttons: Call Us & WhatsApp */
.atelier-drawer__actions {
  display: grid !important;
  grid-template-columns: 1fr 1fr !important;
  gap: 10px !important;
  margin-top: 10px !important;
  margin-bottom: 16px !important;
}
.atelier-drawer__btn {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 8px !important;
  height: 44px !important;
  border-radius: 999px !important;
  font-family: 'Inter', sans-serif !important;
  font-size: 13px !important;
  font-weight: 600 !important;
  text-decoration: none !important;
  border: none !important;
  transition: transform 0.2s ease, box-shadow 0.2s ease !important;
}
.atelier-drawer__btn:hover {
  transform: translateY(-1px) !important;
}
.atelier-drawer__btn--call {
  background: #FFFFFF !important;
  color: #363638 !important;
  border: 1.5px solid rgba(54, 54, 56, 0.25) !important;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04) !important;
}
.atelier-drawer__btn--call svg {
  width: 16px !important;
  height: 16px !important;
  stroke: currentColor !important;
}
.atelier-drawer__btn--wa {
  background: #128C7E !important;
  color: #FFFFFF !important;
  border: none !important;
  box-shadow: 0 4px 12px -2px rgba(18, 140, 126, 0.4) !important;
}
.atelier-drawer__btn--wa svg {
  width: 17px !important;
  height: 17px !important;
  fill: currentColor !important;
}

.atelier-drawer__meta {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 16px !important;
  margin-top: 14px !important;
  font-family: 'Inter', sans-serif !important;
  font-size: 12px !important;
  color: rgba(54, 54, 56, 0.6) !important;
}
.atelier-drawer__hours {
  font-size: 11.5px !important;
  color: rgba(54, 54, 56, 0.6) !important;
  text-align: center !important;
}
.atelier-drawer__tagline {
  margin: 10px 0 0 !important;
  font-size: 11px !important;
  color: rgba(54, 54, 56, 0.5) !important;
  text-align: center !important;
}


/* Clearances for non-banner pages */
body:not(.template-index):not(.template-collection) #MainContent > .shopify-section:first-child:not(:has(.atelier-col-hero)):not(:has(.atelier-hero)):not(:has(.image-banner)):not(:has(.slideshow)) {
  padding-top: calc(var(--header-height, 120px) + 24px) !important;
}

{%- endstyle -%}

<section
  id="shopify-section-{{ section.id }}"
  class="atelier-header-section{% if s.sticky %} is-sticky{% endif %}"
  data-section-id="{{ section.id }}"
>
  {%- comment -%} ==================== A. ANNOUNCEMENT BAR ==================== {%- endcomment -%}
  {%- if show_announcement -%}
    <aside
      class="atelier-announcement atelier-announcement--{{ s.announcement_visibility }}{% if s.announcement_scroll %} atelier-announcement--marquee{% endif %}"
      aria-label="Announcement"
    >
      <div class="atelier-announcement__inner">
        <div class="atelier-announcement__content atelier-announcement__content--{{ s.announcement_align }}">
          {%- if s.announcement_scroll -%}
            <div class="atelier-announcement__track">
              <span>{{ s.announcement_text | escape }}</span>
              <span>{{ s.announcement_text | escape }}</span>
              <span>{{ s.announcement_text | escape }}</span>
            </div>
          {%- else -%}
            {%- if s.announcement_link != blank -%}
              <a href="{{ s.announcement_link }}" class="atelier-announcement__link">
                <span>{{ s.announcement_text | escape }}</span>
                {{ icon_arrow }}
              </a>
            {%- else -%}
              <span>{{ s.announcement_text | escape }}</span>
            {%- endif -%}
          {%- endif -%}
        </div>

        {%- if s.show_country_selector -%}
          <div class="atelier-announcement__country">
            <span>IN</span>
            <span>({{ cart.currency.iso_code }})</span>
          </div>
        {%- endif -%}
      </div>
    </aside>
  {%- endif -%}

  {%- comment -%} ==================== B. MAIN HEADER FLOATING CONTAINER ==================== {%- endcomment -%}
  <atelier-header
    id="atelier-header-{{ section.id }}"
    class="atelier-header layout--{{ s.layout }} layout--{{ s.layout | replace: '_', '-' }}"
    data-layout="{{ s.layout }}"
    data-hide-on-scroll="{{ s.hide_on_scroll }}"
    data-money-format="{{ shop.money_format | escape }}"
  >
    <div class="atelier-header__bar">
      <div class="atelier-header__pill">

        {%- comment -%} ---------- LEFT AREA ---------- {%- endcomment -%}
        <div class="atelier-header__left">
          {%- comment -%} Mobile hamburger trigger {%- endcomment -%}
          <button
            type="button"
            class="atelier-icon-btn atelier-burger"
            data-open-drawer
            aria-label="Open mobile menu"
            aria-expanded="false"
            onclick="const d=document.getElementById('atelier-mobile-drawer');const s=document.querySelector('.atelier-scrim');if(d)d.classList.add('is-open');if(s)s.classList.add('is-visible');document.body.style.overflow='hidden';"
          >
            {{ icon_burger }}
          </button>

          {%- comment -%} Search Icon Button (On left for mobile & single-row desktop) {%- endcomment -%}
          <button
            type="button"
            class="atelier-icon-btn atelier-search-btn"
            data-open-search
            aria-label="Search"
          >
            {{ icon_search }}
          </button>

          {%- comment -%} Capsule Search Pill (Used in Two-Rows layout on desktop) {%- endcomment -%}
          <button
            type="button"
            class="atelier-search-pill"
            data-open-search
            aria-label="Search journals and gifts"
            aria-expanded="false"
          >
            {{ icon_search }}
            <span>{{ s.search_placeholder | escape }}</span>
          </button>

          {%- comment -%} Desktop Navigation Menu {%- endcomment -%}
          <nav class="atelier-header__nav" aria-label="Main navigation">
            <ul class="atelier-header__nav-list" role="list">
              {%- for link in menu -%}
                {%- liquid
                  assign bold = false
                  assign t_down = link.title | downcase
                  if s.bold_words != blank
                    assign words = s.bold_words | downcase | split: ','
                    for w in words
                      assign ww = w | strip
                      if ww != blank and t_down contains ww
                        assign bold = true
                      endif
                    endfor
                  endif
                -%}
                <li>
                  {%- if link.links.size > 0 -%}
                    <button
                      type="button"
                      class="atelier-nav__link{% if link.active or link.child_active %} is-current{% endif %}{% if bold %} is-bold{% endif %}"
                      data-mega-trigger="{{ forloop.index }}"
                      aria-expanded="false"
                    >
                      {{ link.title | escape }}{{ icon_chev }}
                    </button>
                  {%- else -%}
                    <a
                      class="atelier-nav__link{% if link.active %} is-current{% endif %}{% if bold %} is-bold{% endif %}"
                      href="{{ link.url }}"
                    >
                      {{ link.title | escape }}
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        </div>

        {%- comment -%} ---------- CENTER AREA (LOGO) ---------- {%- endcomment -%}
        <div class="atelier-header__center">
          {%- if request.page_type == 'index' and s.logo_h1 -%}
            <h1 style="margin: 0; line-height: 1;">{{ logo_markup }}</h1>
          {%- else -%}
            {{ logo_markup }}
          {%- endif -%}
        </div>

        {%- comment -%} ---------- RIGHT AREA (ACTION ICONS) ---------- {%- endcomment -%}
        <div class="atelier-header__right">
          {%- comment -%} Wishlist Icon Button {%- endcomment -%}
          {%- if s.show_wishlist -%}
            <button
              type="button"
              class="atelier-icon-btn"
              data-open-wishlist
              aria-label="Wishlist saved items"
            >
              {{ icon_heart }}
              <span class="atelier-badge" data-wishlist-count hidden>0</span>
            </button>
          {%- endif -%}

          {%- comment -%} Cart Icon Button {%- endcomment -%}
          {%- if s.show_cart -%}
            <a
              class="atelier-icon-btn"
              id="cart-icon-bubble"
              data-cart-btn
              href="{{ routes.cart_url }}"
              aria-label="Shopping Cart"
            >
              {{ icon_bag }}
              {%- if cart.item_count > 0 -%}
                <span class="atelier-badge cart-count-bubble">
                  <span aria-hidden="true">{{ cart.item_count }}</span>
                  <span class="visually-hidden">{{ cart.item_count }} items</span>
                </span>
              {%- endif -%}
            </a>
          {%- endif -%}
        </div>

      </div>

      {%- comment -%} ==================== C. DESKTOP MEGA MENUS ==================== {%- endcomment -%}
      {%- for link in menu -%}
        {%- if link.links.size == 0 -%}{%- continue -%}{%- endif -%}
        {%- assign lt = link.title | downcase | strip -%}
        <div
          class="atelier-mega"
          id="atelier-mega-{{ forloop.index }}"
          data-mega-panel="{{ forloop.index }}"
          role="region"
          aria-label="{{ link.title | escape }} sub-menu"
        >
          <div class="atelier-mega__inner">
            <div class="atelier-mega__main">
              <a class="atelier-mega__title" href="{{ link.url }}">
                Shop All {{ link.title | escape }}{{ icon_arrow }}
              </a>

              <ul class="atelier-mega__cols" role="list">
                {%- for child in link.links -%}
                  <li>
                    <a class="atelier-mega__head" href="{{ child.url }}">{{ child.title | escape }}</a>
                    {%- if child.links.size > 0 -%}
                      <ul class="atelier-mega__sub" role="list">
                        {%- for grandchild in child.links -%}
                          <li>
                            <a class="atelier-mega__a" href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </div>

            {%- comment -%} Promotional Photo Card on Right {%- endcomment -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'promo' -%}
                {%- assign bt = block.settings.menu_item | downcase | strip -%}
                {%- if bt == lt -%}
                  <a
                    class="atelier-promo-card"
                    href="{{ block.settings.link | default: link.url }}"
                    {{ block.shopify_attributes }}
                  >
                    <div class="atelier-promo-card__img">
                      {%- if block.settings.image != blank -%}
                        {{ block.settings.image | image_url: width: 600 | image_tag: widths: '300, 480, 600', sizes: '280px', loading: 'lazy', alt: block.settings.heading | escape }}
                      {%- else -%}
                        <div style="width: 100%; height: 100%; background: linear-gradient(135deg, #E9DFC2 0%, #C6B58E 100%);"></div>
                      {%- endif -%}
                    </div>
                    <div class="atelier-promo-card__body">
                      {%- if block.settings.heading != blank -%}
                        <span class="atelier-promo-card__h">{{ block.settings.heading | escape }}</span>
                      {%- endif -%}
                      {%- if block.settings.subheading != blank -%}
                        <span class="atelier-promo-card__s">{{ block.settings.subheading | escape }}{{ icon_arrow }}</span>
                      {%- endif -%}
                    </div>
                  </a>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}

      {%- comment -%} ==================== D. LIVE PREDICTIVE SEARCH DROPDOWN ==================== {%- endcomment -%}
      <div
        class="atelier-search-panel"
        data-search-panel
        role="dialog"
        aria-label="Product search"
      >
        <form class="atelier-search-form" action="{{ routes.search_url }}" method="get" role="search">
          {{ icon_search }}
          <input
            type="search"
            name="q"
            placeholder="{{ s.search_placeholder | escape }}"
            data-search-input
            autocomplete="off"
            aria-label="Search"
          >
          <input type="hidden" name="type" value="product">
          <button type="button" class="atelier-search-panel__close" data-close-search aria-label="Close search">
            {{ icon_close }}
          </button>
        </form>

        <div class="atelier-search-idle" data-search-idle>
          {%- if s.popular_searches != blank -%}
            <p class="atelier-search-recents-h">Popular Searches</p>
            <div class="atelier-search-chips">
              {%- assign popular = s.popular_searches | split: ',' -%}
              {%- for term in popular -%}
                {%- assign t_clean = term | strip -%}
                {%- if t_clean != blank -%}
                  <button type="button" class="atelier-search-chip" data-search-chip="{{ t_clean | escape }}">
                    {{ t_clean }}
                  </button>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

          <div data-recent-searches-wrap style="display: none; margin-top: 18px;">
            <p class="atelier-search-recents-h">Recent Searches</p>
            <div class="atelier-search-chips" data-recent-searches-list></div>
          </div>
        </div>

        <div class="atelier-search-results" data-search-results style="display: none;"></div>
      </div>

    </div>
  {%- comment -%} ==================== E. MOBILE SLIDE-OUT DRAWER (Image 3 reference) ==================== {%- endcomment -%}
  <div class="atelier-scrim" data-scrim aria-hidden="true" onclick="const d=document.getElementById('atelier-mobile-drawer');const s=document.querySelector('.atelier-scrim');if(d)d.classList.remove('is-open');if(s)s.classList.remove('is-visible');document.body.style.overflow='';"></div>

  <aside
    class="atelier-drawer"
    id="atelier-mobile-drawer"
    data-mobile-drawer
    role="dialog"
    aria-modal="true"
    aria-label="Mobile navigation"
    aria-hidden="true"
  >
    <!-- Top Header -->
    <div class="atelier-drawer__head">
      <div class="atelier-drawer__brand">
        {{ logo_markup }}
      </div>
      <button
        type="button"
        class="atelier-drawer__close" data-close-drawer aria-label="Close mobile menu" onclick="const d=document.getElementById('atelier-mobile-drawer');const s=document.querySelector('.atelier-scrim');if(d)d.classList.remove('is-open');if(s)s.classList.remove('is-visible');document.body.style.overflow='';" >
        {{ icon_close }}
      </button>
    </div>

    <!-- Body Content -->
    <div class="atelier-drawer__body">
      <!-- Search Input -->
      <form class="atelier-drawer__search" action="{{ routes.search_url }}" method="get" role="search">
        {{ icon_search }}
        <input
          type="search"
          name="q"
          placeholder="{{ s.search_placeholder | default: 'Search journals, notebooks, gifts...' | escape }}"
          autocomplete="off"
          aria-label="Search"
        >
        <input type="hidden" name="type" value="product">
      </form>

      <!-- Promo Banner Card -->
      {%- if s.m_show_promo and s.promo_heading != blank -%}
        <a class="atelier-drawer__promo-banner" href="{{ s.promo_link | default: routes.all_products_collection_url }}">
          <span class="atelier-drawer__promo-h">{{ s.promo_heading | escape }}</span>
          {%- if s.promo_link_label != blank -%}
            <span class="atelier-drawer__promo-cta">{{ s.promo_link_label | escape }} &rarr;</span>
          {%- endif -%}
        </a>
      {%- endif -%}

      <!-- 2-Column Photo Tiles Grid (Image 3 reference) -->
      {%- if s.m_tiles > 0 and s.m_style != 'text' -%}
        <div class="atelier-drawer__tiles-grid">
          {%- assign tile_count = 0 -%}
          {%- assign tile_handles = ',' -%}
          {%- for link in mobile_menu -%}
            {%- if tile_count >= s.m_tiles -%}{%- break -%}{%- endif -%}
            {%- liquid
              assign tile_img = nil
              assign lt_m = link.title | downcase | strip

              # Check menu_photo blocks
              for b in section.blocks
                if b.type == 'menu_photo' and b.settings.image != blank
                  assign bt_m = b.settings.item | downcase | strip
                  if bt_m == lt_m
                    assign tile_img = b.settings.image
                    break
                  endif
                endif
              endfor

              # Check collection image
              if tile_img == nil and link.type == 'collection_link' and link.object
                if link.object.metafields.custom.collection_tab_image != blank
                  assign tile_img = link.object.metafields.custom.collection_tab_image
                elsif link.object.featured_image != blank
                  assign tile_img = link.object.featured_image
                elsif link.object.image != blank
                  assign tile_img = link.object.image
                endif
              endif

              # Check children for collection image
              if tile_img == nil
                for c in link.links
                  if c.type == 'collection_link' and c.object.featured_image != blank
                    assign tile_img = c.object.featured_image
                    break
                  endif
                endfor
              endif

              assign tile_count = tile_count | plus: 1
              assign tile_handles = tile_handles | append: forloop.index | append: ','
            -%}
            <a class="atelier-photo-tile" href="{{ link.url }}">
              <div class="atelier-photo-tile__img">
                {%- if tile_img != blank -%}
                  {{ tile_img | image_url: width: 400 | image_tag: widths: '200, 300, 400', sizes: '44vw', loading: 'lazy', alt: link.title | escape }}
                {%- else -%}
                  <div class="atelier-photo-tile__placeholder"></div>
                {%- endif -%}
              </div>
              <div class="atelier-photo-tile__scrim"></div>
              <div class="atelier-photo-tile__info">
                <span class="atelier-photo-tile__title">{{ link.title | escape }}</span>
                {%- if link.links.size > 0 -%}
                  <span class="atelier-photo-tile__count">{{ link.links.size }} categories</span>
                {%- else -%}
                  <span class="atelier-photo-tile__count">View collection</span>
                {%- endif -%}
              </div>
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <!-- Menu Navigation Rows (Bullet-free & Constrained Chevron) -->
      <ul class="atelier-drawer__rows" role="list">
        {%- for link in mobile_menu -%}
          {%- assign check_key = ',' | append: forloop.index | append: ',' -%}
          {%- if tile_handles contains check_key -%}{%- continue -%}{%- endif -%}
          <li style="list-style: none !important;">
            {%- if link.links.size > 0 -%}
              <details class="atelier-drawer__details">
                <summary class="atelier-drawer__row-link">
                  <span>{{ link.title | escape }}</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </summary>
                <ul class="atelier-drawer__sublist" role="list">
                  {%- for child in link.links -%}
                    <li style="list-style: none !important;">
                      <a class="atelier-drawer__sublink" href="{{ child.url }}">
                        {{ child.title | escape }}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              </details>
            {%- else -%}
              <a class="atelier-drawer__row-link" href="{{ link.url }}">
                <span>{{ link.title | escape }}</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      <!-- Dedicated Account Card Inside Side Menu (User Request) -->
      {%- if shop.customer_accounts_enabled -%}
        <div class="atelier-drawer__account-wrap">
          <a class="atelier-drawer__account-card" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">
            <div class="atelier-drawer__account-icon">
              {{ icon_account }}
            </div>
            <div class="atelier-drawer__account-text">
              <span class="atelier-drawer__account-title">
                {% if customer %}My Account ({{ customer.first_name }}){% else %}Log in / Register{% endif %}
              </span>
              <span class="atelier-drawer__account-sub">
                {% if customer %}View orders, addresses & details{% else %}Access your wishlist & order history{% endif %}
              </span>
            </div>
            <div class="atelier-drawer__account-arrow">&rarr;</div>
          </a>
        </div>
      {%- endif -%}

      <!-- Action Buttons: Call Us & WhatsApp (Image 3 reference) -->
      {%- if s.m_show_contact -%}
        <div class="atelier-drawer__actions">
          {%- if phone_clean != blank -%}
            <a class="atelier-drawer__btn atelier-drawer__btn--call" href="tel:{{ phone_clean }}">
              {{ icon_phone }}
              <span>Call us</span>
            </a>
          {%- endif -%}
          {%- if whatsapp_clean != blank -%}
            <a class="atelier-drawer__btn atelier-drawer__btn--wa" href="https://wa.me/{{ whatsapp_clean }}" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true"><path d="M12 2.2a9.7 9.7 0 0 0-8.4 14.6L2.3 21.8l5.1-1.3A9.7 9.7 0 1 0 12 2.2Zm0 17.7c-1.5 0-3-.4-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1 1 12 19.9Zm4.4-6c-.2-.1-1.4-.7-1.7-.8-.2-.1-.4-.1-.5.1l-.8.9c-.1.2-.3.2-.5.1a6.6 6.6 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.5-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 1.9s.8 2.2.9 2.4c.1.1 1.6 2.5 4 3.5 1.5.6 2.1.7 2.8.6.5-.1 1.4-.6 1.6-1.1.2-.6.2-1 .1-1.1l-.6-.4Z"/></svg>
              <span>WhatsApp</span>
            </a>
          {%- endif -%}
        </div>

        <div class="atelier-drawer__meta">
          {%- if shop.customer_accounts_enabled -%}
            <a class="atelier-drawer__login" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">
              {{ icon_account }}
              <span>{% if customer %}My Account{% else %}Log in / Register{% endif %}</span>
            </a>
          {%- endif -%}
          {%- if s.m_hours != blank -%}
            <span class="atelier-drawer__hours">{{ s.m_hours | escape }}</span>
          {%- endif -%}
        </div>

        <p class="atelier-drawer__tagline">{{ s.tagline | default: 'Loved by thousands of storytellers across India' }}</p>
      {%- endif -%}
    </div>
  </aside>
  </atelier-header>

  
</section>

{% schema %}
{
  "name": "Atelier header",
  "tag": "section",
  "class": "atelier-header-section",
  "limit": 1,
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Announcement Bar"
