{%- endstyle -%}

<section
  id="shopify-section-{{ section.id }}"
  class="atelier-header-section{% if s.sticky %} is-sticky{% endif %}"
  data-section-id="{{ section.id }}"
>
  {%- comment -%} ==================== A. ANNOUNCEMENT BAR ==================== {%- endcomment -%}
  {%- if show_announcement -%}
    <aside
    class="atelier-drawer"
    id="atelier-mobile-drawer"
    data-mobile-drawer
    role="dialog"
    aria-modal="true"
    aria-label="Mobile navigation"
    aria-hidden="true"
  >
    <!-- Top Header (UrbanDeco style: Logo + Close button) -->
    <div class="atelier-drawer__head">
      <div class="atelier-drawer__brand">
        {{ logo_markup }}
      </div>
      <button
        type="button"
        class="atelier-drawer__close"
        data-close-drawer
        aria-label="Close mobile menu"
      >
        {{ icon_close }}
      </button>
    </div>

    <!-- Scrollable Body Content -->
    <div class="atelier-drawer__body">
      <!-- Search Input (Pill rounded search) -->
      <form class="atelier-drawer__search" action="{{ routes.search_url }}" method="get" role="search">
        <span class="atelier-drawer__search-icon" aria-hidden="true">{{ icon_search }}</span>
        <input
          type="search"
          name="q"
          placeholder="{{ s.search_placeholder | default: 'Search journals, notebooks, gifts...' | escape }}"
          autocomplete="off"
          aria-label="Search"
        >
        <input type="hidden" name="type" value="product">
      </form>

      <!-- Promo Banner Card (Warm brown / gold card like UrbanDeco 'Autumn Sale – Extra 15% Off') -->
      {%- if s.m_show_promo and s.promo_heading != blank -%}
        <a class="atelier-drawer__promo-banner" href="{{ s.promo_link | default: routes.all_products_collection_url }}">
          <div class="atelier-drawer__promo-content">
            <span class="atelier-drawer__promo-h">{{ s.promo_heading | escape }}</span>
            <span class="atelier-drawer__promo-cta">{{ s.promo_link_label | default: 'Shop now' | escape }} &rarr;</span>
          </div>
        </a>
      {%- endif -%}

      <!-- 2-Column Photo Tiles Grid (UrbanDeco Screenshot 2 reference) -->
      <div class="atelier-drawer__tiles-grid">
        {%- assign rendered_titles = ',' -%}
        {%- assign tile_limit = s.m_tiles | default: 6 -%}
        {%- if tile_limit == 0 -%}{%- assign tile_limit = 6 -%}{%- endif -%}
        {%- assign tile_count = 0 -%}

        {%- comment -%} 1. First priority: Check section blocks (menu_photo or promo) {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- if tile_count >= tile_limit -%}{%- break -%}{%- endif -%}
          {%- liquid
            assign b_title = block.settings.item | default: block.settings.menu_item | strip
            assign b_img = block.settings.image
            assign b_sub = block.settings.subtitle | default: block.settings.subheading | default: 'View collection'
            assign b_url = block.settings.link
          -%}
          {%- if b_img != blank and b_title != blank -%}
            {%- assign check_t = ',' | append: b_title | downcase | append: ',' -%}
            {%- unless rendered_titles contains check_t -%}
              {%- assign rendered_titles = rendered_titles | append: b_title | downcase | append: ',' -%}
              {%- assign tile_count = tile_count | plus: 1 -%}
              {%- if b_url == blank -%}
                {%- for lk in mobile_menu -%}
                  {%- assign lkt = lk.title | strip | downcase -%}
                  {%- assign btt = b_title | strip | downcase -%}
                  {%- if lkt == btt -%}
                    {%- assign b_url = lk.url -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
              <a class="atelier-photo-tile" href="{{ b_url | default: routes.all_products_collection_url }}">
                <div class="atelier-photo-tile__media">
                  {{ b_img | image_url: width: 360 | image_tag: loading: 'lazy', widths: '160, 240, 360', sizes: '140px', alt: b_title }}
                </div>
                <div class="atelier-photo-tile__overlay" aria-hidden="true"></div>
                <div class="atelier-photo-tile__info">
                  <span class="atelier-photo-tile__title">{{ b_title | escape }}</span>
                  <span class="atelier-photo-tile__count">{{ b_sub | escape }}</span>
                </div>
              </a>
            {%- endunless -%}
          {%- endif -%}
        {%- endfor -%}

        {%- comment -%} 2. Second priority: Menu links with collection images {%- endcomment -%}
        {%- for link in mobile_menu -%}
          {%- if tile_count >= tile_limit -%}{%- break -%}{%- endif -%}
          {%- assign link_t = link.title | strip | downcase -%}
          {%- assign check_t = ',' | append: link_t | append: ',' -%}
          {%- if rendered_titles contains check_t -%}{%- continue -%}{%- endif -%}

          {%- assign c_img = nil -%}
          {%- if link.type == 'collection_link' and link.object -%}
            {%- if link.object.metafields.custom.collection_tab_image != blank -%}
              {%- assign c_img = link.object.metafields.custom.collection_tab_image -%}
            {%- elsif link.object.featured_image != blank -%}
              {%- assign c_img = link.object.featured_image -%}
            {%- endif -%}
          {%- endif -%}

          {%- if c_img != blank -%}
            {%- assign rendered_titles = rendered_titles | append: link_t | append: ',' -%}
            {%- assign tile_count = tile_count | plus: 1 -%}
            <a class="atelier-photo-tile" href="{{ link.url }}">
              <div class="atelier-photo-tile__media">
                {{ c_img | image_url: width: 360 | image_tag: loading: 'lazy', widths: '160, 240, 360', sizes: '140px', alt: link.title }}
              </div>
              <div class="atelier-photo-tile__overlay" aria-hidden="true"></div>
              <div class="atelier-photo-tile__info">
                <span class="atelier-photo-tile__title">{{ link.title | escape }}</span>
                <span class="atelier-photo-tile__count">
                  {%- if link.links.size > 0 -%}
                    {{ link.links.size }} categories
                  {%- elsif link.object and link.object.all_products_count -%}
                    {{ link.object.all_products_count }} products
                  {%- else -%}
                    View collection
                  {%- endif -%}
                </span>
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <!-- Secondary Navigation Rows (Items below photo tiles or remaining links) -->
      <div class="atelier-drawer__rows" role="list">
        {%- for link in mobile_menu -%}
          {%- assign lt_check = ',' | append: link.title | strip | downcase | append: ',' -%}
          {%- if rendered_titles contains lt_check -%}{%- continue -%}{%- endif -%}

          {%- if link.links.size > 0 -%}
            <div class="atelier-drawer__accordion-item" data-drawer-accordion>
              <button
                type="button"
                class="atelier-drawer__row-link atelier-drawer__row-link--trigger"
                data-accordion-trigger
                aria-expanded="false"
              >
                <span>{{ link.title | escape }}</span>
                <span class="atelier-drawer__chev" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
                </span>
              </button>
              <div class="atelier-drawer__accordion-body">
                <ul class="atelier-drawer__sublist" role="list">
                  {%- for child in link.links -%}
                    <li>
                      <a class="atelier-drawer__sublink" href="{{ child.url }}">
                        {{ child.title | escape }}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            </div>
          {%- else -%}
            <a class="atelier-drawer__row-link" href="{{ link.url }}">
              <span>{{ link.title | escape }}</span>
              <span class="atelier-drawer__row-arrow" aria-hidden="true">&rarr;</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <!-- 3. PINNED FOOTER (UrbanDeco Screenshot 2: Call us + WhatsApp, Account, Hours, Tagline) -->
    <div class="atelier-drawer__footer">
      <!-- Action Buttons Row: Call us & WhatsApp -->
      <div class="atelier-drawer__footer-actions">
        <a class="atelier-drawer__btn atelier-drawer__btn--call" href="tel:{{ phone_clean | default: '+919876543210' }}">
          {{ icon_phone }}
          <span>Call us</span>
        </a>
        <a class="atelier-drawer__btn atelier-drawer__btn--wa" href="https://wa.me/{{ whatsapp_clean | default: '919876543210' }}" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true"><path d="M12 2.2a9.7 9.7 0 0 0-8.4 14.6L2.3 21.8l5.1-1.3A9.7 9.7 0 1 0 12 2.2Zm0 17.7c-1.5 0-3-.4-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1 1 12 19.9Zm4.4-6c-.2-.1-1.4-.7-1.7-.8-.2-.1-.4-.1-.5.1l-.8.9c-.1.2-.3.2-.5.1a6.6 6.6 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.5-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 1.9s.8 2.2.9 2.4c.1.1 1.6 2.5 4 3.5 1.5.6 2.1.7 2.8.6.5-.1 1.4-.6 1.6-1.1.2-.6.2-1 .1-1.1l-.6-.4Z"/></svg>
          <span>WhatsApp</span>
        </a>
      </div>

      <!-- Account link on left, hours on right (UrbanDeco reference) -->
      <div class="atelier-drawer__footer-meta">
        <a class="atelier-drawer__footer-account" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">
          <span class="atelier-drawer__footer-account-icon">{{ icon_account }}</span>
          <span>{% if customer %}My Account ({{ customer.first_name }}){% else %}Log in / Register{% endif %}</span>
        </a>
        <span class="atelier-drawer__footer-hours">{{ s.m_hours | default: 'Mon–Sat 10am–7pm' | escape }}</span>
      </div>

      <!-- Centered Tagline -->
      <p class="atelier-drawer__footer-tagline">{{ s.tagline | default: 'Loved by thousands of storytellers across India' | escape }}</p>
    </div>
  </aside>
  {%- endif -%}

  {%- comment -%} ==================== B. MAIN HEADER FLOATING CONTAINER ==================== {%- endcomment -%}
  <atelier-header
    id="atelier-header-{{ section.id }}"
    class="atelier-header layout--{{ s.layout }} layout--{{ s.layout | replace: '_', '-' }}"
    data-layout="{{ s.layout }}"
    data-hide-on-scroll="{{ s.hide_on_scroll }}"
    data-money-format="{{ shop.money_format | escape }}"
  >
    <div class="atelier-header__bar">
      <div class="atelier-header__pill">

        {%- comment -%} ---------- LEFT AREA ---------- {%- endcomment -%}
        <div class="atelier-header__left">
          {%- comment -%} Mobile hamburger trigger {%- endcomment -%}
          <button
            type="button"
            class="atelier-icon-btn atelier-burger"
            data-open-drawer
            aria-label="Open mobile menu"
            aria-expanded="false"
          >
            {{ icon_burger }}
          </button>

          {%- comment -%} Mobile Search Icon Button (On left next to burger, mobile only) {%- endcomment -%}
          <button
            type="button"
            class="atelier-icon-btn atelier-search-btn atelier-search-btn--mobile"
            data-open-search
            aria-label="Search"
          >
            {{ icon_search }}
          </button>

          {%- comment -%} Capsule Search Pill (Used in Two-Rows layout on desktop) {%- endcomment -%}
          <button
            type="button"
            class="atelier-search-pill"
            data-open-search
            aria-label="Search journals and gifts"
            aria-expanded="false"
          >
            {{ icon_search }}
            <span>{{ s.search_placeholder | escape }}</span>
          </button>

          {%- comment -%} Desktop Navigation Menu {%- endcomment -%}
          <nav class="atelier-header__nav" aria-label="Main navigation">
            <ul class="atelier-header__nav-list" role="list">
              {%- for link in menu -%}
                {%- liquid
                  assign bold = false
                  assign t_down = link.title | downcase
                  if s.bold_words != blank
                    assign words = s.bold_words | downcase | split: ','
                    for w in words
                      assign ww = w | strip
                      if ww != blank and t_down contains ww
                        assign bold = true
                      endif
                    endfor
                  endif
                -%}
                <li>
                  {%- if link.links.size > 0 -%}
                    <button
                      type="button"
                      class="atelier-nav__link{% if link.active or link.child_active %} is-current{% endif %}{% if bold %} is-bold{% endif %}"
                      data-mega-trigger="{{ forloop.index }}"
                      aria-expanded="false"
                    >
                      {{ link.title | escape }}{{ icon_chev }}
                    </button>
                  {%- else -%}
                    <a
                      class="atelier-nav__link{% if link.active %} is-current{% endif %}{% if bold %} is-bold{% endif %}"
                      href="{{ link.url }}"
                    >
                      {{ link.title | escape }}
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        </div>

        {%- comment -%} ---------- CENTER AREA (LOGO) ---------- {%- endcomment -%}
        <div class="atelier-header__center">
          {%- if request.page_type == 'index' and s.logo_h1 -%}
            <h1 style="margin: 0; line-height: 1;">{{ logo_markup }}</h1>
          {%- else -%}
            {{ logo_markup }}
          {%- endif -%}
        </div>

        {%- comment -%} ---------- RIGHT AREA (ACTION ICONS) ---------- {%- endcomment -%}
        <div class="atelier-header__right">
          {%- comment -%} Desktop Search Button (ONLY on desktop single-row layouts, NEVER on mobile) {%- endcomment -%}
          <button
            type="button"
            class="atelier-icon-btn atelier-search-btn atelier-search-btn--desktop"
            data-open-search
            aria-label="Search"
          >
            {{ icon_search }}
          </button>

          {%- comment -%} Wishlist Icon Button {%- endcomment -%}
          {%- if s.show_wishlist -%}
            <button
              type="button"
              class="atelier-icon-btn"
              data-open-wishlist
              aria-label="Wishlist saved items"
            >
              {{ icon_heart }}
              <span class="atelier-badge" data-wishlist-count hidden>0</span>
            </button>
          {%- endif -%}

          {%- comment -%} Cart Icon Button {%- endcomment -%}
          {%- if s.show_cart -%}
            <a
              class="atelier-icon-btn"
              id="cart-icon-bubble"
              data-cart-btn
              href="{{ routes.cart_url }}"
              aria-label="Shopping Cart"
            >
              {{ icon_bag }}
              {%- if cart.item_count > 0 -%}
                <span class="atelier-badge cart-count-bubble">
                  <span aria-hidden="true">{{ cart.item_count }}</span>
                  <span class="visually-hidden">{{ cart.item_count }} items</span>
                </span>
              {%- endif -%}
            </a>
          {%- endif -%}
        </div>

      </div>
    </div>
    {%- comment -%} ==================== C. DESKTOP MEGA MENUS ==================== {%- endcomment -%}
      {%- for link in menu -%}
        {%- if link.links.size == 0 -%}{%- continue -%}{%- endif -%}
        {%- assign lt = link.title | downcase | strip -%}
        <div
          class="atelier-mega"
          id="atelier-mega-{{ forloop.index }}"
          data-mega-panel="{{ forloop.index }}"
          role="region"
          aria-label="{{ link.title | escape }} sub-menu"
        >
          <div class="atelier-mega__inner">
            <div class="atelier-mega__main">
              <a class="atelier-mega__title" href="{{ link.url }}">
                Shop All {{ link.title | escape }}{{ icon_arrow }}
              </a>

              <ul class="atelier-mega__cols" role="list">
                {%- for child in link.links -%}
                  <li>
                    <a class="atelier-mega__head" href="{{ child.url }}">{{ child.title | escape }}</a>
                    {%- if child.links.size > 0 -%}
                      <ul class="atelier-mega__sub" role="list">
                        {%- for grandchild in child.links -%}
                          <li>
                            <a class="atelier-mega__a" href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </div>

            {%- comment -%} Promotional Photo Card on Right {%- endcomment -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'promo' or block.type == 'menu_photo' -%}
                {%- assign b_raw = block.settings.menu_item | default: block.settings.item -%}
                {%- assign bt = b_raw | downcase | strip -%}
                {%- if bt == lt -%}
                  <a
                    class="atelier-promo-card"
                    href="{{ block.settings.link | default: link.url }}"
                    {{ block.shopify_attributes }}
                  >
                    <div class="atelier-promo-card__img">
                      {%- if block.settings.image != blank -%}
                        {{ block.settings.image | image_url: width: 600 | image_tag: widths: '300, 480, 600', sizes: '280px', loading: 'lazy', alt: block.settings.heading | escape }}
                      {%- else -%}
                        <div style="width: 100%; height: 100%; background: linear-gradient(135deg, #E9DFC2 0%, #C6B58E 100%);"></div>
                      {%- endif -%}
                    </div>
                    <div class="atelier-promo-card__body">
                      {%- if block.settings.heading != blank -%}
                        <span class="atelier-promo-card__h">{{ block.settings.heading | escape }}</span>
                      {%- endif -%}
                      {%- if block.settings.subheading != blank -%}
                        <span class="atelier-promo-card__s">{{ block.settings.subheading | escape }}{{ icon_arrow }}</span>
                      {%- endif -%}
                    </div>
                  </a>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}

      {%- comment -%} ==================== D. LIVE PREDICTIVE SEARCH DROPDOWN ==================== {%- endcomment -%}
      <div
        class="atelier-search-panel"
        data-search-panel
        role="dialog"
        aria-label="Product search"
      >
        <form class="atelier-search-form" action="{{ routes.search_url }}" method="get" role="search">
          {{ icon_search }}
          <input
            type="search"
            name="q"
            placeholder="{{ s.search_placeholder | escape }}"
            data-search-input
            autocomplete="off"
            aria-label="Search"
          >
          <input type="hidden" name="type" value="product">
          <button type="button" class="atelier-search-panel__close" data-close-search aria-label="Close search">
            {{ icon_close }}
          </button>
        </form>

        <div class="atelier-search-idle" data-search-idle>
          {%- if s.popular_searches != blank -%}
            <p class="atelier-search-recents-h">Popular Searches</p>
            <div class="atelier-search-chips">
              {%- assign popular = s.popular_searches | split: ',' -%}
              {%- for term in popular -%}
                {%- assign t_clean = term | strip -%}
                {%- if t_clean != blank -%}
                  <button type="button" class="atelier-search-chip" data-search-chip="{{ t_clean | escape }}">
                    {{ t_clean }}
                  </button>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

          <div data-recent-searches-wrap style="display: none; margin-top: 18px;">
            <p class="atelier-search-recents-h">Recent Searches</p>
            <div class="atelier-search-chips" data-recent-searches-list></div>
          </div>
        </div>

        <div class="atelier-search-results" data-search-results style="display: none;"></div>
      </div>

    </div>
  {%- comment -%} ==================== E. MOBILE SLIDE-OUT DRAWER (Image 3 reference) ==================== {%- endcomment -%}
  <div class="atelier-scrim" data-scrim aria-hidden="true"></div>

  <aside
    class="atelier-drawer"
    id="atelier-mobile-drawer"
    data-mobile-drawer
    role="dialog"
    aria-modal="true"
    aria-label="Mobile navigation"
    aria-hidden="true"
  >
    <!-- Top Header -->
    <div class="atelier-drawer__head">
      <div class="atelier-drawer__brand">
        {{ logo_markup }}
      </div>
      <button
        type="button"
        class="atelier-drawer__close"
        data-close-drawer
        aria-label="Close mobile menu"
      >
        {{ icon_close }}
      </button>
    </div>

    <!-- Scrollable Body Content -->
    <div class="atelier-drawer__body">
      <!-- Search Input -->
      <form class="atelier-drawer__search" action="{{ routes.search_url }}" method="get" role="search">
        {{ icon_search }}
        <input
          type="search"
          name="q"
          placeholder="{{ s.search_placeholder | default: 'Search journals, notebooks, gifts...' | escape }}"
          autocomplete="off"
          aria-label="Search"
        >
        <input type="hidden" name="type" value="product">
      </form>

      <!-- Promo Banner Card -->
      {%- if s.m_show_promo and s.promo_heading != blank -%}
        <a class="atelier-drawer__promo-banner" href="{{ s.promo_link | default: routes.all_products_collection_url }}">
          <span class="atelier-drawer__promo-h">{{ s.promo_heading | escape }}</span>
          {%- if s.promo_link_label != blank -%}
            <span class="atelier-drawer__promo-cta">{{ s.promo_link_label | escape }} &rarr;</span>
          {%- endif -%}
        </a>
      {%- endif -%}

      <!-- 2-Column Photo Tiles Grid (if enabled) -->
      {%- if s.m_tiles > 0 and s.m_style != 'text' -%}
        <div class="atelier-drawer__tiles-grid">
          {%- assign tile_count = 0 -%}
          {%- assign tile_handles = ',' -%}
          {%- for link in mobile_menu -%}
            {%- if tile_count >= s.m_tiles -%}{%- break -%}{%- endif -%}
            {%- liquid
              assign tile_img = nil
              assign lt_m = link.title | downcase | strip

              for b in section.blocks
                if b.type == 'menu_photo' and b.settings.image != blank
                  assign bt_m = b.settings.item | downcase | strip
                  if bt_m == lt_m
                    assign tile_img = b.settings.image
                    break
                  endif
                endif
              endfor

              if tile_img == nil and link.type == 'collection_link' and link.object
                if link.object.metafields.custom.collection_tab_image != blank
                  assign tile_img = link.object.metafields.custom.collection_tab_image
                elsif link.object.featured_image != blank
                  assign tile_img = link.object.featured_image
                endif
              endif

              if tile_img == nil and link.type == 'catalog_link'
                assign coll_first = collections.first
                if coll_first and coll_first.featured_image != blank
                  assign tile_img = coll_first.featured_image
                endif
              endif
            -%}

            {%- if tile_img != blank -%}
              {%- assign tile_count = tile_count | plus: 1 -%}
              {%- assign tile_handles = tile_handles | append: forloop.index | append: ',' -%}
              <a class="atelier-photo-tile" href="{{ link.url }}">
                <div class="atelier-photo-tile__media">
                  {{ tile_img | image_url: width: 360 | image_tag: loading: 'lazy', widths: '160, 240, 360', sizes: '140px', alt: link.title }}
                </div>
                <div class="atelier-photo-tile__info">
                  <span class="atelier-photo-tile__title">{{ link.title | escape }}</span>
                  {%- if link.type == 'collection_link' and link.object -%}
                    <span class="atelier-photo-tile__count">{{ link.object.all_products_count }} items</span>
                  {%- else -%}
                    <span class="atelier-photo-tile__count">View collection</span>
                  {%- endif -%}
                </div>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <!-- Menu Navigation Rows (Bullet-free & Constrained Chevron) -->
      <ul class="atelier-drawer__rows" role="list">
        {%- for link in mobile_menu -%}
          {%- assign check_key = ',' | append: forloop.index | append: ',' -%}
          {%- if tile_handles contains check_key -%}{%- continue -%}{%- endif -%}
          <li style="list-style: none !important;">
            {%- if link.links.size > 0 -%}
              <details class="atelier-drawer__details">
                <summary class="atelier-drawer__row-link">
                  <span>{{ link.title | escape }}</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </summary>
                <ul class="atelier-drawer__sublist" role="list">
                  {%- for child in link.links -%}
                    <li style="list-style: none !important;">
                      <a class="atelier-drawer__sublink" href="{{ child.url }}">
                        {{ child.title | escape }}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              </details>
            {%- else -%}
              <a class="atelier-drawer__row-link" href="{{ link.url }}">
                <span>{{ link.title | escape }}</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>

    <!-- Pinned Bottom Section: Account Card & WhatsApp Button (User Explicit Request) -->
    <div class="atelier-drawer__footer">
      <!-- Dedicated Account Card -->
      <a class="atelier-drawer__account-card" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">
        <div class="atelier-drawer__account-icon">
          {{ icon_account }}
        </div>
        <div class="atelier-drawer__account-text">
          <span class="atelier-drawer__account-title">
            {% if customer %}My Account ({{ customer.first_name }}){% else %}Log in / Register{% endif %}
          </span>
          <span class="atelier-drawer__account-sub">
            {% if customer %}View orders & wishlist{% else %}Access your wishlist & order history{% endif %}
          </span>
        </div>
        <div class="atelier-drawer__account-arrow">&rarr;</div>
      </a>

      <!-- WhatsApp Action Button -->
      {%- if s.m_show_contact -%}
        <a class="atelier-drawer__wa-btn" href="https://wa.me/{{ whatsapp_clean | default: '919876543210' }}" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true"><path d="M12 2.2a9.7 9.7 0 0 0-8.4 14.6L2.3 21.8l5.1-1.3A9.7 9.7 0 1 0 12 2.2Zm0 17.7c-1.5 0-3-.4-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1 1 12 19.9Zm4.4-6c-.2-.1-1.4-.7-1.7-.8-.2-.1-.4-.1-.5.1l-.8.9c-.1.2-.3.2-.5.1a6.6 6.6 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.5-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 1.9s.8 2.2.9 2.4c.1.1 1.6 2.5 4 3.5 1.5.6 2.1.7 2.8.6.5-.1 1.4-.6 1.6-1.1.2-.6.2-1 .1-1.1l-.6-.4Z"/></svg>
          <span>Chat on WhatsApp</span>
        </a>
      {%- endif -%}

      {%- if s.m_hours != blank -%}
        <div class="atelier-drawer__footer-hours">{{ s.m_hours | escape }}</div>
      {%- endif -%}
      <p class="atelier-drawer__footer-tagline">{{ s.tagline | default: 'Artful Things. Thoughtful Living.' }}</p>
    </div>
  </aside>
  </atelier-header>

  
</section>

