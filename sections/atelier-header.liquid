{{ 'atelier-header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'atelier-header.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
  assign menu = s.menu.links | default: linklists.main-menu.links
  assign mobile_menu = s.mobile_menu.links | default: menu
  assign glass_alpha = s.glass_opacity | divided_by: 100.0
  assign phone_clean = s.phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign whatsapp_clean = s.whatsapp | remove: ' ' | remove: '+' | remove: '-'
  assign logo_alt = s.logo.alt | default: shop.name

  # Announcement Bar Logic
  assign show_announcement = s.show_announcement
  if s.announcement_text == blank
    assign show_announcement = false
  endif
-%}

{%- capture icon_search -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4.35-4.35"/></svg>{%- endcapture -%}
{%- capture icon_account -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4.5 20c.9-3.6 3.9-5.6 7.5-5.6s6.6 2 7.5 5.6"/></svg>{%- endcapture -%}
{%- capture icon_heart -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>{%- endcapture -%}
{%- capture icon_bag -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>{%- endcapture -%}
{%- capture icon_phone -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h3.2l1.6 4-2 1.3a10.5 10.5 0 0 0 4.9 4.9l1.3-2 4 1.6V17a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2Z"/></svg>{%- endcapture -%}
{%- capture icon_burger -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 7h17M3.5 12h17M3.5 17h11"/></svg>{%- endcapture -%}
{%- capture icon_close -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>{%- endcapture -%}
{%- capture icon_arrow -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-5-6 6 6-6 6"/></svg>{%- endcapture -%}
{%- capture icon_chev -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7 10 5 5 5-5"/></svg>{%- endcapture -%}

{%- capture logo_markup -%}
  <a class="atelier-logo" href="{{ s.logo_link | default: routes.root_url }}" aria-label="{{ shop.name | escape }} – home">
    {%- if s.show_cup -%}
      <span class="atelier-cup{% if s.animate_steam %} atelier-cup--steam{% endif %}">
        {%- if s.cup_image != blank -%}
          {{ s.cup_image | image_url: width: 120 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '60,120', alt: '' }}
        {%- else -%}
          <img src="{{ 'header-cup.png' | asset_url }}" width="30" height="44" loading="eager" alt="">
        {%- endif -%}
        <span class="atelier-steam" aria-hidden="true"></span>
        <span class="atelier-steam atelier-steam--second" aria-hidden="true"></span>
      </span>
    {%- endif -%}

    {%- if s.logo != blank -%}
      {{ s.logo | image_url: width: 600 | image_tag: widths: '200, 300, 400, 600', sizes: '240px', loading: 'eager', fetchpriority: 'high', alt: logo_alt }}
    {%- else -%}
      <span class="atelier-logo__text">{{ s.logo_text | default: shop.name | escape }}</span>
    {%- endif -%}
  </a>
{%- endcapture -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --ann-bg: {{ s.announcement_bg }};
    --ann-color: {{ s.announcement_text_color }};
    --ann-size: {{ s.announcement_font_size }}px;
    --ann-speed: {{ s.announcement_speed }}s;

    --header-glass: {{ s.glass_color | color_modify: 'alpha', glass_alpha }};
    --header-solid: {{ s.glass_color }};
    --header-text: {{ s.text_color }};
    --header-accent: {{ s.accent_color }};
    --header-border: {{ s.border_color | color_modify: 'alpha', 0.4 }};
    --header-line: {{ s.text_color | color_modify: 'alpha', 0.1 }};
    --header-radius: {{ s.radius }}px;
    --header-blur: {{ s.blur }}px;

    --gap-top: {{ s.gap_top }}px;
    --gap-side: {{ s.gap_side }}px;
    --gap-top-mobile: {{ s.gap_top_mobile }}px;
    --gap-side-mobile: {{ s.gap_side_mobile }}px;

    --logo-width: {{ s.logo_width }}px;
    --logo-width-mobile: {{ s.logo_width_mobile }}px;

    --menu-size: {{ s.menu_font_size }}px;
    --menu-weight: {{ s.menu_font_weight }};
    --menu-transform: {{ s.menu_text_transform }};
    --menu-letter-spacing: {{ s.menu_letter_spacing | default: 1 }}px;
    --icon-size: {{ s.icon_size }}px;
  }


/* ==========================================================================
   Graffeine Tales - Universal Header Core Styles
   Guarantees zero FOUC, no bullet points, correct flex/grid layout and floating pill
   ========================================================================== */
.atelier-header-section {
  position: -webkit-sticky !important;
  position: sticky !important;
  top: 0 !important;
  z-index: 40 !important;
  pointer-events: none !important;
  margin-bottom: calc(-1 * var(--header-pill-height, 108px)) !important;
  transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1) !important;
}

atelier-header {
  display: block !important;
  width: 100% !important;
  pointer-events: none !important;
  font-family: 'Inter', -apple-system, sans-serif !important;
  color: var(--header-text, #363638) !important;
}

atelier-header, atelier-header * {
  box-sizing: border-box !important;
}

atelier-header a {
  color: inherit !important;
  text-decoration: none !important;
}

atelier-header button {
  font: inherit !important;
  color: inherit !important;
  background: transparent !important;
  border: none !important;
  cursor: pointer !important;
}

atelier-header ul,
atelier-header li,
.atelier-header__nav-list,
.atelier-header__nav-list li {
  list-style: none !important;
  list-style-type: none !important;
  margin: 0 !important;
  padding: 0 !important;
}

.atelier-header__bar {
  pointer-events: none !important;
  position: relative !important;
  max-width: calc(1400px + var(--gap-side, 24px) * 2) !important;
  margin-inline: auto !important;
  padding: var(--gap-top, 14px) var(--gap-side, 24px) 0 !important;
  transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1) !important;
}

.atelier-header__pill {
  pointer-events: auto !important;
  position: relative !important;
  isolation: isolate !important;
  border-radius: var(--header-radius, 18px) !important;
  padding: 8px 24px !important;
  min-height: 60px !important;
  background: var(--header-glass, rgba(248, 245, 237, 0.78)) !important;
  -webkit-backdrop-filter: blur(var(--header-blur, 20px)) saturate(160%) !important;
  backdrop-filter: blur(var(--header-blur, 20px)) saturate(160%) !important;
  border: 1px solid var(--header-border, rgba(198, 181, 142, 0.35)) !important;
  box-shadow: 0 12px 36px -12px rgba(54, 54, 56, 0.12), 0 2px 8px -2px rgba(54, 54, 56, 0.04) !important;
  transition: background 0.4s ease, box-shadow 0.4s ease, border-color 0.4s ease !important;
}

/* Two-rows layout explicit rules */
.layout--two-rows .atelier-header__pill,
.layout--two_rows .atelier-header__pill {
  display: grid !important;
  grid-template-columns: 1fr auto 1fr !important;
  grid-template-areas: "left center right" "nav nav nav" !important;
  align-items: center !important;
  padding-top: 10px !important;
  padding-bottom: 8px !important;
}

.layout--two-rows .atelier-header__left,
.layout--two_rows .atelier-header__left {
  grid-area: left !important;
  display: flex !important;
  align-items: center !important;
  justify-content: flex-start !important;
  min-width: 0 !important;
}

.layout--two-rows .atelier-header__center,
.layout--two_rows .atelier-header__center {
  grid-area: center !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
}

.layout--two-rows .atelier-header__right,
.layout--two_rows .atelier-header__right {
  grid-area: right !important;
  display: flex !important;
  align-items: center !important;
  justify-content: flex-end !important;
  gap: 8px !important;
}

.layout--two-rows .atelier-header__nav,
.layout--two_rows .atelier-header__nav {
  grid-area: nav !important;
  display: flex !important;
  justify-content: center !important;
  margin-top: 8px !important;
  padding-top: 8px !important;
  border-top: 1px solid var(--header-line, rgba(54, 54, 56, 0.08)) !important;
  width: 100% !important;
}

.layout--two-rows .atelier-header__nav-list,
.layout--two_rows .atelier-header__nav-list {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  flex-wrap: wrap !important;
  gap: 4px 16px !important;
  list-style: none !important;
  width: 100% !important;
}

/* Fallback padding for pages that don't have a hero banner */
body:not(.template-index):not(.template-collection) #MainContent > .shopify-section:first-child:not(:has(.atelier-col-hero)):not(:has(.atelier-hero)):not(:has(.image-banner)):not(:has(.slideshow)) {
  padding-top: calc(var(--header-height, 120px) + 24px) !important;
}

/* ==========================================================================
   Graffeine Tales — Premium Glass Header
   Adapted from UrbanDeco Reference Architecture for Graffeine Tales Editorial Brand
   Brand Palette:
   - Warm Paper: #F8F5ED
   - Espresso Charcoal: #363638
   - Logo Cream: #E9DFC2
   - Sand / Gold Accent: #C6B58E / #927B53
   - Deep Coffee: #4D351D
   - Soft Cream Card: #FDFBF7
   ========================================================================== */

:root {
  --gt-warm-paper: #F8F5ED;
  --gt-espresso: #363638;
  --gt-logo-cream: #E9DFC2;
  --gt-sand: #C6B58E;
  --gt-deep-coffee: #4D351D;
  --gt-cream-card: #FDFBF7;
}

/* ==========================================================================
   Announcement Bar (Top Strip)
   ========================================================================== */
.atelier-announcement {
  width: 100%;
  position: relative;
  z-index: 45;
  background-color: var(--ann-bg, #1E1814);
  color: var(--ann-color, #F8F5ED);
  font-family: 'Inter', -apple-system, sans-serif;
  font-size: var(--ann-size, 12px);
  font-weight: 500;
  letter-spacing: 0.05em;
  padding: 8px 16px;
  overflow: hidden;
  pointer-events: auto;
}

.atelier-announcement__inner {
  max-width: 1400px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.atelier-announcement__content {
  flex: 1;
  text-align: center;
  overflow: hidden;
}

.atelier-announcement__content--left { text-align: left; }
.atelier-announcement__content--center { text-align: center; }
.atelier-announcement__content--right { text-align: right; }

.atelier-announcement__link {
  color: inherit;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  transition: opacity 0.2s ease;
}

.atelier-announcement__link:hover {
  opacity: 0.85;
}

/* Scrolling Marquee */
.atelier-announcement--marquee .atelier-announcement__content {
  display: flex;
  white-space: nowrap;
  overflow: hidden;
}

.atelier-announcement__track {
  display: inline-flex;
  white-space: nowrap;
  animation: atelierMarquee var(--ann-speed, 25s) linear infinite;
  gap: 40px;
  padding-left: 100%;
}

@keyframes atelierMarquee {
  0% { transform: translateX(0); }
  100% { transform: translateX(-100%); }
}

.atelier-announcement__country {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 11px;
  opacity: 0.85;
  flex-shrink: 0;
}

.atelier-announcement__country svg {
  width: 14px;
  height: 14px;
}

/* Visibility modifiers */
.atelier-announcement--desktop-only { display: block; }
.atelier-announcement--mobile-only { display: none; }

@media screen and (max-width: 767px) {
  .atelier-announcement--desktop-only { display: none; }
  .atelier-announcement--mobile-only { display: block; }
}

/* ==========================================================================
   Main Header Section & Floating Bar Container
   ========================================================================== */
.atelier-header-section {
  width: 100%;
  z-index: 40;
  pointer-events: none;
  transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
}

.atelier-header-section.is-sticky {
  position: -webkit-sticky;
  position: sticky;
  top: 0;
}

.atelier-header-section.is-hidden {
  transform: translateY(-110%);
}

atelier-header {
  display: block;
  width: 100%;
  pointer-events: none;
  font-family: 'Inter', -apple-system, sans-serif;
  color: var(--header-text, #363638);
}

atelier-header *, atelier-header *::before, atelier-header *::after {
  box-sizing: border-box;
}

atelier-header a {
  color: inherit;
  text-decoration: none;
}

atelier-header button {
  font: inherit;
  color: inherit;
}

/* Floating Bar Container */
.atelier-header__bar {
  position: relative;
  max-width: calc(1400px + var(--gap-side, 24px) * 2);
  margin-inline: auto;
  padding: var(--gap-top, 14px) var(--gap-side, 24px) 0;
  transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
}

/* Frosted Glass Floating Pill */
.atelier-header__pill {
  position: relative;
  isolation: isolate;
  border-radius: var(--header-radius, 18px);
  padding: 0 20px;
  min-height: 64px;
  pointer-events: auto;
  border: 1px solid var(--header-border, rgba(198, 181, 142, 0.35));
  box-shadow: 0 12px 36px -12px rgba(54, 54, 56, 0.12),
              0 2px 8px -2px rgba(54, 54, 56, 0.04);
  transition: background 0.4s ease, box-shadow 0.4s ease, border-color 0.4s ease;
}

.atelier-header__pill::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: -1;
  border-radius: inherit;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.45), rgba(255, 255, 255, 0.08) 60%),
              var(--header-glass, rgba(248, 245, 237, 0.82));
  -webkit-backdrop-filter: blur(var(--header-blur, 20px)) saturate(160%);
  backdrop-filter: blur(var(--header-blur, 20px)) saturate(160%);
}

@supports not ((backdrop-filter: blur(2px)) or (-webkit-backdrop-filter: blur(2px))) {
  .atelier-header__pill::before {
    background: var(--header-solid, #F8F5ED);
  }
}

.atelier-header__bar.is-scrolled .atelier-header__pill {
  box-shadow: 0 16px 42px -12px rgba(54, 54, 56, 0.18),
              0 4px 12px -2px rgba(54, 54, 56, 0.06);
}

/* ==========================================================================
   Header Layout Options:
   1. Two lines: logo on top, menu below (.layout--two-rows, .layout--two_rows)
   2. Menu left, logo centre (.layout--logo-center, .layout--logo_center)
   3. Logo left, menu centre (.layout--logo-left, .layout--logo_left)
   ========================================================================== */

/* Layout 1: Two rows (UrbanDeco reference) */
.layout--two-rows, .layout--two_rows .atelier-header__pill {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  grid-template-areas: "left center right" "nav nav nav";
  align-items: center;
  padding-top: 10px;
  padding-bottom: 6px;
}

.layout--two-rows, .layout--two_rows .atelier-header__left {
  grid-area: left;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  min-width: 0;
}

.layout--two-rows, .layout--two_rows .atelier-header__center {
  grid-area: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.layout--two-rows, .layout--two_rows .atelier-header__right {
  grid-area: right;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 6px;
}

.layout--two-rows, .layout--two_rows .atelier-header__nav {
  grid-area: nav;
  display: flex;
  justify-content: center;
  margin-top: 8px;
  padding-top: 6px;
  border-top: 1px solid var(--header-line, rgba(54, 54, 56, 0.08));
}

.layout--two-rows, .layout--two_rows .atelier-header__nav-list {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  list-style: none;
  margin: 0;
  padding: 0;
}

/* Layout 2: Logo Centre, Menu Left */
.layout--logo-center, .layout--logo_center .atelier-header__pill {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  min-height: 72px;
}

.layout--logo-center, .layout--logo_center .atelier-header__left {
  display: flex;
  align-items: center;
}

.layout--logo-center, .layout--logo_center .atelier-header__center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.layout--logo-center, .layout--logo_center .atelier-header__right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 6px;
}

.layout--logo-center, .layout--logo_center .atelier-header__nav-list {
  display: flex;
  align-items: center;
  list-style: none;
  margin: 0;
  padding: 0;
}

/* Layout 3: Logo Left, Menu Centre */
.layout--logo-left, .layout--logo_left .atelier-header__pill {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  min-height: 72px;
}

.layout--logo-left, .layout--logo_left .atelier-header__center {
  order: -1;
  padding-right: 24px;
}

.layout--logo-left, .layout--logo_left .atelier-header__left {
  display: flex;
  align-items: center;
  justify-content: center;
}

.layout--logo-left, .layout--logo_left .atelier-header__right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 6px;
}

.layout--logo-left, .layout--logo_left .atelier-header__nav-list {
  display: flex;
  align-items: center;
  justify-content: center;
  list-style: none;
  margin: 0;
  padding: 0;
}

/* ==========================================================================
   Search Input Pill in Main Header (UrbanDeco reference)
   ========================================================================== */
.atelier-search-pill {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  width: min(100%, 280px);
  height: 42px;
  margin: 0;
  padding: 0 16px;
  border: 1px solid var(--header-line, rgba(54, 54, 56, 0.12));
  border-radius: 9999px;
  background: rgba(255, 255, 255, 0.55);
  color: rgba(54, 54, 56, 0.65);
  font-family: 'Inter', -apple-system, sans-serif;
  font-size: 13px;
  text-align: left;
  cursor: pointer;
  transition: background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
}

.atelier-search-pill:hover {
  background: rgba(255, 255, 255, 0.9);
  border-color: var(--gt-sand, #C6B58E);
  box-shadow: 0 2px 8px rgba(54, 54, 56, 0.05);
}

.atelier-search-pill svg {
  flex: 0 0 18px;
  width: 18px;
  height: 18px;
  color: var(--header-text, #363638);
}

.atelier-search-pill span {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ==========================================================================
   Logo & Brand Treatment
   ========================================================================== */
.atelier-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  text-decoration: none;
  min-height: 44px;
}

.atelier-logo img {
  display: block;
  width: var(--logo-width, 170px);
  max-width: 100%;
  height: auto;
  transition: opacity 0.2s ease;
}

.atelier-logo:hover img {
  opacity: 0.9;
}

.atelier-logo__text {
  font-family: 'DM Serif Display', Georgia, serif;
  font-size: 24px;
  font-weight: 400;
  letter-spacing: 0.06em;
  color: var(--header-text, #363638);
  white-space: nowrap;
}

/* Graffeine Tales Coffee Cup with Steam */
.atelier-cup {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 30px;
  height: 44px;
  flex-shrink: 0;
}

.atelier-cup img {
  width: 100%;
  height: auto;
  display: block;
}

.atelier-steam {
  position: absolute;
  top: 4px;
  left: 50%;
  width: 4px;
  height: 12px;
  border-radius: 999px;
  background: linear-gradient(180deg, rgba(198, 181, 142, 0.8), transparent);
  transform: translateX(-50%);
  opacity: 0;
  pointer-events: none;
}

.atelier-cup--steam .atelier-steam {
  animation: steamRise 2.4s ease-in-out infinite;
}

.atelier-cup--steam .atelier-steam--second {
  animation: steamRise 2.4s ease-in-out infinite 1.2s;
  left: calc(50% + 4px);
}

@keyframes steamRise {
  0% { transform: translate(-50%, 0) scaleX(1); opacity: 0; }
  50% { opacity: 0.6; }
  100% { transform: translate(-50%, -14px) scaleX(1.6); opacity: 0; }
}

/* ==========================================================================
   Header Action Icons (Right)
   ========================================================================== */
.atelier-icon-btn {
  position: relative;
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: transparent;
  color: var(--header-text, #363638);
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
  transition: background 0.3s ease, color 0.3s ease, transform 0.2s ease;
}

.atelier-icon-btn svg {
  width: var(--icon-size, 22px);
  height: var(--icon-size, 22px);
  transition: transform 0.3s ease;
}

.atelier-icon-btn:hover {
  background: rgba(255, 255, 255, 0.65);
  color: var(--header-accent, #4D351D);
}

.atelier-icon-btn:hover svg {
  transform: translateY(-1px);
}

.atelier-icon-btn:focus-visible {
  outline: 2px solid var(--header-accent, #4D351D);
  outline-offset: 2px;
}

/* Count Badges (Wishlist & Cart) */
.atelier-badge {
  position: absolute;
  top: 2px;
  right: 0px;
  min-width: 18px;
  height: 18px;
  padding: 0 4px;
  border-radius: 9px;
  background: var(--header-accent, #4D351D);
  color: #FFFFFF;
  font-family: 'Inter', -apple-system, sans-serif;
  font-size: 10px;
  font-weight: 600;
  line-height: 18px;
  text-align: center;
  box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.85);
  pointer-events: none;
}

.atelier-badge[hidden] {
  display: none !important;
}

/* ==========================================================================
   Desktop Navigation Links & Active Indicators
   ========================================================================== */
.atelier-nav__link {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  height: 44px;
  margin: 0;
  padding: 0 14px;
  border: 0;
  background: none;
  font-family: 'Inter', -apple-system, sans-serif;
  font-size: var(--menu-size, 13px);
  font-weight: var(--menu-weight, 600);
  letter-spacing: var(--menu-letter-spacing, 0.08em);
  text-transform: var(--menu-transform, uppercase);
  color: var(--header-text, #363638);
  white-space: nowrap;
  cursor: pointer;
  transition: color 0.25s ease;
}

.atelier-nav__link svg {
  width: 12px;
  height: 12px;
  opacity: 0.65;
  transition: transform 0.35s ease;
}

/* Refined Underline Indicator */
.atelier-nav__link::after {
  content: '';
  position: absolute;
  left: 14px;
  right: 14px;
  bottom: 8px;
  height: 2px;
  background: var(--header-accent, #4D351D);
  transform: scaleX(0);
  transform-origin: right;
  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

.atelier-nav__link:hover,
.atelier-nav__link[aria-expanded="true"],
.atelier-nav__link.is-current {
  color: var(--header-accent, #4D351D);
}

.atelier-nav__link:hover::after,
.atelier-nav__link[aria-expanded="true"]::after,
.atelier-nav__link.is-current::after {
  transform: scaleX(1);
  transform-origin: left;
}

.atelier-nav__link[aria-expanded="true"] svg {
  transform: rotate(180deg);
}

.atelier-nav__link.is-bold {
  font-weight: 800;
}

/* ==========================================================================
   Floating Frosted Glass Mega Menu Panel (UrbanDeco style)
   ========================================================================== */
.atelier-mega {
  position: absolute;
  top: calc(100% + 10px);
  left: var(--gap-side, 24px);
  right: var(--gap-side, 24px);
  max-width: 1400px;
  margin: 0 auto;
  border-radius: var(--header-radius, 18px);
  border: 1px solid var(--header-border, rgba(198, 181, 142, 0.35));
  box-shadow: 0 24px 64px -16px rgba(54, 54, 56, 0.22),
              0 4px 16px -2px rgba(54, 54, 56, 0.06);
  padding: 32px 36px;
  pointer-events: auto;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-8px);
  transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1),
              transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
              visibility 0.3s;
  z-index: 50;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.65), rgba(255, 255, 255, 0.15) 60%),
              var(--header-glass, rgba(248, 245, 237, 0.94));
  -webkit-backdrop-filter: blur(24px) saturate(160%);
  backdrop-filter: blur(24px) saturate(160%);
}

.atelier-mega.is-open {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.atelier-mega__inner {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 36px;
  align-items: start;
}

.atelier-mega__title {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: 'DM Serif Display', Georgia, serif;
  font-size: 18px;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--header-accent, #4D351D);
  margin-bottom: 24px;
  text-decoration: none;
  transition: opacity 0.2s ease;
}

.atelier-mega__title:hover {
  opacity: 0.8;
}

.atelier-mega__title svg {
  width: 14px;
  height: 14px;
  transition: transform 0.2s ease;
}

.atelier-mega__title:hover svg {
  transform: translateX(3px);
}

.atelier-mega__cols {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 28px 24px;
  list-style: none;
  margin: 0;
  padding: 0;
}

.atelier-mega__head {
  display: block;
  font-family: 'Inter', -apple-system, sans-serif;
  font-size: 13.5px;
  font-weight: 700;
  letter-spacing: 0.02em;
  color: var(--header-text, #363638);
  margin-bottom: 12px;
  text-decoration: none;
  transition: color 0.2s ease;
}

.atelier-mega__head:hover {
  color: var(--header-accent, #4D351D);
}

.atelier-mega__sub {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.atelier-mega__a {
  display: inline-block;
  font-family: 'Inter', -apple-system, sans-serif;
  font-size: 13px;
  font-weight: 400;
  color: rgba(54, 54, 56, 0.75);
  text-decoration: none;
  transition: color 0.2s ease, transform 0.2s ease;
}

.atelier-mega__a:hover {
  color: var(--header-accent, #4D351D);
  transform: translateX(2px);
}

/* Mega Menu Promotional Card (Right Side) */
.atelier-promo-card {
  display: flex;
  flex-direction: column;
  width: 280px;
  border-radius: 14px;
  overflow: hidden;
  background: #FFFFFF;
  border: 1px solid rgba(198, 181, 142, 0.35);
  box-shadow: 0 10px 28px -10px rgba(54, 54, 56, 0.12);
  text-decoration: none;
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
}

.atelier-promo-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 16px 36px -12px rgba(77, 53, 29, 0.2);
}

.atelier-promo-card__img {
  width: 100%;
  aspect-ratio: 16 / 10;
  overflow: hidden;
  background-color: var(--gt-warm-paper);
}

.atelier-promo-card__img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.atelier-promo-card:hover .atelier-promo-card__img img {
  transform: scale(1.05);
}

.atelier-promo-card__body {
  padding: 16px 18px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.atelier-promo-card__h {
  font-family: 'DM Serif Display', Georgia, serif;
  font-size: 16px;
  font-weight: 400;
  color: var(--header-text, #363638);
  line-height: 1.3;
}

.atelier-promo-card__s {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: 'Inter', -apple-system, sans-serif;
  font-size: 11.5px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--header-accent, #4D351D);
  margin-top: 6px;
}

.atelier-promo-card__s svg {
  width: 12px;
  height: 12px;
  transition: transform 0.2s ease;
}

.atelier-promo-card:hover .atelier-promo-card__s svg {
  transform: translateX(4px);
}

/* ==========================================================================
   Live Search Dropdown Panel
   ========================================================================== */
.atelier-search-panel {
  position: absolute;
  top: calc(100% + 10px);
  left: var(--gap-side, 24px);
  right: var(--gap-side, 24px);
  max-width: 900px;
  margin: 0 auto;
  border-radius: var(--header-radius, 18px);
  border: 1px solid var(--header-border, rgba(198, 181, 142, 0.35));
  box-shadow: 0 24px 64px -16px rgba(54, 54, 56, 0.25);
  padding: 24px 28px;
  pointer-events: auto;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-8px);
  transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s;
  z-index: 50;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.75), rgba(255, 255, 255, 0.25) 60%),
              var(--header-glass, rgba(248, 245, 237, 0.94));
  -webkit-backdrop-filter: blur(24px) saturate(160%);
  backdrop-filter: blur(24px) saturate(160%);
}

.atelier-search-panel.is-open {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.atelier-search-form {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 18px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.85);
  border: 1px solid var(--gt-sand, #C6B58E);
}

.atelier-search-form svg {
  width: 20px;
  height: 20px;
  color: var(--header-accent, #4D351D);
}

.atelier-search-input {
  flex: 1;
  border: 0;
  background: transparent;
  font-family: 'Inter', -apple-system, sans-serif;
  font-size: 15px;
  color: var(--header-text, #363638);
  outline: none;
}

.atelier-search-input::placeholder {
  color: rgba(54, 54, 56, 0.5);
}

.atelier-search-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  list-style: none;
  margin: 12px 0 0;
  padding: 0;
}

.atelier-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 14px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.75);
  border: 1px solid rgba(198, 181, 142, 0.4);
  font-size: 12.5px;
  color: var(--header-text, #363638);
  text-decoration: none;
  transition: all 0.2s ease;
}

.atelier-chip:hover {
  background: #FFFFFF;
  border-color: var(--header-accent, #4D351D);
  color: var(--header-accent, #4D351D);
}

/* Live Search Results List */
.atelier-search-results {
  margin-top: 16px;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 12px;
  max-height: 380px;
  overflow-y: auto;
}

.atelier-search-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 8px 12px;
  border-radius: 10px;
  text-decoration: none;
  color: inherit;
  transition: background 0.2s ease;
}

.atelier-search-item:hover {
  background: rgba(255, 255, 255, 0.85);
}

.atelier-search-item img {
  width: 48px;
  height: 48px;
  object-fit: cover;
  border-radius: 6px;
  background: #eee;
}

.atelier-search-item__info {
  display: flex;
  flex-direction: column;
  gap: 2px;
  overflow: hidden;
}

.atelier-search-item__title {
  font-size: 13px;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.atelier-search-item__price {
  font-size: 12px;
  color: var(--header-accent, #4D351D);
  font-weight: 500;
}

/* ==========================================================================
   Mobile Responsive Navigation & Drawer (< 990px)
   ========================================================================== */
.atelier-burger {
  display: none;
}

@media screen and (max-width: 989px) {
  .atelier-header__bar {
    padding: var(--gap-top-mobile, 10px) var(--gap-side-mobile, 10px) 0;
  }

  .atelier-header__pill {
    min-height: 56px;
    padding: 0 10px;
    display: grid !important;
    grid-template-columns: 1fr auto 1fr !important;
    grid-template-areas: none !important;
  }

  .atelier-header__nav {
    display: none !important;
  }

  .atelier-search-pill {
    display: none !important;
  }

  .atelier-burger {
    display: grid !important;
  }

  .atelier-header__left {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .atelier-header__center {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .atelier-header__right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 2px;
  }

  .atelier-desk-only {
    display: none !important;
  }
}

/* Mobile Slide-Out Drawer */
.atelier-drawer {
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  width: min(88vw, 380px);
  background: var(--gt-warm-paper, #F8F5ED);
  color: var(--header-text, #363638);
  box-shadow: 24px 0 60px -20px rgba(54, 54, 56, 0.35);
  transform: translateX(-102%);
  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  z-index: 100;
  display: flex;
  flex-direction: column;
  pointer-events: auto;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.atelier-drawer.is-open {
  transform: translateX(0);
}

.atelier-drawer__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  border-bottom: 1px solid rgba(198, 181, 142, 0.3);
}

.atelier-drawer__body {
  padding: 20px;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.atelier-drawer__nav-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.atelier-drawer__nav-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 14px;
  border-radius: 8px;
  font-size: 14.5px;
  font-weight: 600;
  color: var(--header-text, #363638);
  text-decoration: none;
  transition: background 0.2s ease;
}

.atelier-drawer__nav-link:hover {
  background: rgba(198, 181, 142, 0.15);
  color: var(--header-accent, #4D351D);
}

.atelier-drawer__nav-link svg {
  width: 14px;
  height: 14px;
  opacity: 0.6;
}

/* Mobile Quick Contact (Call & WhatsApp) */
.atelier-drawer__contact {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin-top: 12px;
}

.atelier-drawer__btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 14px;
  border-radius: 999px;
  border: 1px solid var(--header-border, rgba(198, 181, 142, 0.4));
  background: #FFFFFF;
  color: var(--header-text, #363638);
  font-size: 13px;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.2s ease;
}

.atelier-drawer__btn--wa {
  background: #25D366;
  border-color: #25D366;
  color: #FFFFFF;
}

.atelier-drawer__btn svg {
  width: 16px;
  height: 16px;
}

/* Scrim / Backdrop */
.atelier-scrim {
  position: fixed;
  inset: 0;
  background: rgba(30, 24, 20, 0.45);
  -webkit-backdrop-filter: blur(4px);
  backdrop-filter: blur(4px);
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.35s ease, visibility 0.35s;
  z-index: 90;
  pointer-events: auto;
}

.atelier-scrim.is-visible {
  opacity: 1;
  visibility: visible;
}

{%- endstyle -%}

<section
  id="shopify-section-{{ section.id }}"
  class="atelier-header-section{% if s.sticky %} is-sticky{% endif %}"
  data-section-id="{{ section.id }}"
>
  {%- comment -%} ==================== A. ANNOUNCEMENT BAR ==================== {%- endcomment -%}
  {%- if show_announcement -%}
    <aside
      class="atelier-announcement atelier-announcement--{{ s.announcement_visibility }}{% if s.announcement_scroll %} atelier-announcement--marquee{% endif %}"
      aria-label="Announcement"
    >
      <div class="atelier-announcement__inner">
        <div class="atelier-announcement__content atelier-announcement__content--{{ s.announcement_align }}">
          {%- if s.announcement_scroll -%}
            <div class="atelier-announcement__track">
              <span>{{ s.announcement_text | escape }}</span>
              <span>{{ s.announcement_text | escape }}</span>
              <span>{{ s.announcement_text | escape }}</span>
            </div>
          {%- else -%}
            {%- if s.announcement_link != blank -%}
              <a href="{{ s.announcement_link }}" class="atelier-announcement__link">
                <span>{{ s.announcement_text | escape }}</span>
                {{ icon_arrow }}
              </a>
            {%- else -%}
              <span>{{ s.announcement_text | escape }}</span>
            {%- endif -%}
          {%- endif -%}
        </div>

        {%- if s.show_country_selector -%}
          <div class="atelier-announcement__country">
            <span>IN</span>
            <span>({{ cart.currency.iso_code }})</span>
          </div>
        {%- endif -%}
      </div>
    </aside>
  {%- endif -%}

  {%- comment -%} ==================== B. MAIN HEADER FLOATING CONTAINER ==================== {%- endcomment -%}
  <atelier-header
    class="layout--{{ s.layout }}"
    data-layout="{{ s.layout }}"
    data-hide-on-scroll="{{ s.hide_on_scroll }}"
    data-overlay-home="{{ s.overlay_home }}"
    data-money-format="{{ shop.money_format | escape }}"
  >
    <div class="atelier-header__bar">
      <div class="atelier-header__pill">

        {%- comment -%} ---------- LEFT AREA ---------- {%- endcomment -%}
        <div class="atelier-header__left">
          {%- comment -%} Mobile hamburger trigger {%- endcomment -%}
          <button
            type="button"
            class="atelier-icon-btn atelier-burger"
            data-open-drawer
            aria-label="Open mobile menu"
            aria-expanded="false"
          >
            {{ icon_burger }}
          </button>

          {%- if s.layout == 'two_rows' -%}
            {%- comment -%} Two-rows layout: Search pill on left {%- endcomment -%}
            <button
              type="button"
              class="atelier-search-pill"
              data-open-search
              aria-label="Search journals and gifts"
              aria-expanded="false"
            >
              {{ icon_search }}
              <span>{{ s.search_placeholder | escape }}</span>
            </button>
          {%- elsif s.layout == 'logo_center' -%}
            {%- comment -%} Logo Center layout: Desktop menu on left {%- endcomment -%}
            <nav class="atelier-header__nav" aria-label="Main navigation">
              <ul class="atelier-header__nav-list" role="list">
                {%- for link in menu -%}
                  <li>
                    {%- if link.links.size > 0 -%}
                      <button
                        type="button"
                        class="atelier-nav__link{% if link.active or link.child_active %} is-current{% endif %}"
                        data-mega-trigger="{{ forloop.index }}"
                        aria-expanded="false"
                      >
                        {{ link.title | escape }}{{ icon_chev }}
                      </button>
                    {%- else -%}
                      <a class="atelier-nav__link{% if link.active %} is-current{% endif %}" href="{{ link.url }}">
                        {{ link.title | escape }}
                      </a>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </nav>
          {%- endif -%}
        </div>

        {%- comment -%} ---------- CENTER AREA (LOGO) ---------- {%- endcomment -%}
        <div class="atelier-header__center">
          {%- if request.page_type == 'index' and s.logo_h1 -%}
            <h1 style="margin: 0; line-height: 1;">{{ logo_markup }}</h1>
          {%- else -%}
            {{ logo_markup }}
          {%- endif -%}
        </div>

        {%- comment -%} ---------- RIGHT AREA (ACTION ICONS) ---------- {%- endcomment -%}
        <div class="atelier-header__right">
          {%- if s.layout != 'two_rows' -%}
            <button
              type="button"
              class="atelier-icon-btn atelier-desk-only"
              data-open-search
              aria-label="Search"
            >
              {{ icon_search }}
            </button>
          {%- endif -%}

          {%- if s.show_phone and phone_clean != blank -%}
            <a
              class="atelier-icon-btn atelier-desk-only"
              href="tel:{{ phone_clean }}"
              aria-label="Call customer support"
            >
              {{ icon_phone }}
            </a>
          {%- endif -%}

          {%- if s.show_account and shop.customer_accounts_enabled -%}
            <a
              class="atelier-icon-btn atelier-desk-only"
              href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
              aria-label="Customer account"
            >
              {{ icon_account }}
            </a>
          {%- endif -%}

          {%- if s.show_wishlist -%}
            <button
              type="button"
              class="atelier-icon-btn"
              data-open-wishlist
              aria-label="Wishlist saved items"
            >
              {{ icon_heart }}
              <span class="atelier-badge" data-wishlist-count hidden>0</span>
            </button>
          {%- endif -%}

          {%- if s.show_cart -%}
            <a
              class="atelier-icon-btn"
              id="cart-icon-bubble"
              data-cart-btn
              href="{{ routes.cart_url }}"
              aria-label="Shopping Cart"
            >
              {{ icon_bag }}
              {%- if cart.item_count > 0 -%}
                <span class="atelier-badge cart-count-bubble">
                  <span aria-hidden="true">{{ cart.item_count }}</span>
                  <span class="visually-hidden">{{ cart.item_count }} items</span>
                </span>
              {%- endif -%}
            </a>
          {%- endif -%}
        </div>

        {%- comment -%} ---------- SECOND ROW (TWO-ROWS NAVIGATION) ---------- {%- endcomment -%}
        {%- if s.layout == 'two_rows' or s.layout == 'logo_left' -%}
          <nav class="atelier-header__nav" aria-label="Main navigation">
            <ul class="atelier-header__nav-list" role="list">
              {%- for link in menu -%}
                {%- liquid
                  assign bold = false
                  assign t_down = link.title | downcase
                  if s.bold_words != blank
                    assign words = s.bold_words | downcase | split: ','
                    for w in words
                      assign ww = w | strip
                      if ww != blank and t_down contains ww
                        assign bold = true
                      endif
                    endfor
                  endif
                -%}
                <li>
                  {%- if link.links.size > 0 -%}
                    <button
                      type="button"
                      class="atelier-nav__link{% if link.active or link.child_active %} is-current{% endif %}{% if bold %} is-bold{% endif %}"
                      data-mega-trigger="{{ forloop.index }}"
                      aria-expanded="false"
                    >
                      {{ link.title | escape }}{{ icon_chev }}
                    </button>
                  {%- else -%}
                    <a
                      class="atelier-nav__link{% if link.active %} is-current{% endif %}{% if bold %} is-bold{% endif %}"
                      href="{{ link.url }}"
                    >
                      {{ link.title | escape }}
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}

      </div>

      {%- comment -%} ==================== C. DESKTOP MEGA MENUS ==================== {%- endcomment -%}
      {%- for link in menu -%}
        {%- if link.links.size == 0 -%}{%- continue -%}{%- endif -%}
        {%- assign lt = link.title | downcase | strip -%}
        <div
          class="atelier-mega"
          id="atelier-mega-{{ forloop.index }}"
          data-mega-panel="{{ forloop.index }}"
          role="region"
          aria-label="{{ link.title | escape }} sub-menu"
        >
          <div class="atelier-mega__inner">
            <div class="atelier-mega__main">
              <a class="atelier-mega__title" href="{{ link.url }}">
                Shop All {{ link.title | escape }}{{ icon_arrow }}
              </a>

              <ul class="atelier-mega__cols" role="list">
                {%- for child in link.links -%}
                  <li>
                    <a class="atelier-mega__head" href="{{ child.url }}">{{ child.title | escape }}</a>
                    {%- if child.links.size > 0 -%}
                      <ul class="atelier-mega__sub" role="list">
                        {%- for grandchild in child.links -%}
                          <li>
                            <a class="atelier-mega__a" href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </div>

            {%- comment -%} Promotional Photo Card on Right {%- endcomment -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'promo' -%}
                {%- assign bt = block.settings.menu_item | downcase | strip -%}
                {%- if bt == lt -%}
                  <a
                    class="atelier-promo-card"
                    href="{{ block.settings.link | default: link.url }}"
                    {{ block.shopify_attributes }}
                  >
                    <div class="atelier-promo-card__img">
                      {%- if block.settings.image != blank -%}
                        {{ block.settings.image | image_url: width: 600 | image_tag: widths: '300, 480, 600', sizes: '280px', loading: 'lazy', alt: block.settings.heading | escape }}
                      {%- else -%}
                        <div style="width: 100%; height: 100%; background: linear-gradient(135deg, #E9DFC2 0%, #C6B58E 100%);"></div>
                      {%- endif -%}
                    </div>
                    <div class="atelier-promo-card__body">
                      {%- if block.settings.heading != blank -%}
                        <span class="atelier-promo-card__h">{{ block.settings.heading | escape }}</span>
                      {%- endif -%}
                      {%- if block.settings.subheading != blank -%}
                        <span class="atelier-promo-card__s">{{ block.settings.subheading | escape }}{{ icon_arrow }}</span>
                      {%- endif -%}
                    </div>
                  </a>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}

      {%- comment -%} ==================== D. LIVE PREDICTIVE SEARCH DROPDOWN ==================== {%- endcomment -%}
      <div
        class="atelier-search-panel"
        data-search-panel
        role="dialog"
        aria-label="Product search"
      >
        <form class="atelier-search-form" action="{{ routes.search_url }}" method="get" role="search">
          {{ icon_search }}
          <input type="hidden" name="type" value="product">
          <input
            class="atelier-search-input"
            type="search"
            name="q"
            placeholder="{{ s.search_placeholder | escape }}"
            autocomplete="off"
            autocorrect="off"
            spellcheck="false"
            data-search-input
          >
          <button type="button" class="atelier-icon-btn" data-close-drawer aria-label="Close search">
            {{ icon_close }}
          </button>
        </form>

        <div class="atelier-search-results" data-search-results></div>

        <div data-search-idle>
          {%- comment -%} Recent Searches {%- endcomment -%}
          <div data-recent-wrapper hidden style="margin-top: 14px;">
            <p style="font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; margin: 0 0 6px; color: var(--header-accent, #4D351D);">
              Recent Searches
            </p>
            <ul class="atelier-search-chips" data-recent-chips role="list"></ul>
          </div>

          {%- comment -%} Popular Searches {%- endcomment -%}
          {%- if s.popular_searches != blank -%}
            <div style="margin-top: 14px;">
              <p style="font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; margin: 0 0 6px; color: var(--header-accent, #4D351D);">
                Popular Searches
              </p>
              <ul class="atelier-search-chips" role="list">
                {%- assign terms = s.popular_searches | split: ',' -%}
                {%- for term in terms -%}
                  {%- assign tt = term | strip -%}
                  {%- if tt != blank -%}
                    <li>
                      <a class="atelier-chip" href="{{ routes.search_url }}?type=product&q={{ tt | url_encode }}">
                        {{ tt | escape }}
                      </a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          {%- comment -%} Category Photo Tiles {%- endcomment -%}
          {%- if s.search_collections != blank -%}
            <div style="margin-top: 16px;">
              <p style="font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; margin: 0 0 8px; color: var(--header-accent, #4D351D);">
                {{ s.search_collections_title | escape }}
              </p>
              <ul class="atelier-search-chips" role="list">
                {%- for col in s.search_collections limit: 6 -%}
                  <li>
                    <a class="atelier-chip" href="{{ col.url }}">
                      {{ col.title | escape }}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        </div>
      </div>

    </div>

    {%- comment -%} Backdrop Scrim {%- endcomment -%}
    <div class="atelier-scrim" data-scrim aria-hidden="true"></div>

    {%- comment -%} ==================== E. MOBILE SLIDE-OUT DRAWER ==================== {%- endcomment -%}
    <div
      class="atelier-drawer"
      data-mobile-drawer
      role="dialog"
      aria-modal="true"
      aria-label="Navigation menu"
    >
      <div class="atelier-drawer__top">
        {{ logo_markup }}
        <button type="button" class="atelier-icon-btn" data-close-drawer aria-label="Close menu">
          {{ icon_close }}
        </button>
      </div>

      <div class="atelier-drawer__body">
        {%- comment -%} Mobile Search Trigger {%- endcomment -%}
        <button
          type="button"
          class="atelier-search-pill"
          style="display: flex; width: 100%; margin-bottom: 12px;"
          data-open-search
          aria-label="Search"
        >
          {{ icon_search }}
          <span>{{ s.search_placeholder | escape }}</span>
        </button>

        {%- comment -%} Mobile Promo Banner {%- endcomment -%}
        {%- if s.m_show_promo and s.promo_heading != blank -%}
          <a
            href="{{ s.promo_link | default: routes.all_products_collection_url }}"
            style="display: block; padding: 14px 18px; border-radius: 12px; background: {{ s.promo_bg }}; color: {{ s.promo_text }}; text-decoration: none; margin-bottom: 14px;"
          >
            <strong style="display: block; font-family: 'DM Serif Display', Georgia, serif; font-size: 15px;">{{ s.promo_heading | escape }}</strong>
            {%- if s.promo_link_label != blank -%}
              <span style="display: inline-flex; align-items: center; gap: 4px; font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; margin-top: 4px; opacity: 0.9;">
                {{ s.promo_link_label | escape }}{{ icon_arrow }}
              </span>
            {%- endif -%}
          </a>
        {%- endif -%}

        {%- comment -%} Mobile Menu Links {%- endcomment -%}
        <ul class="atelier-drawer__nav-list" role="list">
          {%- for link in mobile_menu -%}
            <li>
              {%- if link.links.size > 0 -%}
                <details style="border-bottom: 1px solid rgba(198, 181, 142, 0.25); padding: 8px 0;">
                  <summary class="atelier-drawer__nav-link" style="cursor: pointer; list-style: none;">
                    <span>{{ link.title | escape }}</span>
                    {{ icon_chev }}
                  </summary>
                  <ul style="list-style: none; margin: 4px 0 8px 12px; padding: 0; display: flex; flex-direction: column; gap: 6px;" role="list">
                    {%- for child in link.links -%}
                      <li>
                        <a href="{{ child.url }}" style="display: block; padding: 6px 12px; font-size: 13.5px; color: var(--header-text, #363638);">
                          {{ child.title | escape }}
                        </a>
                      </li>
                    {%- endfor -%}
                    <li>
                      <a href="{{ link.url }}" style="display: inline-flex; align-items: center; gap: 4px; padding: 6px 12px; font-size: 12px; font-weight: 600; color: var(--header-accent, #4D351D); text-transform: uppercase;">
                        All {{ link.title | escape }}{{ icon_arrow }}
                      </a>
                    </li>
                  </ul>
                </details>
              {%- else -%}
                <a class="atelier-drawer__nav-link" href="{{ link.url }}">
                  <span>{{ link.title | escape }}</span>
                  {{ icon_arrow }}
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>

        {%- comment -%} Mobile Contact Buttons (Call & WhatsApp) {%- endcomment -%}
        {%- if s.m_show_contact -%}
          <div class="atelier-drawer__contact">
            {%- if phone_clean != blank -%}
              <a class="atelier-drawer__btn" href="tel:{{ phone_clean }}">
                {{ icon_phone }}
                <span>Call Us</span>
              </a>
            {%- endif -%}
            {%- if whatsapp_clean != blank -%}
              <a class="atelier-drawer__btn atelier-drawer__btn--wa" href="https://wa.me/{{ whatsapp_clean }}" target="_blank" rel="noopener">
                <span>WhatsApp</span>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- comment -%} Customer Account & Hours {%- endcomment -%}
        <div style="margin-top: auto; padding-top: 16px; border-top: 1px solid rgba(198, 181, 142, 0.3);">
          {%- if shop.customer_accounts_enabled -%}
            <a
              href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
              style="display: flex; align-items: center; gap: 8px; font-size: 13.5px; font-weight: 600; color: var(--header-text, #363638); margin-bottom: 8px;"
            >
              {{ icon_account }}
              <span>{% if customer %}{{ customer.first_name | default: 'My Account' }}{% else %}Log In / Sign Up{% endif %}</span>
            </a>
          {%- endif -%}
          {%- if s.m_hours != blank -%}
            <p style="margin: 0; font-size: 11.5px; color: #888;">{{ s.m_hours | escape }}</p>
          {%- endif -%}
        </div>

        {%- if s.tagline != blank -%}
          <p style="margin: 12px 0 0; font-size: 11px; color: #999; text-align: center;">{{ s.tagline | escape }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Wishlist Slide-Out Modal Integration {%- endcomment -%}
    <dialog
      class="atelier-header__drawer"
      data-wishlist-dialog
      aria-labelledby="WishlistHeading-{{ section.id }}"
      style="padding: 24px; border: 0; background: #F8F5ED; border-radius: 16px; max-width: 440px; width: 90vw; margin: auto; box-shadow: 0 20px 60px rgba(0,0,0,0.25);"
    >
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;">
        <h2 id="WishlistHeading-{{ section.id }}" style="font-family: 'DM Serif Display', Georgia, serif; font-size: 22px; margin: 0; color: #363638;">
          Your Saved Pieces
        </h2>
        <button type="button" class="atelier-icon-btn" onclick="this.closest('dialog').close()" aria-label="Close wishlist">
          {{ icon_close }}
        </button>
      </div>
      <div data-wishlist-empty style="text-align: center; padding: 32px 16px;">
        <p style="font-size: 14px; color: #666; margin-bottom: 20px;">Save the journals, stickers and pieces you love. They will appear right here.</p>
        <a href="{{ routes.all_products_collection_url }}" class="atelier-drawer__btn" style="background: #4D351D; color: #FFFFFF; border-color: #4D351D; width: 100%;">
          Explore All Products
        </a>
      </div>
    </dialog>

  </atelier-header>
</section>

{% schema %}
{
  "name": "Atelier header",
  "tag": "section",
  "class": "atelier-header-section",
  "limit": 1,
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Announcement Bar"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Enable announcement bar",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "Artful Things. Thoughtful Living. | Free Shipping on orders over ₹999"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Announcement link"
    },
    {
      "type": "select",
      "id": "announcement_align",
      "label": "Text alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "color",
      "id": "announcement_bg",
      "label": "Background colour",
      "default": "#1E1814"
    },
    {
      "type": "color",
      "id": "announcement_text_color",
      "label": "Text colour",
      "default": "#F8F5ED"
    },
    {
      "type": "range",
      "id": "announcement_font_size",
      "label": "Font size",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "announcement_scroll",
      "label": "Enable scrolling marquee text",
      "default": false
    },
    {
      "type": "range",
      "id": "announcement_speed",
      "label": "Scrolling speed (seconds)",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "default": 25
    },
    {
      "type": "checkbox",
      "id": "show_country_selector",
      "label": "Show country/currency indicator",
      "default": true
    },
    {
      "type": "select",
      "id": "announcement_visibility",
      "label": "Device visibility",
      "default": "all",
      "options": [
        { "value": "all", "label": "Desktop & Mobile" },
        { "value": "desktop", "label": "Desktop only" },
        { "value": "mobile", "label": "Mobile only" }
      ]
    },

    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Desktop logo"
    },
    {
      "type": "image_picker",
      "id": "mobile_logo",
      "label": "Mobile logo"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Text logo (fallback)",
      "default": "GRAFFEINE TALES"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width (desktop)",
      "min": 80,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 170
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "label": "Logo width (mobile)",
      "min": 60,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 120
    },
    {
      "type": "checkbox",
      "id": "logo_h1",
      "label": "Logo is the H1 on the homepage",
      "default": false
    },
    {
      "type": "url",
      "id": "logo_link",
      "label": "Logo link destination"
    },
    {
      "type": "checkbox",
      "id": "show_cup",
      "label": "Show signature coffee cup icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "animate_steam",
      "label": "Animate coffee steam",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "cup_image",
      "label": "Custom coffee cup image"
    },

    {
      "type": "header",
      "content": "Navigation & Menu"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main menu",
      "default": "main-menu"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop layout",
      "default": "two_rows",
      "options": [
        { "value": "two_rows", "label": "Two lines: logo on top, menu below" },
        { "value": "logo_center", "label": "Menu left, logo centre" },
        { "value": "logo_left", "label": "Logo left, menu centre" }
      ],
      "info": "Two lines provides the UrbanDeco layout with search pill on top left, logo centered, icons on top right, and navigation below."
    },
    {
      "type": "link_list",
      "id": "mobile_menu",
      "label": "Phone menu (optional)",
      "info": "Use a longer menu on phones. Leave empty to use the main menu."
    },
    {
      "type": "text",
      "id": "bold_words",
      "label": "Make these menu items bold",
      "default": "journal, sale, new",
      "info": "Separate with commas"
    },
    {
      "type": "range",
      "id": "menu_font_size",
      "label": "Menu font size",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "select",
      "id": "menu_font_weight",
      "label": "Menu font weight",
      "default": "600",
      "options": [
        { "value": "400", "label": "Normal (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semi-bold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ]
    },
    {
      "type": "select",
      "id": "menu_text_transform",
      "label": "Text transformation",
      "default": "uppercase",
      "options": [
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "capitalize", "label": "Capitalize" },
        { "value": "none", "label": "None" }
      ]
    },
    {
      "type": "range",
      "id": "menu_letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 1
    },

    {
      "type": "header",
      "content": "Search"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Enable search",
      "default": true
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search journals, notebooks, gifts…"
    },
    {
      "type": "text",
      "id": "popular_searches",
      "label": "Popular searches",
      "default": "Linen Journals, Daily Planners, Bookmarks, Stickers, Gift Sets",
      "info": "Separate with commas"
    },
    {
      "type": "collection_list",
      "id": "search_collections",
      "label": "Search photo tiles",
      "limit": 6
    },
    {
      "type": "text",
      "id": "search_collections_title",
      "label": "Photo tiles heading",
      "default": "Shop by category"
    },
    {
      "type": "checkbox",
      "id": "search_recent",
      "label": "Remember recent searches",
      "default": true
    },

    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Show phone icon",
      "default": false
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number",
      "default": "919876543210"
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account_mobile",
      "label": "Show account icon on phones",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show wishlist (heart) icon",
      "default": true
    },
    {
      "type": "page",
      "id": "wishlist_page",
      "label": "Wishlist page destination (optional)"
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show shopping bag/cart icon",
      "default": true
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 16,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 22
    },

    {
      "type": "header",
      "content": "Glass Style & Colors"
    },
    {
      "type": "color",
      "id": "glass_color",
      "label": "Glass background color",
      "default": "#F8F5ED"
    },
    {
      "type": "range",
      "id": "glass_opacity",
      "label": "Glass opacity (transparency)",
      "min": 20,
      "max": 95,
      "step": 5,
      "unit": "%",
      "default": 75
    },
    {
      "type": "range",
      "id": "blur",
      "label": "Backdrop blur strength",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
