/* ==========================================================================
   MOBILE HEADER (< 990px) — EXACT URBANDECO 2 - 1 - 2 LAYOUT
   Left: [ ≡ ] [ 🔍 ] (Hamburger + Search Icon Side-by-side)
   Center: Centered Logo with independent Mobile Sizing Controls
   Right: [ ♡ ] [ 🛍️ ] (Wishlist + Cart ONLY, ZERO Search/Account Icons)
   ========================================================================== */
@media screen and (max-width: 989px) {
  .atelier-header__bar {
    padding: var(--gap-top-mobile, 10px) var(--gap-side-mobile, 12px) 0 !important;
  }
