    min-height: 52px !important;
    padding: 0 12px !important;
    gap: 8px !important;
    border-radius: var(--header-radius, 22px) !important;
  }

  /* LEFT: Hamburger + Search Icon Buttons STRICTLY SIDE-BY-SIDE */
  .atelier-header__left {
    display: flex !important;
    align-items: center !important;
    justify-content: flex-start !important;
    flex: 0 0 auto !important;
    gap: 6px !important;
    min-width: 0 !important;
    overflow: visible !important;
  }
  .atelier-burger {
    display: grid !important;
    place-items: center !important;
    width: 36px !important;
    height: 36px !important;
    padding: 0 !important;
    margin: 0 !important;
    border: none !important;
    background: transparent !important;
    color: var(--header-text, #363638) !important;
    border-radius: 50% !important;
  }
  .atelier-burger svg {
    display: block !important;
    width: 20px !important;
    height: 20px !important;
    stroke: currentColor !important;
  }

  .atelier-header__left .atelier-search-btn,
  .atelier-header__left .atelier-search-btn--mobile {
    display: grid !important;
    place-items: center !important;
    width: 36px !important;
    height: 36px !important;
    padding: 0 !important;
    margin: 0 !important;
    border: none !important;
    background: transparent !important;
    color: var(--header-text, #363638) !important;
    border-radius: 50% !important;
  }
  .atelier-header__left .atelier-search-btn svg,
  .atelier-header__left .atelier-search-btn--mobile svg {
    display: block !important;
    width: 19px !important;
    height: 19px !important;
    stroke: currentColor !important;
  }

  /* HIDE Desktop Elements on Mobile */
  .atelier-search-pill,
  .atelier-header__nav {
    display: none !important;
  }

  /* CRITICAL: GUARANTEE Search is NEVER on the right on mobile */
  .atelier-header__right .atelier-search-btn,
  .atelier-header__right .atelier-search-btn--desktop,
  .atelier-search-btn--desktop {
