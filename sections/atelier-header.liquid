  width: 20px;
  height: 20px;
  color: var(--header-text, #363638);
  margin-right: 12px;
}
.atelier-search-form input[type="search"] {
  flex: 1;
  background: transparent;
  border: none;
  font-family: 'Inter', sans-serif;
  font-size: 16px;
  color: var(--header-text, #363638);
  outline: none;
}
