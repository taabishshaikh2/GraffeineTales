
{% if section.settings.collection.products.size > 0 %}
{{ 'product-showcase.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-showcase.js' | asset_url }}" defer></script>
<atelier-product-showcase id="built-with-heart-section" data-showcase-columns="{{ section.settings.columns }}" data-currency="{{ cart.currency.iso_code | escape }}" data-add-label="{{ section.settings.add_label | escape }}" data-adding-label="{{ section.settings.adding_label | escape }}" data-added-label="{{ section.settings.added_label | escape }}" data-error-label="{{ section.settings.error_label | escape }}" data-sold-out-label="{{ section.settings.sold_out_label | escape }}" style="--showcase-heart:{{ section.settings.heart_color }};--showcase-background:{{ section.settings.background }};--showcase-card:{{ section.settings.card_background }};--showcase-image:{{ section.settings.image_background }};--showcase-text:{{ section.settings.text_color }};--showcase-accent:{{ section.settings.accent }};--showcase-button:{{ section.settings.button_background }};--showcase-button-text:{{ section.settings.button_color }};--showcase-badge:{{ section.settings.badge_background }};--showcase-badge-text:{{ section.settings.badge_color }};--showcase-gold:{{ section.settings.gold_badge_background }};--showcase-gold-text:{{ section.settings.gold_badge_color }};--showcase-width:{{ section.settings.width }}px;--showcase-columns:{{ section.settings.columns }};--showcase-gap:{{ section.settings.gap }}px;--showcase-mobile-width:{{ section.settings.mobile_width }}px;--showcase-card-height:{{ section.settings.card_height }}px;--showcase-image-height:{{ section.settings.image_height }}px;--showcase-image-padding:{{ section.settings.image_padding }}px;--showcase-radius:{{ section.settings.radius }}px;--showcase-heading-size:{{ section.settings.heading_size }}px;--showcase-top:{{ section.settings.padding_top }}px;--showcase-bottom:{{ section.settings.padding_bottom }}px">
  <div class="atelier-showcase__inner">
    <header class="atelier-showcase__heading">
      {% if section.settings.eyebrow != blank %}<p>{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}{% if section.settings.show_heading_heart %}<svg class="atelier-showcase__heading-heart" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"/></svg>{% endif %}</h2>{% endif %}
      {% if section.settings.description != blank %}<div class="atelier-showcase__intro">{{ section.settings.description | escape }}</div>{% endif %}
    </header>
    <div class="atelier-showcase__grid">
      {% for card_product in section.settings.collection.products limit: section.settings.product_limit %}
        {% render 'product-card', card_product: card_product, section: section %}
      
      {% endfor %}
    </div>
    <p class="atelier-showcase__status visually-hidden" data-showcase-status role="status" aria-live="polite"></p>
  </div>
  <dialog class="atelier-quick-view" data-quick-view-dialog aria-labelledby="QuickViewTitle-{{ section.id }}">
    <button type="button" class="atelier-quick-view__close" data-close-quick-view aria-label="{{ section.settings.close_label | escape }}">{% render 'header-icon', name: 'close' %}</button>
    <p class="atelier-quick-view__loading" data-quick-view-loading>{{ section.settings.loading_label | escape }}</p>
    <div class="atelier-quick-view__layout" data-quick-view-body hidden>
      <div class="atelier-quick-view__media"><img data-quick-view-image alt="" width="600" height="700"></div>
      <div class="atelier-quick-view__details">
        <h2 id="QuickViewTitle-{{ section.id }}" data-quick-view-title>{{ section.settings.quick_view_label | escape }}</h2>
        <p class="atelier-quick-view__price" data-quick-view-price></p>
        <div class="atelier-quick-view__description" data-quick-view-description></div>
        <form data-atelier-product-form data-quick-view-form action="{{ routes.cart_add_url }}" method="post">
          <div data-quick-view-variant-row><label for="QuickViewVariant-{{ section.id }}">{{ section.settings.variant_label | escape }}</label><select id="QuickViewVariant-{{ section.id }}" name="id" data-quick-view-variants></select></div>
          <label for="QuickViewQuantity-{{ section.id }}">{{ section.settings.quantity_label | escape }}</label>
          <div class="atelier-quick-view__quantity"><button type="button" data-quantity-change="-1" aria-label="{{ 'products.product.quantity.decrease' | t: product: section.settings.quick_view_label }}">−</button><input id="QuickViewQuantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" step="1" inputmode="numeric"><button type="button" data-quantity-change="1" aria-label="{{ 'products.product.quantity.increase' | t: product: section.settings.quick_view_label }}">+</button></div>
          <button class="atelier-product-card__add" type="submit" data-quick-view-add>{{ section.settings.add_label | escape }}</button>
        </form>
        <p class="atelier-product-card__error" data-quick-view-error role="alert" hidden></p>
        <a class="atelier-quick-view__link" data-quick-view-link>{{ section.settings.details_label | escape }}</a>
      </div>
    </div>
  </dialog>
</atelier-product-showcase>


{% else %}{% style %}#shopify-section-{{ section.id }}{display:none}{% endstyle %}{% endif %}
{% stylesheet %}
.atelier-showcase__heading-heart { display: inline-block; width: 24px; height: 24px; fill: var(--showcase-heart); margin-left: 6px; vertical-align: baseline; }
@media (min-width: 1024px) and (max-width: 1279px) {
  atelier-product-showcase[data-showcase-columns="4"] .atelier-showcase__grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}
{% endstylesheet %}
{% schema %}
{
  "name": "Built with heart",
  "tag": "section",
  "class": "product-showcase-section",
  "settings": [
    {
      "type": "header",
      "content": "Content and products"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Customised & Handmade"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built with heart"
    },
    {
      "type": "checkbox",
      "id": "show_heading_heart",
      "label": "Show heart beside heading",
      "default": true
    },
    {
      "type": "color",
      "id": "heart_color",
      "label": "Heading heart colour",
      "default": "#D94A60"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Optional introduction"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Products and their order are managed in this collection in Shopify admin."
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Maximum products",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "default_badge",
      "label": "Default badge",
      "default": "Handcrafted"
    },
    {
      "type": "select",
      "id": "default_badge_style",
      "label": "Badge style",
      "options": [
        {
          "value": "sage",
          "label": "Sage"
        },
        {
          "value": "gold",
          "label": "Gold"
        }
      ],
      "default": "gold"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "width",
      "label": "Content width",
      "min": 1000,
      "max": 1440,
      "step": 20,
      "unit": "px",
      "default": 1340
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Desktop columns",
      "options": [
        {
          "value": "2",
          "label": "Two"
        },
        {
          "value": "3",
          "label": "Three"
        },
        {
          "value": "4",
          "label": "Four"
        }
      ],
      "default": "4"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Desktop card spacing",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "mobile_width",
      "label": "Mobile card width",
      "min": 240,
      "max": 320,
      "step": 5,
      "unit": "px",
      "default": 275
    },
    {
      "type": "range",
      "id": "card_height",
      "label": "Desktop card height",
      "min": 440,
      "max": 560,
      "step": 10,
      "unit": "px",
      "default": 490
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Desktop image area height",
      "min": 200,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 250
    },
    {
      "type": "range",
      "id": "image_padding",
      "label": "Image inset",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 28,
      "max": 52,
      "step": 2,
      "unit": "px",
      "default": 42
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 24,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 24,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Section background",
      "default": "#FDFBF7"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "image_background",
      "label": "Image background",
      "default": "#F8F6F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#363638"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Eyebrow and rating colour",
      "default": "#927B53"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#4A3525"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button text",
      "default": "#FAF7F2"
    },
    {
      "type": "color",
      "id": "badge_background",
