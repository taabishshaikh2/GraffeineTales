      "default": "#263320"
    },
    {
      "type": "color",
      "id": "gold_badge_background",
      "label": "Gold badge background",
      "default": "#927B53"
    },
    {
      "type": "color",
      "id": "gold_badge_color",
      "label": "Gold badge text",
      "default": "#FFFFFF"
    },
    {
