{{ 'product-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-showcase.js' | asset_url }}" defer></script>
<script src="{{ 'product-hero.js' | asset_url }}" defer></script>
{% liquid
 assign current_variant = product.selected_or_first_available_variant
 assign product_form_id = 'AtelierProduct-' | append: section.id
 assign gallery = product.media
 assign media_limit = section.settings.media_limit | default: 6
 assign display_title = product.title
 assign product_content = product.metafields.graffeine_product
 assign journal_content = product.metafields.graffeine_journal
%}
<atelier-product-showcase class="atelier-pdp-cart" data-currency="{{ cart.currency.iso_code | escape }}" data-adding-label="{{ adding_label | escape }}" data-added-label="{{ added_label | escape }}" data-error-label="{{ error_label | escape }}">
<product-hero class="atelier-pdp" data-compact-money="{{ section.settings.compact_money }}" data-currency-symbol="{{ section.settings.currency_symbol | escape }}" data-show-compare="{{ section.settings.show_compare }}" data-show-saving="{{ section.settings.show_saving }}" data-section-id="{{ section.id }}" data-currency="{{ cart.currency.iso_code | escape }}" data-add-label="{{ section.settings.add_label | escape }}" data-sold-label="{{ sold_label | escape }}" data-unavailable-label="{{ unavailable_label | escape }}" style="--pdp-coffee:{{ section.settings.coffee }};--pdp-background:{{ section.settings.background }};--pdp-sand:{{ section.settings.sand }};--pdp-clay:{{ section.settings.clay }};--pdp-width:{{ section.settings.width }}px;--pdp-text:{{ section.settings.text_color }};--pdp-button:{{ section.settings.button_background }};--pdp-button-text:{{ section.settings.button_text }};--pdp-gallery-radius:{{ section.settings.gallery_radius }}px;--pdp-button-radius:{{ section.settings.button_radius }}px;--pdp-gap:{{ section.settings.column_gap }}px;--pdp-top:{{ section.settings.padding_top }}px;--pdp-bottom:{{ section.settings.padding_bottom }}px;--pdp-mobile-top:{{ section.settings.mobile_padding_top | default: 16 }}px;--pdp-mobile-bottom:{{ section.settings.mobile_padding_bottom | default: 40 }}px;--pdp-title:{{ section.settings.title_size }}px;--pdp-mobile-title:{{ section.settings.mobile_title_size }}px;--pdp-fit:{{ section.settings.image_fit }};--pdp-purchase-background:{{ section.settings.purchase_background }};--pdp-purchase-border:{{ section.settings.purchase_border }};--pdp-purchase-radius:{{ section.settings.purchase_radius }}px;--pdp-purchase-padding:{{ section.settings.purchase_padding }}px">
 {% if section.settings.show_breadcrumb %}<nav class="atelier-pdp__breadcrumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">{{ home_label | escape }}</a><span aria-hidden="true">/</span><a href="{{ routes.all_products_collection_url }}">{{ shop_label | escape }}</a><span aria-hidden="true">/</span><span>{{ product.title | escape }}</span></nav>{% endif %}
 <div class="atelier-pdp__columns">
  <div class="atelier-pdp__visual{% unless section.settings.sticky_gallery %} atelier-pdp__visual--static{% endunless %}"{% if gallery.size == 0 %} hidden{% endif %}>
   <div class="atelier-pdp__stage">
    <div class="atelier-pdp__track" data-gallery-track tabindex="0" aria-label="{{ gallery_label | escape }}">
     {% for media in gallery %}
      <div class="atelier-pdp__slide" data-media-id="{{ media.id }}" role="group" aria-label="{{ forloop.index }} / {{ gallery.size }}">
       {% case media.media_type %}
       {% when 'image' %}{% if forloop.first %}{{ media | image_url: width: 1800 | image_tag: widths: '450,750,1100,1500,1800', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'eager', fetchpriority: 'high' }}{% else %}{{ media | image_url: width: 1800 | image_tag: widths: '450,750,1100,1500,1800', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'lazy' }}{% endif %}
       {% when 'video' %}{{ media | video_tag: controls: true, preload: 'metadata', image_size: '1100x' }}
       {% when 'external_video' %}{{ media | external_video_tag }}
       {% when 'model' %}{{ media | model_viewer_tag: reveal: 'interaction', toggleable: true }}
       {% endcase %}
      </div>
     {% else %}<div class="atelier-pdp__slide">{{ 'product-1' | placeholder_svg_tag }}</div>{% endfor %}
    </div>
    {% if gallery.size > 1 %}
     {% if section.settings.show_arrows %}<button class="atelier-pdp__arrow atelier-pdp__arrow--previous" type="button" data-gallery-direction="-1" aria-label="{{ section.settings.previous_label | escape }}">{% render 'product-detail-icon', name: 'arrow' %}</button>{% endif %}
     {% if section.settings.show_arrows %}<button class="atelier-pdp__arrow atelier-pdp__arrow--next" type="button" data-gallery-direction="1" aria-label="{{ section.settings.next_label | escape }}">{% render 'product-detail-icon', name: 'arrow' %}</button>{% endif %}
     {% if section.settings.show_dots %}<div class="atelier-pdp__dots">{% for media in gallery %}<button type="button" data-gallery-index="{{ forloop.index0 }}" aria-label="{{ section.settings.image_label | escape }} {{ forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}></button>{% endfor %}</div>{% endif %}
    {% endif %}
   </div>
   {% if gallery.size > 1 and section.settings.show_thumbnails %}<div class="atelier-pdp__thumbnails" aria-label="{{ gallery_label | escape }}">{% for media in gallery %}<button type="button" data-gallery-index="{{ forloop.index0 }}"{% if forloop.first %} aria-current="true"{% endif %} aria-label="{{ section.settings.image_label | escape }} {{ forloop.index }}">{{ media.preview_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: media.alt }}</button>{% endfor %}</div>{% endif %}

  </div>
  <div class="atelier-pdp__purchase{% if section.settings.purchase_shadow %} atelier-pdp__purchase--shadow{% endif %}">
   
   <h1>{{ display_title | escape }}</h1>
   {% assign review_rating = product.metafields.reviews.rating.value %}{% assign review_count = product.metafields.reviews.rating_count.value %}
   {% if section.settings.show_product_rating and review_rating != blank %}<div class="atelier-pdp__rating"><span role="img" aria-label="{{ review_rating.rating }} / {{ review_rating.scale_max }}"><svg width="76" height="14" viewBox="0 0 100 18" aria-hidden="true"><defs><linearGradient id="RatingFill-{{ section.id }}"><stop offset="{{ review_rating.rating | times: 100.0 | divided_by: review_rating.scale_max }}%" stop-color="#A17D36"/><stop offset="{{ review_rating.rating | times: 100.0 | divided_by: review_rating.scale_max }}%" stop-color="#D8D0C5"/></linearGradient></defs><path fill="url(#RatingFill-{{ section.id }})" d="m9 0 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L9 14.3l-5.6 2.9 1.1-6.2L0 6.6l6.2-.9Zm20 0 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-2.9-5.6 2.9 1.1-6.2L20 6.6l6.2-.9Zm20 0 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-2.9-5.6 2.9 1.1-6.2L40 6.6l6.2-.9Zm20 0 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-2.9-5.6 2.9 1.1-6.2L60 6.6l6.2-.9Zm20 0 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-2.9-5.6 2.9 1.1-6.2L80 6.6l6.2-.9Z"/></svg></span>{% if review_count != blank %}<span>({{ review_count }} {{ section.settings.review_label | escape }})</span>{% endif %}</div>{% endif %}
   <div class="atelier-pdp__price-block"><div class="atelier-pdp__prices" aria-live="polite"><strong data-pdp-price>{% if section.settings.compact_money %}{{ section.settings.currency_symbol | escape }}{{ current_variant.price | money_without_currency | remove: '.00' }}{% else %}{{ current_variant.price | money }}{% endif %}</strong><s data-pdp-compare{% unless current_variant.compare_at_price > current_variant.price and section.settings.show_compare %} hidden{% endunless %}>{% if section.settings.compact_money %}{{ section.settings.currency_symbol | escape }}{{ current_variant.compare_at_price | money_without_currency | remove: '.00' }}{% else %}{{ current_variant.compare_at_price | money }}{% endif %}</s><span data-pdp-saving{% unless current_variant.compare_at_price > current_variant.price and section.settings.show_saving %} hidden{% endunless %}>{% if current_variant.compare_at_price > current_variant.price %}{{ section.settings.save_label | escape }} {{ current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round }}%{% endif %}</span></div>
    {%- if cart.taxes_included or cart.duties_included or shop.shipping_policy.body != blank -%}
      <p class="atelier-pdp__price-note">
        {%- if cart.duties_included and cart.taxes_included -%}
          {{ 'products.product.duties_and_taxes_included' | t }}
        {%- elsif cart.taxes_included -%}
          {{ 'products.product.taxes_included' | t }}
        {%- elsif cart.duties_included -%}
          {{ 'products.product.duties_included' | t }}
        {%- endif -%}
        {%- if shop.shipping_policy.body != blank -%}
          {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
        {%- endif -%}
      </p>
    {%- else -%}
      <p class="atelier-pdp__price-note">{{ 'products.product.taxes_included' | t }}</p>
    {%- endif -%}
   </div>
  
   {% form 'product', product, id: product_form_id, data-atelier-product-form: '' %}
    <input type="hidden" name="id" value="{{ current_variant.id }}">
    {% unless product.has_only_default_variant %}
     {% for option in product.options_with_values %}
      {% liquid
        assign option_index = forloop.index0
        assign opt_name_down = option.name | downcase
        assign use_swatches = false
        if option.name == section.settings.swatch_option_name or opt_name_down contains 'color' or opt_name_down contains 'colour' or opt_name_down contains 'tone' or opt_name_down contains 'cover' or opt_name_down contains 'shade' or opt_name_down contains 'swatch' or opt_name_down contains 'material'
          assign use_swatches = true
        endif
      %}
      <fieldset class="atelier-pdp__option{% if use_swatches %} atelier-pdp__option--tones{% endif %}" data-option-index="{{ option_index }}">
       <legend class="atelier-pdp__legend">
         <span class="atelier-pdp__legend-label">{{ option.name | escape }}:</span>
         <span class="atelier-pdp__legend-value" data-selected-option>{{ current_variant.options[option_index] | escape }}</span>
       </legend>
       <div class="atelier-pdp__option-values">
       {% for value in option.values %}
        {% liquid
         assign option_text = value.name | default: value
         assign val_down = option_text | downcase
         assign swatch_color = ''
         assign swatch_image = blank
         assign option_note = ''
         assign option_badge = ''
         assign option_icon = 'book'

         # 1. Native Shopify Swatches
         if value.swatch.color
           assign swatch_color = value.swatch.color
         endif
         if value.swatch.image
           assign swatch_image = value.swatch.image
         endif

         # 2. Dynamic Color Mapping based on name
         if swatch_color == blank and swatch_image == blank
           if val_down contains 'sage' or val_down contains 'herbarium' or val_down contains 'olive' or val_down contains 'forest'
             assign swatch_color = '#2D6A4F'
           elsif val_down contains 'terracotta' or val_down contains 'clay' or val_down contains 'rust' or val_down contains 'bloom'
             assign swatch_color = '#C85A32'
           elsif val_down contains 'espresso' or val_down contains 'midnight' or val_down contains 'charcoal' or val_down contains 'roast' or val_down contains 'black'
             assign swatch_color = '#363638'
           elsif val_down contains 'sand' or val_down contains 'cream' or val_down contains 'oat' or val_down contains 'linen' or val_down contains 'natural'
             assign swatch_color = '#C6B58E'
           elsif val_down contains 'indigo' or val_down contains 'celestial' or val_down contains 'navy' or val_down contains 'blue'
             assign swatch_color = '#303D67'
           elsif val_down contains 'gold' or val_down contains 'mustard' or val_down contains 'amber'
             assign swatch_color = '#D4AF37'
           elsif val_down contains 'blush' or val_down contains 'rose' or val_down contains 'pink'
             assign swatch_color = '#DDA7A5'
           elsif val_down contains 'white' or val_down contains 'ivory'
             assign swatch_color = '#F8F5ED'
           elsif val_down contains 'brown' or val_down contains 'coffee'
             assign swatch_color = '#4D351D'
           elsif val_down contains 'teal' or val_down contains 'emerald'
             assign swatch_color = '#008080'
           elsif val_down contains 'grey' or val_down contains 'gray' or val_down contains 'silver'
             assign swatch_color = '#8C8580'
           endif
         endif

         # 3. Dynamic subtext & icon for layout / format options
         if val_down contains 'calendar' or val_down contains 'dated' or val_down contains 'year' or val_down contains '2026' or val_down contains '2027' or val_down contains 'month'
           assign option_icon = 'calendar'
           assign option_note = 'Jan – Dec Calendar'
         elsif val_down contains 'undated' or val_down contains 'journal' or val_down contains 'book' or val_down contains 'page' or val_down contains 'note'
           assign option_icon = 'book'
           assign option_note = 'Start Anytime • 0 Waste'
         endif

         # 4. Parse title and subtext if separated by dash or bullet
         assign display_main = option_text
         if option_text contains ' - '
           assign split_parts = option_text | split: ' - '
           assign display_main = split_parts[0]
           assign option_note = split_parts[1]
         elsif option_text contains ' • '
           assign split_parts = option_text | split: ' • '
           assign display_main = split_parts[0]
           assign option_note = split_parts[1]
         endif

         # 5. Optional block overrides
         for option_block in section.blocks
           if option_block.type == 'option_detail' and option_block.settings.value == option_text and option_block.settings.enabled != false
             if option_block.settings.color != blank
               assign swatch_color = option_block.settings.color
             endif
             if option_block.settings.image != blank
               assign swatch_image = option_block.settings.image
             endif
             if option_block.settings.note != blank
               assign option_note = option_block.settings.note
             endif
             if option_block.settings.badge != blank
               assign option_badge = option_block.settings.badge
             endif
             if option_block.settings.icon != blank
               assign option_icon = option_block.settings.icon
             endif
           endif
         endfor

         # 6. Fallback swatch color
         if swatch_color == blank
           assign swatch_color = section.settings.coffee | default: '#4D351D'
         endif
        %}
        <label class="atelier-pdp__choice" style="--swatch:{{ swatch_color }}"{% if value.swatch.color %} data-native-swatch{% endif %}>
         <input type="radio" name="option-{{ option.position }}" value="{{ option_text | escape }}"{% if current_variant.options[option_index] == option_text %} checked{% endif %}>
         {% if use_swatches %}
           <span class="atelier-pdp__swatch" style="{% if swatch_image != blank %}background-image:url({{ swatch_image | image_url: width: 120 }});{% endif %}{% if value.swatch.color %}--swatch:{{ value.swatch.color }};{% endif %}{% if value.swatch.image %}background-image:url({{ value.swatch.image | image_url: width: 120 }});{% endif %}">
             {% render 'product-detail-icon', name: 'check' %}
           </span>
           <span class="visually-hidden">{{ option_text | escape }}</span>
         {% else %}
           <span class="atelier-pdp__layout-icon">{% render 'product-detail-icon', name: option_icon %}</span>
           <span class="atelier-pdp__choice-copy">
             <strong>{{ display_main | escape }}</strong>
             {% if option_note != blank %}<small>{{ option_note | escape }}</small>{% endif %}
             {% if option_badge != blank %}<em>{{ option_badge | escape }}</em>{% endif %}
           </span>
           <span class="atelier-pdp__selected-check">{% render 'product-detail-icon', name: 'check' %}</span>
         {% endif %}
        </label>
       {% endfor %}
       </div>
      </fieldset>
     {% endfor %}
    {% endunless %}
    {% if product.selling_plan_groups.size > 0 %}<label class="atelier-pdp__plan">{{ section.settings.plan_label | escape }}<select name="selling_plan">{% unless product.requires_selling_plan %}<option value="">{{ section.settings.one_time_label | escape }}</option>{% endunless %}{% for group in product.selling_plan_groups %}{% for plan in group.selling_plans %}<option value="{{ plan.id }}">{{ plan.name | escape }}</option>{% endfor %}{% endfor %}</select></label>{% endif %}
    <div class="atelier-pdp__buy-row">
     <div class="atelier-pdp__quantity"{% unless section.settings.show_quantity %} hidden{% endunless %}><button type="button" data-pdp-step="-1" aria-label="{{ section.settings.decrease_label | escape }}">−</button><input type="number" name="quantity" min="{{ current_variant.quantity_rule.min }}" step="{{ current_variant.quantity_rule.increment }}" value="{{ current_variant.quantity_rule.min }}"{% if current_variant.quantity_rule.max %} max="{{ current_variant.quantity_rule.max }}"{% endif %} aria-label="{{ section.settings.quantity_label | escape }}"><button type="button" data-pdp-step="1" aria-label="{{ section.settings.increase_label | escape }}">+</button></div>
     <button type="submit" class="atelier-pdp__add{% if section.settings.shimmer %} atelier-pdp__add--shimmer{% endif %}" data-pdp-add data-preserve-button-content{% unless current_variant.available %} disabled{% endunless %}>{% render 'product-detail-icon', name: 'bag' %}<span>{% if current_variant.available %}{{ section.settings.add_label | escape }}{% else %}{{ sold_label | escape }}{% endif %}</span></button>
    </div>
    {% if section.settings.dynamic_checkout %}<div class="atelier-pdp__express">{{ form | payment_button }}</div>{% endif %}
   {% endform %}
   <p data-cart-error role="alert" hidden></p>
   {% if product.description != blank %}<div class="atelier-pdp__description">{{ product.description }}</div>{% endif %}
   {% if section.settings.show_delivery %}
    <div class="atelier-pdp__delivery">{% render 'product-detail-icon', name: 'truck' %}<div><label for="Pincode-{{ section.id }}">{{ section.settings.delivery_heading | escape }}{% if section.settings.delivery_extra != blank %}<span>{{ section.settings.delivery_extra | escape }}</span>{% endif %}</label><div class="atelier-pdp__pincode"><input id="Pincode-{{ section.id }}" data-pincode inputmode="numeric" autocomplete="postal-code" maxlength="6" pattern="[1-9][0-9]{5}" placeholder="{{ section.settings.pincode_placeholder | escape }}"><button type="button" data-check-pincode>{{ section.settings.check_label | escape }}</button></div><p data-delivery-result role="status">{{ section.settings.delivery_note | escape }}</p></div></div>
   {% endif %}
   {% render 'product-information', product: product, section: section %}
  </div>
 </div>
 <p class="visually-hidden" data-showcase-status role="status" aria-live="polite"></p>
 <script type="application/json" data-variant-images>{% assign image_separator = '' %}{% for option_variant in product.variants %}{% if option_variant.featured_media != blank %}{{ image_separator }}{{ option_variant.id | append:'' | json }}:{"id":{{ option_variant.featured_media.id | json }}}{% assign image_separator = ',' %}{% endif %}{% endfor %}</script>
 <script type="application/json" data-product-variants>{{ product.variants | json }}</script>
 <script type="application/json" data-delivery-config>{"invalid":{{ section.settings.invalid_pincode | json }},"fallback":{{ section.settings.delivery_fallback | json }},"save":{{ section.settings.save_label | json }},"zones":[{% assign first_zone = true %}{% for block in section.blocks %}{% if block.type == 'delivery_zone' and block.settings.enabled != false %}{% unless first_zone %},{% endunless %}{"prefixes":{{ block.settings.prefixes | json }},"message":{{ block.settings.message | json }}}{% assign first_zone = false %}{% endif %}{% endfor %}]}</script>
  <div class="atelier-pdp__sticky-bar" data-pdp-sticky-bar aria-hidden="true">
   <div class="atelier-pdp__sticky-container">
    <div class="atelier-pdp__sticky-product">
     {% assign sticky_media = current_variant.featured_media | default: product.featured_media %}
     {% if sticky_media %}
      <img class="atelier-pdp__sticky-thumb" src="{{ sticky_media | image_url: width: 120 }}" alt="{{ sticky_media.alt | default: product.title | escape }}" width="44" height="44" loading="lazy" data-sticky-image>
     {% endif %}
     <div class="atelier-pdp__sticky-info">
      <span class="atelier-pdp__sticky-title">{{ product.title | escape }}</span>
      <span class="atelier-pdp__sticky-variant" data-sticky-variant{% if product.has_only_default_variant %} hidden{% endif %}>{{ current_variant.title | escape }}</span>
     </div>
    </div>
    <div class="atelier-pdp__sticky-actions">
     <div class="atelier-pdp__sticky-pricing">
      <span class="atelier-pdp__sticky-price" data-sticky-price>{{ current_variant.price | money }}</span>
      <s class="atelier-pdp__sticky-compare" data-sticky-compare{% unless current_variant.compare_at_price > current_variant.price and section.settings.show_compare %} hidden{% endunless %}>{{ current_variant.compare_at_price | money }}</s>
     </div>
     <button type="button" class="atelier-pdp__sticky-btn{% if section.settings.shimmer %} atelier-pdp__add--shimmer{% endif %}" data-sticky-add{% unless current_variant.available %} disabled{% endunless %}>
      {% render 'product-detail-icon', name: 'bag' %}
      <span data-sticky-btn-text>{% if current_variant.available %}{{ section.settings.add_label | escape }}{% else %}{{ sold_label | escape }}{% endif %}</span>
     </button>
    </div>
   </div>
  </div>
</product-hero>
</atelier-product-showcase>
<script type="application/ld+json">{{ product | structured_data }}</script>
{% schema %}
{
  "name": "Product details",
  "tag": "section",
  "class": "product-editorial-section",
  "settings": [
    {
      "type": "header",
      "content": "Start here"
    },
    {
      "type": "paragraph",
      "content": "Shared layout for all products. Product page metafields supply descriptions, specifications, what’s inside, features, shipping and additional accordions. Journal previews appear only when a preview book is linked."
    },
    {
      "type": "paragraph",
      "content": "Edit this product in Shopify admin → Products → Metafields. PDP · Category label, Short description, Price note, Key specifications and Accordions supply the content automatically. This editor controls styling, gallery and purchase behavior."
    },
    {
      "type": "header",
      "content": "Image gallery"
    },
    {
      "type": "paragraph",
      "content": "Add and reorder images in the product’s Media list. The gallery uses the first images up to the limit below."
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show previous / next arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show pill indicators",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_thumbnails",
      "label": "Show thumbnails",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sticky_gallery",
      "label": "Keep gallery visible on desktop scroll",
      "default": true
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "default": "contain",
      "options": [
        {
          "value": "contain",
          "label": "Show full image"
        },
        {
          "value": "cover",
          "label": "Fill square (crop edges)"
        }
      ]
    },
    {
      "type": "range",
      "id": "gallery_radius",
      "label": "Gallery corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 18,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Options and swatches"
    },
    {
      "type": "text",
      "id": "swatch_option_name",
      "label": "Option name for circular swatches",
      "default": "Cover Tone"
    },
    {
      "type": "paragraph",
      "content": "Enter the exact option name to use circular swatches. Add Option appearance blocks to match a value and set its color, texture image, note or highlight. Other options use selection cards."
    },
    {
      "type": "header",
      "content": "Price and cart"
    },
    {
      "type": "checkbox",
      "id": "show_compare",
      "label": "Show original price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_saving",
      "label": "Show savings badge",
      "default": true
    },
    {
      "type": "text",
