{{ 'atelier-collection-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hero_image = section.settings.fallback_image
  if collection.image != blank
    assign hero_image = collection.image
  endif

  assign show_badge = section.settings.show_badge
  assign badge_text = section.settings.badge_text
  assign text_align = section.settings.text_alignment | default: 'center'

  # Metafield collections list
  assign meta_tabs = collection.metafields.custom.collection_tabs.value | default: collection.metafields.custom.collection_tabs
  assign has_meta_tabs = false
  if meta_tabs != blank
    if meta_tabs.size > 0 or meta_tabs.count > 0
      assign has_meta_tabs = true
    endif
  endif

  # Fallback to section blocks if metafield has no collections
  assign has_block_tabs = false
  if section.blocks.size > 0
    assign has_block_tabs = true
  endif

  assign show_tabs = section.settings.show_subcollections

  assign render_tabs = false
  if show_tabs
    if has_meta_tabs or has_block_tabs
      assign render_tabs = true
    endif
  endif

  assign is_sticker_col = false
  assign c_h = collection.handle | downcase
  assign c_t = collection.title | downcase
  if c_h contains 'sticker' or c_t contains 'sticker' or c_h contains 'decal' or c_t contains 'decal' or c_h contains 'vinyl' or c_t contains 'vinyl'
    assign is_sticker_col = true
  endif
-%}

{%- style -%}
  {%- if is_sticker_col -%}
    #shopify-section-{{ section.id }} {
      display: none !important;
    }
  {%- endif -%}
  #shopify-section-{{ section.id }} {
    --hero-min-height-desktop: {{ section.settings.hero_height_desktop }}px;
    --hero-min-height-mobile: {{ section.settings.hero_height_mobile }}px;
    --hero-image-position: {{ section.settings.image_position | default: 'center center' }};
    --hero-image-fit: {{ section.settings.image_fit | default: 'cover' }};
    --avatar-size-desktop: {{ section.settings.avatar_size_desktop }}px;
    --avatar-size-mobile: {{ section.settings.avatar_size_mobile }}px;
    --tab-item-width: {{ section.settings.avatar_size_desktop | plus: 20 }}px;
    --tab-item-width-mobile: {{ section.settings.avatar_size_mobile | plus: 16 }}px;
  }

  #shopify-section-{{ section.id }} .atelier-col-hero__overlay {
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }

/* ==========================================================================
   Graffeine Tales - Editorial Collection Banner & Circular Tabs Navigation
   Brand Colors:
   - Warm Paper: #F8F5ED
   - Espresso Charcoal: #363638
   - Logo Cream: #E9DFC2
   - Sand / Gold Accent: #C6B58E / #927B53
   - Deep Coffee: #4D351D
   - Soft Cream Card: #FDFBF7
   Typography:
   - Heading / Editorial: 'DM Serif Display', Georgia, serif
   - UI / Tabs / Body: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif
   ========================================================================== */

:root {
  --gt-warm-paper: #F8F5ED;
  --gt-espresso: #363638;
  --gt-logo-cream: #E9DFC2;
  --gt-sand: #C6B58E;
  --gt-sand-light: rgba(198, 181, 142, 0.25);
  --gt-deep-coffee: #4D351D;
  --gt-cream-card: #FDFBF7;
}

.atelier-col-banner-section {
  width: 100%;
  position: relative;
  background-color: var(--gt-warm-paper);
}

/* ==========================================================================
   Dynamic Editorial Collection Banner (Top Section)
   ========================================================================== */
.atelier-col-hero {
  position: relative;
  width: 100%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #2b231d;
  min-height: var(--hero-min-height-desktop, 360px);
}

@media screen and (max-width: 767px) {
  .atelier-col-hero {
    min-height: var(--hero-min-height-mobile, 260px);
  }
}

.atelier-col-hero__media {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  pointer-events: none;
}

.atelier-col-hero__img {
  width: 100%;
  height: 100%;
  object-fit: var(--hero-image-fit, cover);
  object-position: var(--hero-image-position, center center);
  display: block;
  transform: scale(1.02);
  transition: transform 1.2s cubic-bezier(0.25, 1, 0.5, 1);
}

.atelier-col-hero:hover .atelier-col-hero__img {
  transform: scale(1.05);
}

/* Elegant Scrim / Dark Overlay Gradient for high contrast */
.atelier-col-hero__overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
  background: linear-gradient(
    180deg,
    rgba(32, 24, 19, 0.35) 0%,
    rgba(32, 24, 19, 0.65) 60%,
    rgba(22, 17, 13, 0.88) 100%
  );
  pointer-events: none;
}

.atelier-col-hero__inner {
  position: relative;
  z-index: 3;
  width: 100%;
  max-width: 1280px;
  margin: 0 auto;
  padding: calc(var(--header-height, 120px) + 24px) 24px 64px !important;
  display: flex;
  flex-direction: column;
  color: #FFFFFF;
}

@media screen and (max-width: 767px) {
  .atelier-col-hero__inner {
    padding: calc(var(--header-height, 120px) + 16px) 20px 44px !important;
  }
}

/* Alignment modifiers */
.atelier-col-hero__inner--center {
  align-items: center;
  text-align: center;
}

.atelier-col-hero__inner--left {
  align-items: flex-start;
  text-align: left;
}

/* Badge / Eyebrow */
.atelier-col-hero__badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 16px;
  margin-bottom: 18px;
  border-radius: 9999px;
  background: rgba(54, 54, 56, 0.65);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid var(--gt-sand);
  color: var(--gt-logo-cream);
  font-family: 'Inter', -apple-system, sans-serif;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.2);
}

.atelier-col-hero__badge-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background-color: var(--gt-sand);
  box-shadow: 0 0 8px rgba(198, 181, 142, 0.8);
}

/* Title in DM Serif Display */
.atelier-col-hero__title {
  margin: 0;
  font-family: 'DM Serif Display', Georgia, serif;
  font-size: clamp(2.2rem, 4.5vw, 4.2rem);
  line-height: 1.15;
  font-weight: 400;
  letter-spacing: -0.015em;
  color: #FFFFFF;
  text-shadow: 0 2px 16px rgba(0, 0, 0, 0.45);
}

/* Description */
.atelier-col-hero__description {
  margin-top: 16px;
  max-width: 680px;
  font-family: 'Inter', -apple-system, sans-serif;
  font-size: clamp(1.35rem, 1.6vw, 1.6rem);
  line-height: 1.6;
  font-weight: 400;
  color: rgba(233, 223, 194, 0.95);
  text-shadow: 0 1px 8px rgba(0, 0, 0, 0.35);
}

.atelier-col-hero__description p {
  margin: 0;
}

/* ==========================================================================
   Circular Sub-Collection Navigation Tabs (Below Banner)
   ========================================================================== */
.atelier-col-nav {
  position: relative;
  width: 100%;
  background-color: var(--gt-warm-paper);
  border-bottom: 1px solid rgba(198, 181, 142, 0.35);
  box-shadow: 0 2px 10px rgba(54, 54, 56, 0.03);
}

.atelier-col-nav__inner {
  max-width: 1360px;
  margin: 0 auto;
  padding: 24px 20px 22px;
}

@media screen and (max-width: 767px) {
  .atelier-col-nav__inner {
    padding: 18px 12px 16px;
  }
}

.atelier-col-nav__header {
  text-align: center;
  margin-bottom: 18px;
}

.atelier-col-nav__heading {
  font-family: 'Inter', -apple-system, sans-serif;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--gt-deep-coffee);
  margin: 0;
  opacity: 0.85;
}

/* Circular Tabs Track */
.atelier-col-tabs {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: 24px;
  list-style: none;
  margin: 0;
  padding: 6px 12px 10px;
}

@media screen and (max-width: 989px) {
  .atelier-col-tabs {
    gap: 18px;
  }
}

/* Mobile Horizontal Scrolling */
@media screen and (max-width: 767px) {
  .atelier-col-tabs {
    justify-content: flex-start;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding-left: 16px;
    padding-right: 16px;
    padding-bottom: 12px;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE/Edge */
  }

  .atelier-col-tabs::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }
}

/* Individual Tab Item */
.atelier-col-tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-decoration: none;
  text-align: center;
  width: var(--tab-item-width, 100px);
  flex-shrink: 0;
  scroll-snap-align: center;
  cursor: pointer;
  position: relative;
  group: 1;
  outline: none;
}

@media screen and (max-width: 767px) {
  .atelier-col-tab {
    width: var(--tab-item-width-mobile, 82px);
  }
}

/* Circular Avatar Wrapper */
.atelier-col-tab__avatar {
  width: var(--avatar-size-desktop, 84px);
  height: var(--avatar-size-desktop, 84px);
  border-radius: 9999px;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  position: relative;
  background-color: var(--gt-logo-cream);
  border: 2px solid var(--gt-sand);
  box-shadow: 0 4px 12px rgba(54, 54, 56, 0.08);
  transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1),
              border-color 0.24s ease,
              box-shadow 0.28s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

@media screen and (max-width: 767px) {
  .atelier-col-tab__avatar {
    width: var(--avatar-size-mobile, 68px);
    height: var(--avatar-size-mobile, 68px);
  }
}

/* Avatar Image */
.atelier-col-tab__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  border-radius: 9999px;
  transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
}

/* Avatar Fallback Placeholder */
.atelier-col-tab__placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #E9DFC2 0%, #C6B58E 100%);
  color: var(--gt-deep-coffee);
  font-family: 'DM Serif Display', Georgia, serif;
  font-size: 22px;
  font-weight: 500;
}

/* Tab Label / Title */
.atelier-col-tab__title {
  margin-top: 10px;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 12.5px;
  font-weight: 600;
  line-height: 1.35;
  color: var(--gt-espresso);
  letter-spacing: -0.01em;
  text-align: center;
  max-width: 100%;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  transition: color 0.2s ease, transform 0.2s ease;
  word-break: normal;
}

@media screen and (max-width: 767px) {
  .atelier-col-tab__title {
    font-size: 11.5px;
    margin-top: 8px;
    -webkit-line-clamp: 2;
  }
}

/* Hover State */
.atelier-col-tab:hover .atelier-col-tab__avatar {
  transform: translateY(-4px) scale(1.06);
  border-color: var(--gt-deep-coffee);
  box-shadow: 0 8px 20px rgba(77, 53, 29, 0.22);
}

.atelier-col-tab:hover .atelier-col-tab__img {
  transform: scale(1.08);
}

.atelier-col-tab:hover .atelier-col-tab__title {
  color: var(--gt-deep-coffee);
}

/* Focus Visible for Accessibility */
.atelier-col-tab:focus-visible .atelier-col-tab__avatar {
  outline: 2px solid var(--gt-deep-coffee);
  outline-offset: 4px;
}

/* Active State (Current Collection) */
.atelier-col-tab.is-active .atelier-col-tab__avatar {
  border-color: var(--gt-deep-coffee);
  border-width: 3px;
  box-shadow: 0 0 0 3px rgba(198, 181, 142, 0.65), 0 8px 18px rgba(77, 53, 29, 0.24);
  transform: translateY(-2px);
}

.atelier-col-tab.is-active .atelier-col-tab__title {
  color: var(--gt-deep-coffee);
  font-weight: 700;
}

/* Active Indicator Underline / Dot */
.atelier-col-tab__indicator {
  position: absolute;
  bottom: -6px;
  left: 50%;
  transform: translateX(-50%);
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background-color: var(--gt-deep-coffee);
  opacity: 0;
  transition: opacity 0.2s ease;
}

.atelier-col-tab.is-active .atelier-col-tab__indicator {
  opacity: 1;
}

/* Optional Navigation Scroll Arrow for desktop overflow */
.atelier-col-nav__scroll-hint {
  display: none;
}

{%- endstyle -%}

<section class="atelier-col-banner-section" data-section-id="{{ section.id }}">
  {%- comment -%} ==================== TOP BANNER HERO ==================== {%- endcomment -%}
  <div class="atelier-col-hero">
    {%- if hero_image != blank -%}
      <div class="atelier-col-hero__media">
        {{
          hero_image
          | image_url: width: 2400
          | image_tag:
            class: 'atelier-col-hero__img',
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '100vw',
            widths: '375, 550, 750, 1100, 1500, 1780, 2000, 2400',
            alt: hero_image.alt | default: collection.title | escape
        }}
      </div>
    {%- else -%}
      <div class="atelier-col-hero__media" style="background: linear-gradient(135deg, #363638 0%, #201813 100%);"></div>
    {%- endif -%}

    <div class="atelier-col-hero__overlay"></div>

    <div class="atelier-col-hero__inner atelier-col-hero__inner--{{ text_align }}">
      {%- if show_badge and badge_text != blank -%}
        <div class="atelier-col-hero__badge">
          <span class="atelier-col-hero__badge-dot"></span>
          <span>{{ badge_text | escape }}</span>
        </div>
      {%- endif -%}

      <h1 class="atelier-col-hero__title">
        {{ collection.title | escape }}
      </h1>

      {%- if section.settings.show_description and collection.description != blank -%}
        <div class="atelier-col-hero__description rte">
          {{ collection.description }}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} ==================== CIRCULAR SUB-COLLECTION TABS ==================== {%- endcomment -%}
  {%- if render_tabs -%}
    <nav class="atelier-col-nav" aria-label="Sub-collection filters">
      <div class="atelier-col-nav__inner">
        {%- if section.settings.nav_heading != blank -%}
          <div class="atelier-col-nav__header">
            <h2 class="atelier-col-nav__heading">{{ section.settings.nav_heading | escape }}</h2>
          </div>
        {%- endif -%}

        <ul class="atelier-col-tabs" role="list">
          {%- if has_meta_tabs -%}
            {%- comment -%} 1. Render Sub-collections from Metafields {%- endcomment -%}
            {%- for sub_col in meta_tabs -%}
              {%- liquid
                assign tab_url = sub_col.url
                assign is_active = false
                if sub_col.handle == collection.handle or sub_col.id == collection.id
                  assign is_active = true
                endif

                # Custom metafield title fallback to collection title
                assign tab_title = sub_col.metafields.custom.collection_tab_title.value | default: sub_col.metafields.custom.collection_tab_title | default: sub_col.title

                # Custom metafield image fallback to collection image or first product image
                assign tab_image = sub_col.metafields.custom.collection_tab_image.value | default: sub_col.metafields.custom.collection_tab_image
                if tab_image == blank
                  assign tab_image = sub_col.image | default: sub_col.products.first.featured_image
                endif
              -%}

              <li class="atelier-col-tabs__item">
                <a
                  href="{{ tab_url }}"
                  class="atelier-col-tab{% if is_active %} is-active{% endif %}"
                  {% if is_active %}aria-current="page"{% endif %}
                  title="{{ tab_title | escape }}"
                >
                  <div class="atelier-col-tab__avatar">
                    {%- if tab_image != blank -%}
                      {{
                        tab_image
                        | image_url: width: 240
                        | image_tag:
                          class: 'atelier-col-tab__img',
                          loading: 'lazy',
                          widths: '120, 180, 240',
                          alt: tab_title | escape
                      }}
                    {%- else -%}
                      <div class="atelier-col-tab__placeholder">
                        {{ tab_title | slice: 0, 1 | upcase }}
                      </div>
                    {%- endif -%}
                  </div>

                  <span class="atelier-col-tab__title">
                    {{ tab_title | escape }}
                  </span>

                  <span class="atelier-col-tab__indicator"></span>
                </a>
              </li>
            {%- endfor -%}

          {%- elsif has_block_tabs -%}
            {%- comment -%} 2. Render Sub-collections from Section Blocks (Fallback / Editor Curation) {%- endcomment -%}
            {%- for block in section.blocks -%}
              {%- liquid
                assign block_col = block.settings.collection
                assign tab_url = block.settings.custom_link | default: block_col.url | default: '#'
                assign is_active = false
                if block_col != blank and block_col.handle == collection.handle
                  assign is_active = true
                endif

                # Priority: Block custom title > Sub-collection metafield title > Collection title
                assign tab_title = block.settings.custom_title
                if tab_title == blank and block_col != blank
                  assign tab_title = block_col.metafields.custom.collection_tab_title.value | default: block_col.metafields.custom.collection_tab_title | default: block_col.title
                endif
                if tab_title == blank
                  assign tab_title = 'Collection ' | append: forloop.index
                endif

                # Priority: Block custom image > Sub-collection metafield image > Collection image > First product
                assign tab_image = block.settings.custom_image
                if tab_image == blank and block_col != blank
                  assign tab_image = block_col.metafields.custom.collection_tab_image.value | default: block_col.metafields.custom.collection_tab_image
                  if tab_image == blank
                    assign tab_image = block_col.image | default: block_col.products.first.featured_image
                  endif
                endif
              -%}

              <li class="atelier-col-tabs__item" {{ block.shopify_attributes }}>
                <a
                  href="{{ tab_url }}"
                  class="atelier-col-tab{% if is_active %} is-active{% endif %}"
                  {% if is_active %}aria-current="page"{% endif %}
                  title="{{ tab_title | escape }}"
                >
                  <div class="atelier-col-tab__avatar">
                    {%- if tab_image != blank -%}
                      {{
                        tab_image
                        | image_url: width: 240
                        | image_tag:
                          class: 'atelier-col-tab__img',
                          loading: 'lazy',
                          widths: '120, 180, 240',
                          alt: tab_title | escape
                      }}
                    {%- else -%}
                      <div class="atelier-col-tab__placeholder">
                        {{ tab_title | slice: 0, 1 | upcase }}
                      </div>
                    {%- endif -%}
                  </div>

                  <span class="atelier-col-tab__title">
                    {{ tab_title | escape }}
                  </span>

                  <span class="atelier-col-tab__indicator"></span>
                </a>
              </li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </div>
    </nav>
  {%- elsif request.design_mode and show_tabs -%}
    <div style="padding: 24px 20px; text-align: center; background: #F8F5ED; border-bottom: 1px dashed #C6B58E; font-family: 'Inter', -apple-system, sans-serif; color: #4D351D; font-size: 13px;">
      <strong>Circular Sub-Collection Tabs:</strong> Click <em>"+ Add"</em> next to <code>Collection Tabs</code> in Shopify Admin for this collection, or add <em>"Sub-Collection Tab"</em> blocks in the sidebar to preview tabs immediately.
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Atelier Collection Banner",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Editorial Banner Settings"
    },
    {
      "type": "image_picker",
      "id": "fallback_image",
      "label": "Banner Fallback Image",
      "info": "Used if the collection has no default media image uploaded."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Focal Position",
      "default": "center center",
      "options": [
        { "value": "top center", "label": "Top Center" },
        { "value": "center center", "label": "Center" },
        { "value": "bottom center", "label": "Bottom Center" }
      ]
    },
    {
      "type": "range",
      "id": "hero_height_desktop",
      "min": 240,
      "max": 540,
      "step": 20,
      "unit": "px",
      "label": "Desktop Banner Height",
      "default": 360
    },
    {
      "type": "range",
      "id": "hero_height_mobile",
      "min": 180,
      "max": 380,
      "step": 20,
      "unit": "px",
      "label": "Mobile Banner Height",
      "default": 260
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Dark Overlay Scrim Opacity",
      "default": 85
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "default": "center",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Left" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show Badge / Tagline",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "WEBSITE EXCLUSIVE"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show Collection Description",
      "default": true
    },
    {
      "type": "header",
      "content": "Circular Sub-Collection Tabs"
    },
    {
      "type": "checkbox",
      "id": "show_subcollections",
      "label": "Enable Sub-Collection Navigation",
      "info": "Populated dynamically via collection.metafields.custom.collection_tabs, or falls back to blocks below.",
      "default": true
    },
    {
      "type": "text",
      "id": "nav_heading",
      "label": "Sub-Collection Section Title (Optional)"
    },
    {
      "type": "range",
      "id": "avatar_size_desktop",
