{%- if template.name == 'product' -%}
{% style %}
  .mobile-dock-section, .atelier-mobile-dock { display: none !important; }
{% endstyle %}
{%- else -%}
{{ 'mobile-bottom-nav.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mobile-bottom-nav.js' | asset_url }}" defer></script>
{% style %}
@media (max-width: 1023px) {
  body { padding-bottom: calc({{ section.settings.height }}px + env(safe-area-inset-bottom, 0px)); }
  html { scroll-padding-bottom: calc({{ section.settings.height }}px + env(safe-area-inset-bottom, 0px) + 16px); }
}
{% endstyle %}
<mobile-bottom-nav class="atelier-mobile-dock" style="--dock-height:{{ section.settings.height }}px;--dock-background:{{ section.settings.background }};--dock-text:{{ section.settings.text }};--dock-active:{{ section.settings.active }};">
  <nav aria-label="{{ section.settings.navigation_label | default: 'Mobile navigation' | escape }}">
    <a href="{{ routes.root_url }}" class="atelier-mobile-dock__item"{% if request.page_type == 'index' %} aria-current="page"{% endif %}><span class="atelier-mobile-dock__icon">{% render 'mobile-nav-icon', name: 'home' %}</span><span>{{ section.settings.home_label | default: 'Home' | escape }}</span></a>
    <button type="button" class="atelier-mobile-dock__item" data-dock-panel="categories" aria-haspopup="dialog"><span class="atelier-mobile-dock__icon">{% render 'mobile-nav-icon', name: 'categories' %}</span><span>{{ section.settings.categories_label | default: 'Categories' | escape }}</span></button>
    <a href="{{ section.settings.account_link | default: routes.account_url }}" class="atelier-mobile-dock__item"{% if request.path contains '/account' %} aria-current="page"{% endif %}><span class="atelier-mobile-dock__icon">{% render 'mobile-nav-icon', name: 'account' %}</span><span>{{ section.settings.account_label | default: 'Account' | escape }}</span></a>
  </nav>
</mobile-bottom-nav>
{%- endif -%}
{% schema %}
{
  "name": "Mobile bottom navigation",
  "tag": "div",
  "class": "mobile-dock-section",
  "limit": 1,
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "navigation_label",
      "label": "Accessible navigation label",
      "default": "Mobile navigation"
    },
    {
      "type": "text",
      "id": "home_label",
      "label": "Home label",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "categories_label",
      "label": "Categories label",
      "default": "Categories"
    },
    {
      "type": "text",
      "id": "account_label",
      "label": "Account label",
      "default": "Account"
    },
    {
      "type": "url",
      "id": "account_link",
      "label": "Account destination",
      "info": "Leave blank to use Shopify customer accounts."
    },
    {
      "type": "range",
      "id": "height",
      "label": "Dock height",
      "min": 56,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text",
      "label": "Icons and labels",
      "default": "#363638"
    },
    {
      "type": "color",
      "id": "active",
      "label": "Active Home colour",
      "default": "#927B53"
    }
  ]
}
{% endschema %}
