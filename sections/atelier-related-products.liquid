{% liquid
  assign related_entries = section.settings.collection.products | default: collections.all.products
  assign related_count = 0
  for entry in related_entries limit: 24
    if entry.id != product.id
      assign related_count = related_count | plus: 1
    endif
  endfor
%}
{% if related_count > 0 %}
  {% style %}
    .atelier-related {
      display: block;
      background: var(--related-background, #F8F5ED);
      color: var(--related-text, #242424);
      padding: 0 24px var(--related-bottom, 44px);
      font-family: Inter, sans-serif;
    }
    .atelier-related__inner {
      max-width: var(--related-width, 1400px);
      margin: auto;
      padding: var(--related-top, 44px) 36px 0;
    }
    .atelier-related__inner--divider {
      border-top: 1px solid var(--related-border, #E6D9C1);
    }
    .atelier-related__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 28px;
    }
    .atelier-related__header h2 {
      margin: 0;
      font: 400 var(--related-heading, 34px)/1.2 'DM Serif Display', Georgia, serif;
      letter-spacing: -0.02em;
    }
    .atelier-related__header-right {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .atelier-related__view-all {
      font: 500 12px/1.6 Inter, sans-serif;
      letter-spacing: 0.04em;
      color: #4D351D;
      text-decoration: none;
      white-space: nowrap;
    }
    .atelier-related__view-all:hover {
      text-decoration: underline;
      text-underline-offset: 4px;
    }
    .atelier-related__arrows {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .atelier-related__arrow {
      width: 34px;
      height: 34px;
      display: grid;
      place-items: center;
      border: 1px solid var(--related-border, #E6D9C1);
      border-radius: 50%;
      background: #FFFFFF;
      color: #363638;
      cursor: pointer;
      padding: 0;
      transition: all 180ms ease;
    }
    .atelier-related__arrow:hover:not(:disabled) {
      background: #F8F5ED;
      border-color: #653f29;
      color: #653f29;
      transform: scale(1.05);
    }
    .atelier-related__arrow svg {
      width: 15px;
      height: 15px;
    }
    .atelier-related__arrow:disabled {
      opacity: 0.3;
      cursor: default;
      pointer-events: none;
    }
    .atelier-related__grid {
      display: flex;
      gap: var(--related-gap, 28px);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding: 4px 2px 14px;
      cursor: grab;
    }
    .atelier-related__grid.is-dragging {
      cursor: grabbing;
      scroll-snap-type: none;
      scroll-behavior: auto;
      user-select: none;
    }
    .atelier-related__grid::-webkit-scrollbar {
      display: none;
    }
    .atelier-related-card {
      box-sizing: border-box;
      min-width: 0;
      flex: 0 0 calc((100% - 3 * var(--related-gap, 28px)) / 4);
      display: flex;
      flex-direction: column;
      background: var(--related-card, #FAF7F2);
      border: 1px solid var(--related-border, #E6D9C1);
      border-radius: var(--related-radius, 18px);
      padding: 12px;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(77, 53, 29, 0.04);
      scroll-snap-align: start;
      transition: transform 220ms ease, box-shadow 220ms ease;
    }
    .atelier-related-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 24px rgba(77, 53, 29, 0.08);
    }
    .atelier-related-card__image {
      display: block;
      aspect-ratio: 1;
      overflow: hidden;
      border-radius: 12px;
      background: var(--related-background, #F8F5ED);
    }
    .atelier-related-card__image img,
    .atelier-related-card__image svg {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: var(--related-fit, cover);
      transition: transform 250ms cubic-bezier(0.2, 0.6, 0.3, 1);
    }
    .atelier-related-card:hover .atelier-related-card__image img {
      transform: scale(1.03);
    }
    .atelier-related-card__body {
      display: flex;
      flex: 1;
      flex-direction: column;
      padding: 12px 2px 2px;
    }
    .atelier-related-card__category {
      color: var(--related-accent, #8A6B40);
      font: 600 10px/1.3 Inter, sans-serif;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin: 0 0 6px;
    }
    .atelier-related-card h3 {
      font: 400 15.5px/1.35 'DM Serif Display', Georgia, serif;
      letter-spacing: -0.01em;
      margin: 0 0 12px;
      min-height: 2.7em;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .atelier-related-card h3 a {
      color: var(--related-text, #1A1614);
      text-decoration: none;
    }
    .atelier-related-card__footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-top: auto;
      padding-top: 4px;
    }
    .atelier-related-card__prices {
      display: flex;
      align-items: baseline;
      gap: 6px;
      font: 600 16px/1 Inter, sans-serif;
      color: var(--related-text, #1A1614);
      margin: 0;
    }
    .atelier-related-card__prices s {
      font-size: 11px;
      font-weight: 400;
      color: #8B8580;
      text-decoration: line-through;
    }
    .atelier-related-card__button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 32px;
      border: 0;
      border-radius: 999px;
      background: var(--related-button, #4D351D);
      color: #FFFFFF !important;
      text-decoration: none;
      font: 600 11.5px/1 Inter, sans-serif;
      padding: 7px 16px;
      margin: 0;
      white-space: nowrap;
      cursor: pointer;
      box-shadow: 0 2px 6px rgba(77, 53, 29, 0.15);
      transition: filter 180ms ease, transform 150ms ease;
    }
    .atelier-related-card__button:hover {
      filter: brightness(1.15);
      background: var(--related-button, #4D351D);
    }
    .atelier-related-card__button:active {
      transform: scale(0.97);
    }
    .atelier-related-card__button:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
    @media (min-width: 750px) and (max-width: 989px) {
      .atelier-related__inner {
        padding-left: 0;
        padding-right: 0;
      }
      .atelier-related-card {
        flex: 0 0 calc((100% - 2 * var(--related-gap, 28px)) / 2.5);
      }
    }
    @media (max-width: 749px) {
      .atelier-related {
        padding-left: 16px;
        padding-right: 16px;
      }
      .atelier-related__inner {
        padding-left: 0;
        padding-right: 0;
      }
      .atelier-related__header {
        gap: 12px;
        margin-bottom: 20px;
      }
      .atelier-related__header h2 {
        font-size: 26px;
      }
      .atelier-related__view-all {
        font-size: 11px;
      }
      .atelier-related__grid {
        margin: 0 -16px;
        padding: 0 16px 8px;
      }
      .atelier-related-card {
        flex: 0 0 76%;
        max-width: 290px;
      }
      .atelier-related-card__button {
        min-height: 44px;
      }
    }
  {% endstyle %}

  <atelier-related-carousel class="atelier-related" style="--related-width:{{ section.settings.width }}px;--related-gap:{{ section.settings.gap }}px;--related-radius:{{ section.settings.radius }}px;--related-heading:{{ section.settings.heading_size }}px;--related-top:{{ section.settings.padding_top }}px;--related-bottom:{{ section.settings.padding_bottom }}px;--related-background:{{ section.settings.background }};--related-card:{{ section.settings.card_background }};--related-text:{{ section.settings.text }};--related-accent:{{ section.settings.accent }};--related-border:{{ section.settings.border }};--related-button:{{ section.settings.button_background }};--related-fit:{{ section.settings.image_fit }}">
    <div class="atelier-related__inner{% if section.settings.show_divider %} atelier-related__inner--divider{% endif %}">
      <header class="atelier-related__header">
        <h2>{{ section.settings.heading | escape }}</h2>
        <div class="atelier-related__header-right">
          {% if section.settings.link_label != blank %}
            <a class="atelier-related__view-all" href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}">{{ section.settings.link_label | escape }}</a>
          {% endif %}
          <div class="atelier-related__arrows" data-related-arrows>
            <button type="button" class="atelier-related__arrow" data-related-direction="-1" aria-label="Previous products" disabled>
              {% render 'reel-icon', name: 'previous' %}
            </button>
            <button type="button" class="atelier-related__arrow" data-related-direction="1" aria-label="Next products">
              {% render 'reel-icon', name: 'next' %}
            </button>
          </div>
        </div>
      </header>
      <div class="atelier-related__grid" data-related-track>
        {% assign displayed = 0 %}
        {% for related_product in related_entries limit: 24 %}
          {% unless related_product.id == product.id %}
            {% assign variant = related_product.selected_or_first_available_variant %}
            <article class="atelier-related-card">
              <a class="atelier-related-card__image" href="{{ related_product.url }}" aria-label="{{ related_product.title | escape }}">
                {% if related_product.featured_image %}
                  {{ related_product.featured_image | image_url: width: 720 | image_tag: widths: '240,360,540,720', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 40vw, 75vw', loading: 'lazy' }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag }}
                {% endif %}
              </a>
              <div class="atelier-related-card__body">
                {% if section.settings.show_category and related_product.type != blank %}
                  <p class="atelier-related-card__category">{{ related_product.type | escape }}</p>
                {% endif %}
                <h3><a href="{{ related_product.url }}">{{ related_product.title | escape }}</a></h3>
                <div class="atelier-related-card__footer">
                  <div class="atelier-related-card__prices">
                    <span>
                      {% if section.settings.store_money_format %}
                        {{ variant.price | money_without_trailing_zeros }}
                      {% else %}
                        {{ section.settings.currency_symbol | escape }}{{ variant.price | money_without_currency | remove: '.00' }}
                      {% endif %}
                    </span>
                    {% if section.settings.show_compare and variant.compare_at_price > variant.price %}
                      <s>
                        {% if section.settings.store_money_format %}
                          {{ variant.compare_at_price | money_without_trailing_zeros }}
                        {% else %}
                          {{ section.settings.currency_symbol | escape }}{{ variant.compare_at_price | money_without_currency | remove: '.00' }}
                        {% endif %}
                      </s>
                    {% endif %}
                  </div>
                  {% if related_product.available == false %}
                    <button class="atelier-related-card__button" type="button" disabled>{{ 'products.product.sold_out' | t | default: 'Sold out' }}</button>
                  {% elsif related_product.has_only_default_variant and related_product.requires_selling_plan == false %}
                    <button class="atelier-related-card__button" type="button" data-quick-add="{{ variant.id }}">{{ section.settings.button_label | default: 'Add to Cart' | escape }}</button>
                  {% else %}
                    <a class="atelier-related-card__button" href="{{ related_product.url }}">{{ section.settings.button_label | default: 'Add to Cart' | escape }}</a>
                  {% endif %}
                </div>
              </div>
            </article>
            {% assign displayed = displayed | plus: 1 %}
            {% if displayed >= section.settings.limit %}{% break %}{% endif %}
          {% endunless %}
        {% endfor %}
      </div>
    </div>
  </atelier-related-carousel>

  <script>
    if (!customElements.get('atelier-related-carousel')) {
      customElements.define('atelier-related-carousel', class extends HTMLElement {
        connectedCallback() {
          this.track = this.querySelector('[data-related-track]');
          if (!this.track) return;
          this.prevBtn = this.querySelector('[data-related-direction="-1"]');
          this.nextBtn = this.querySelector('[data-related-direction="1"]');

          const update = () => {
            const max = Math.max(0, this.track.scrollWidth - this.track.clientWidth);
            if (max <= 5) {
              if (this.prevBtn) this.prevBtn.style.visibility = 'hidden';
              if (this.nextBtn) this.nextBtn.style.visibility = 'hidden';
              return;
            }
            if (this.prevBtn) {
              this.prevBtn.style.visibility = 'visible';
              this.prevBtn.disabled = this.track.scrollLeft <= 4;
            }
            if (this.nextBtn) {
              this.nextBtn.style.visibility = 'visible';
              this.nextBtn.disabled = this.track.scrollLeft >= max - 4;
            }
          };

          this.addEventListener('click', async (e) => {
            const addBtn = e.target.closest('[data-quick-add]');
            if (addBtn && !addBtn.disabled) {
              e.preventDefault();
              const id = addBtn.dataset.quickAdd;
              addBtn.disabled = true;
              const originalText = addBtn.textContent;
              addBtn.textContent = '...';
              try {
                const drawer = document.querySelector('cart-drawer');
                const sections = drawer?.getSectionsToRender?.().map(s => s.id) || ['cart-drawer', 'cart-icon-bubble'];
                const res = await fetch((window.Shopify?.routes?.root || '/') + 'cart/add.js', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                  body: JSON.stringify({ items: [{ id: Number(id), quantity: 1 }], sections, sections_url: window.location.pathname })
                });
                const data = await res.json();
                if (drawer && data.sections) {
                  drawer.replaceContents?.(data);
                  drawer.open?.();
                }
                document.dispatchEvent(new CustomEvent('atelier:cart:update', { detail: data }));
              } catch (err) {
                console.error(err);
              } finally {
                addBtn.disabled = false;
                addBtn.textContent = originalText;
              }
              return;
            }
            const btn = e.target.closest('[data-related-direction]');
            if (!btn) return;
            const dir = Number(btn.dataset.relatedDirection);
            const first = this.track.querySelector('.atelier-related-card');
            const w = first ? first.getBoundingClientRect().width + 28 : 280;
            this.track.scrollBy({ left: dir * w, behavior: 'smooth' });
          });

          let down = false, sx = 0, sl = 0;
          this.track.addEventListener('mousedown', (e) => {
            if (e.target.closest('a, button')) return;
            down = true;
            sx = e.pageX - this.track.offsetLeft;
            sl = this.track.scrollLeft;
          });
          window.addEventListener('mousemove', (e) => {
            if (!down) return;
            const x = e.pageX - this.track.offsetLeft;
            const walk = (x - sx);
            if (Math.abs(walk) > 4) {
              this.track.classList.add('is-dragging');
              e.preventDefault();
              this.track.scrollLeft = sl - walk;
            }
          });
          window.addEventListener('mouseup', () => {
            down = false;
            this.track.classList.remove('is-dragging');
          });

          this.track.addEventListener('scroll', update, { passive: true });
          new ResizeObserver(update).observe(this.track);
          setTimeout(update, 100);
          update();
        }
      });
    }
  </script>
{% else %}
  {% style %}#shopify-section-{{ section.id }}{display:none}{% endstyle %}
{% endif %}

{% schema %}
{
  "name": "You may also like",
  "tag": "section",
  "class": "atelier-related-section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Products and text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You May Also Like"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Product collection",
      "info": "Products follow this collection’s sort order. The catalogue link automatically opens this collection."
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Maximum products",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Catalogue link text",
      "default": "View All"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Card button text",
      "default": "Add to Cart"
    },
    {
      "type": "checkbox",
      "id": "show_category",
      "label": "Show product type above title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_compare",
      "label": "Show original price",
      "default": true
    },
    {
      "type": "text",
      "id": "currency_symbol",
      "label": "Compact price currency symbol",
      "default": "₹"
    },
    {
      "type": "checkbox",
      "id": "store_money_format",
      "label": "Use store currency formatting",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "width",
      "label": "Content width",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Desktop card spacing",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 24,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show top divider",
      "default": true
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Square image fit",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Fill square"
        },
        {
          "value": "contain",
          "label": "Show full image"
        }
      ]
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Section background",
      "default": "#F8F5ED"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text",
      "label": "Text",
      "default": "#242424"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Category label",
      "default": "#8A6B40"
    },
    {
      "type": "color",
      "id": "border",
      "label": "Card and button border",
      "default": "#E6D9C1"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#F8F5ED"
    }
  ],
  "presets": [
    {
      "name": "You may also like"
    }
  ]
}
{% endschema %}
