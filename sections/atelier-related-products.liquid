{% liquid
 assign related_entries = section.settings.products | default: section.settings.collection.products
 assign related_count = 0
 for entry in related_entries limit:12
  if entry.id != product.id
   assign related_count = related_count | plus:1
  endif
 endfor
%}
{% if related_count > 0 %}
{{ 'product-recommendations.css' | asset_url | stylesheet_tag }}
<div class="atelier-related" style="--related-width:{{ section.settings.width }}px;--related-gap:{{ section.settings.gap }}px;--related-radius:{{ section.settings.radius }}px;--related-heading:{{ section.settings.heading_size }}px;--related-top:{{ section.settings.padding_top }}px;--related-bottom:{{ section.settings.padding_bottom }}px;--related-background:{{ section.settings.background }};--related-card:{{ section.settings.card_background }};--related-text:{{ section.settings.text }};--related-accent:{{ section.settings.accent }};--related-border:{{ section.settings.border }};--related-button:{{ section.settings.button_background }};--related-fit:{{ section.settings.image_fit }}">
 <div class="atelier-related__inner{% if section.settings.show_divider %} atelier-related__inner--divider{% endif %}">
  <header class="atelier-related__header"><h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.link_label != blank %}<a href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.link_label | escape }}</a>{% endif %}</header>
  <div class="atelier-related__grid">
   {% assign displayed = 0 %}
   {% for related_product in section.settings.collection.products limit: 12 %}
    {% unless related_product.id == product.id %}
     {% assign variant = related_product.selected_or_first_available_variant %}
     <article class="atelier-related-card">
      <a class="atelier-related-card__image" href="{{ related_product.url }}" aria-label="{{ related_product.title | escape }}">{% if related_product.featured_image %}{{ related_product.featured_image | image_url: width: 900 | image_tag: widths: '240,360,540,720,900', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 45vw, 80vw', loading: 'lazy' }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}</a>
      <div class="atelier-related-card__body">
       {% if section.settings.show_category and related_product.type != blank %}<p class="atelier-related-card__category">{{ related_product.type | escape }}</p>{% endif %}
       <h3><a href="{{ related_product.url }}">{{ related_product.title | escape }}</a></h3>
       <div class="atelier-related-card__prices"><span>{% if section.settings.store_money_format %}{{ variant.price | money_without_trailing_zeros }}{% else %}{{ section.settings.currency_symbol | escape }}{{ variant.price | money_without_currency | remove: '.00' }}{% endif %}</span>{% if section.settings.show_compare and variant.compare_at_price > variant.price %}<s>{% if section.settings.store_money_format %}{{ variant.compare_at_price | money_without_trailing_zeros }}{% else %}{{ section.settings.currency_symbol | escape }}{{ variant.compare_at_price | money_without_currency | remove: '.00' }}{% endif %}</s>{% endif %}</div>
       <a class="atelier-related-card__button" href="{{ related_product.url }}">{{ section.settings.button_label | escape }}</a>
      </div>
     </article>
     {% assign displayed = displayed | plus: 1 %}{% if displayed >= section.settings.limit %}{% break %}{% endif %}
    {% endunless %}
   {% endfor %}
  </div>
  
 </div>
</div>

{% else %}{% style %}#shopify-section-{{ section.id }}{display:none}{% endstyle %}{% endif %}
{% schema %}
{
  "name": "You may also like",
  "tag": "section",
  "class": "atelier-related-section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Products and text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You May Also Like"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Product collection",
      "info": "Products follow this collection’s sort order. The current product is excluded."
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Maximum products",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Catalogue link text",
      "default": "EXPLORE FULL CATALOG →"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Catalogue link"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Card button text",
      "default": "View Details"
    },
    {
      "type": "checkbox",
      "id": "show_category",
      "label": "Show product type above title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_compare",
      "label": "Show original price",
      "default": true
    },
    {
      "type": "text",
      "id": "currency_symbol",
      "label": "Compact price currency symbol",
      "default": "₹"
    },
    {
      "type": "checkbox",
      "id": "store_money_format",
      "label": "Use store currency formatting",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "width",
      "label": "Content width",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Desktop card spacing",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 24,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show top divider",
      "default": true
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Square image fit",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Fill square"
        },
        {
          "value": "contain",
          "label": "Show full image"
        }
      ]
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Section background",
      "default": "#F8F5ED"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text",
      "label": "Text",
      "default": "#242424"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Category label",
      "default": "#8A6B40"
    },
    {
      "type": "color",
      "id": "border",
      "label": "Card and button border",
      "default": "#E6D9C1"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#F8F5ED"
    }
  ],
  "presets": [
    {
      "name": "You may also like"
    }
  ]
}
{% endschema %}