{% assign metafield_faqs = product.metafields.graffeine_product.faqs.value %}
{% liquid
  assign meta_faq_count = 0
  for entry in metafield_faqs
    if entry.heading.value != blank and entry.content.value != blank
      assign meta_faq_count = meta_faq_count | plus: 1
    endif
  endfor

  assign block_faq_count = 0
  for block in section.blocks
    if block.settings.question != blank
      assign block_faq_count = block_faq_count | plus: 1
    endif
  endfor
%}

{{ 'journal-faqs.css' | asset_url | stylesheet_tag }}

<journal-faqs class="journal-faqs" style="--faq-background:{{ section.settings.background }};--faq-panel:{{ section.settings.panel_background }};--faq-text:{{ section.settings.text }};--faq-width:{{ section.settings.width }}px">
  <div>
    <h2>{{ section.settings.heading | default: 'Frequently Asked Questions' | escape }}</h2>

    {% if meta_faq_count > 0 %}
      {% for faq in metafield_faqs %}
        {% if faq.heading.value != blank and faq.content.value != blank %}
          <details{% if faq.open.value %} open{% endif %}>
            <summary>{{ faq.heading.value | escape }}<span aria-hidden="true">+</span></summary>
            <div class="journal-faqs__answer">{{ faq.content | metafield_tag }}</div>
          </details>
        {% endif %}
      {% endfor %}
    {% elsif block_faq_count > 0 %}
      {% for block in section.blocks %}
        {% if block.settings.question != blank %}
          <details{% if block.settings.open %} open{% endif %} {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question | escape }}<span aria-hidden="true">+</span></summary>
            <div class="journal-faqs__answer">
              {% if block.settings.answer != blank %}
                {{ block.settings.answer }}
              {% else %}
                <p>Designed with intention. Made with heart in our atelier studio.</p>
              {% endif %}
            </div>
          </details>
        {% endif %}
      {% endfor %}
    {% else %}
      <details open>
        <summary>What makes Graffeine Tales products unique?<span aria-hidden="true">+</span></summary>
        <div class="journal-faqs__answer">
          <p>Each piece is slow-crafted with intention in our Indian studio — from archival 120–350 GSM textured papers and vegan leather book bindings to die-cut weatherproof vinyl stickers and solid teakwood desk accessories.</p>
        </div>
      </details>

      <details>
        <summary>How long does shipping &amp; delivery take?<span aria-hidden="true">+</span></summary>
        <div class="journal-faqs__answer">
          <p>Orders are dispatched within 2–3 business days. Delivery across major Indian cities typically takes 4–7 business days with end-to-end tracking provided via email and WhatsApp.</p>
        </div>
      </details>

      <details>
        <summary>Are the stickers waterproof &amp; scratch-resistant?<span aria-hidden="true">+</span></summary>
        <div class="journal-faqs__answer">
          <p>Yes! All our stickers are precision die-cut on premium matte vinyl with UV-resistant inks. They are 100% waterproof, scratch-proof, and safe for laptops, water bottles, and journals.</p>
        </div>
      </details>

      <details>
        <summary>What is your return &amp; exchange policy?<span aria-hidden="true">+</span></summary>
        <div class="journal-faqs__answer">
          <p>We take immense pride in our craftsmanship. If your item arrives damaged or defective, please contact our support team within 48 hours for an instant replacement or full refund.</p>
        </div>
      </details>
    {% endif %}
  </div>
</journal-faqs>

{% schema %}
{
  "name": "Product FAQs",
  "tag": "section",
  "class": "product-faq-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Questions and answers can be set via Section Blocks below, or overridden per-product via Products → Metafields → Product page · FAQs."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Section background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "panel_background",
      "label": "Question background",
      "default": "#FAF8F2"
    },
    {
      "type": "color",
      "id": "text",
      "label": "Text",
      "default": "#363638"
    },
    {
      "type": "range",
      "id": "width",
      "label": "Content width",
      "min": 640,
      "max": 1040,
      "step": 20,
      "default": 900,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How long does shipping take?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Orders are dispatched within 2-3 business days with express tracking across India.</p>"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product FAQs",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "What makes Graffeine Tales products unique?",
            "answer": "<p>Each piece is slow-crafted with intention in our Indian studio — from archival 120–350 GSM papers and vegan leather book bindings to die-cut weatherproof vinyl stickers.</p>",
            "open": true
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How long does shipping & delivery take?",
            "answer": "<p>Orders are dispatched within 2–3 business days with end-to-end tracking provided via email and WhatsApp.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Are the stickers waterproof & scratch-resistant?",
            "answer": "<p>Yes! All our stickers are precision die-cut on premium matte vinyl with UV-resistant inks. They are 100% waterproof, scratch-proof, and safe for laptops.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "What is your return & exchange policy?",
            "answer": "<p>We take immense pride in our craftsmanship. If your item arrives damaged or defective, please contact our support team within 48 hours for an instant replacement.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
