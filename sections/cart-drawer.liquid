{{ 'atelier-cart-drawer.css' | asset_url | stylesheet_tag }}
{% liquid
 assign reward_count = 0
 assign coupon_count = 0
 assign shipping_threshold = 0
 assign mrp_total = 0
 for entry in section.blocks
  if entry.type == 'milestone' and entry.settings.title != blank and entry.settings.threshold > 0
   assign reward_count = reward_count | plus: 1
   if entry.settings.kind == 'shipping'
    assign shipping_threshold = entry.settings.threshold | times:100
   endif
  elsif entry.type == 'coupon' and entry.settings.code != blank and entry.settings.title != blank
   assign coupon_count = coupon_count | plus:1
  endif
 endfor
 for item in cart.items
  assign mrp_unit = item.variant.compare_at_price | default:item.original_price | at_least:item.original_price
  assign item_mrp = mrp_unit | times:item.quantity
  assign mrp_total = mrp_total | plus:item_mrp
 endfor
 assign product_savings = mrp_total | minus:cart.original_total_price | at_least:0
 assign addon = section.settings.addon_product
 assign addon_variant = addon.selected_or_first_available_variant
 assign addon_selected = false
 for item in cart.items
  if item.variant_id == addon_variant.id and item.properties._atelier_addon == 'true'
   assign addon_selected = true
  endif
 endfor
%}
<cart-drawer class="atelier-cart{% if cart.item_count == 0 %} is-empty{% endif %}" data-section-id="{{ section.id }}" style="--cart-width:{{ section.settings.width }}px;--cart-primary:{{ section.settings.primary }};--cart-accent:{{ section.settings.accent }};--cart-success:{{ section.settings.success }};--cart-canvas:{{ section.settings.canvas }};--cart-surface:{{ section.settings.surface }};--cart-border:{{ section.settings.border }};--cart-text:{{ section.settings.text }};--cart-muted:{{ section.settings.muted }}">
 <div id="CartDrawer-Overlay" class="atelier-cart__overlay" data-cart-close></div>
 <div id="CartDrawer" class="app-viewport atelier-cart__panel" role="dialog" aria-modal="true" aria-labelledby="SideCartTitle" tabindex="-1">
  <canvas class="atelier-cart-confetti-canvas" data-cart-confetti aria-hidden="true"></canvas>
  <div class="atelier-cart__shell" data-cart-shell>
   <header class="atelier-cart-header"><div style="display:inline-flex;align-items:center;gap:10px;"><h2 class="header-cart-title" id="SideCartTitle">{{ section.settings.title | escape }}</h2>{% if cart.item_count > 0 %}<span class="header-cart-count-badge">{{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}</span>{% endif %}</div><button type="button" class="btn-header-close" data-cart-close aria-label="{{ section.settings.close_label | escape }}">{% render 'cart-icon',name:'close' %}</button></header>
   <p class="atelier-cart__notice" data-cart-error role="alert" hidden></p>
   <main class="cart-scroll-content" data-cart-scroll>
    {% if cart.item_count > 0 %}
     {% if section.settings.show_milestones and reward_count > 0 %}
      <section class="reference-milestone-card" aria-label="{{ section.settings.rewards_label | escape }}">
       <div class="milestone-track-section"><div class="milestone-track-line" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="{{ section.settings.rewards_label | escape }}" data-reward-progress><div class="milestone-track-progress" data-reward-fill></div></div><div class="milestone-nodes-row" data-reward-nodes>
        {% for block in section.blocks %}{% if block.type == 'milestone' and block.settings.title != blank and block.settings.threshold > 0 %}<div class="m-node-col" data-reward-node data-threshold="{{ block.settings.threshold | times:100 }}" data-reward-title="{{ block.settings.title | escape }}" data-reward-kind="{{ block.settings.kind }}" {{ block.shopify_attributes }}><div class="m-threshold">{{ section.settings.currency_symbol | escape }}{{ block.settings.threshold }}</div><div class="m-dot-circle"><span data-reward-locked>{% render 'cart-icon',name:'lock' %}</span><span data-reward-unlocked hidden>{% render 'cart-icon',name:'check' %}</span></div><div class="m-title">{{ block.settings.title | escape }}</div></div>{% endif %}{% endfor %}
       </div><div class="milestone-caret-down" data-reward-caret></div></div>
       <div class="milestone-active-banner"><div class="banner-gift-icon">{% render 'cart-icon',name:'gift' %}</div><div class="banner-text-col"><div class="banner-headline" data-reward-headline></div><div class="banner-timer" data-reward-timer hidden></div>{% if section.settings.milestone_note != blank %}<div class="atelier-cart__reward-note">{{ section.settings.milestone_note | escape }}</div>{% endif %}</div></div>
      </section>
     {% endif %}
     <section class="cart-items-section" aria-label="{{ section.settings.cart_label | escape }}"><div class="cart-items-container">
      {% for item in cart.items %}
       {% liquid
        assign line_mrp_unit = item.variant.compare_at_price | default:item.original_price | at_least:item.original_price
        assign line_mrp = line_mrp_unit | times:item.quantity
        assign discount_percent = 0
        if line_mrp > 0
         assign discount_percent = line_mrp | minus:item.final_line_price | times:100.0 | divided_by:line_mrp | round
        endif
        assign quantity_step = item.variant.quantity_rule.increment | default:1
        assign quantity_min = item.variant.quantity_rule.min | default:1
        assign previous_quantity = item.quantity | minus:quantity_step
        if previous_quantity < quantity_min
         assign previous_quantity = 0
        endif
       %}
       <article class="cart-item-card" data-cart-line="{{ item.key | escape }}" data-line-index="{{ forloop.index }}">
        {% if item.image %}<a class="item-thumb-tile" href="{{ item.url }}">{{ item.image | image_url:width:240 | image_tag:widths:'120,180,240',sizes:'80px',loading:'lazy',alt:item.product.title }}</a>{% endif %}
        <div class="item-info-col"><div class="item-title-row"><h3 class="item-name"><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h3></div>
         {% if item.selling_plan_allocation %}<p class="atelier-cart__item-meta">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{% endif %}
         {% for property in item.properties %}{% assign property_initial = property.first | slice:0 %}{% if property.last != blank and property_initial != '_' %}<p class="atelier-cart__item-meta">{{ property.first | escape }}: {{ property.last | escape }}</p>{% endif %}{% endfor %}
         <div class="item-price-row"><span class="item-price-current">{{ section.settings.currency_symbol | escape }}{{ item.final_line_price | money_without_currency | remove:'.00' }}</span>{% if line_mrp > item.final_line_price %}<s class="item-price-mrp">{{ section.settings.currency_symbol | escape }}{{ line_mrp | money_without_currency | remove:'.00' }}</s><span class="item-discount-tag">{{ discount_percent }}{{ section.settings.discount_suffix | escape }}</span>{% endif %}</div>
         
         <div class="item-controls-row">
          {% unless item.product.has_only_default_variant %}<div class="item-variant-select"><select data-cart-variant data-line-key="{{ item.key | escape }}" data-line-index="{{ forloop.index }}" aria-label="{{ section.settings.variant_label | escape }}: {{ item.product.title | escape }}">{% for variant in item.product.variants %}<option value="{{ variant.id }}"{% if variant.id == item.variant_id %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title | escape }}{% unless variant.available %} — {{ section.settings.sold_label | escape }}{% endunless %}</option>{% endfor %}</select>{% render 'cart-icon',name:'down' %}</div>{% endunless %}
          <div class="item-stepper"><button type="button" class="stepper-btn{% if previous_quantity == 0 %} trash-btn{% endif %}" data-cart-quantity="{{ previous_quantity }}" data-line-key="{{ item.key | escape }}" data-line-index="{{ forloop.index }}" aria-label="{% if previous_quantity == 0 %}{{ section.settings.remove_label | escape }}{% else %}{{ section.settings.decrease_label | escape }}{% endif %}: {{ item.product.title | escape }}">{% if previous_quantity == 0 %}{% render 'cart-icon',name:'trash' %}{% else %}{% render 'cart-icon',name:'minus' %}{% endif %}</button><input class="stepper-qty" data-cart-quantity-input data-line-key="{{ item.key | escape }}" data-line-index="{{ forloop.index }}" type="number" value="{{ item.quantity }}" min="{{ item.variant.quantity_rule.min | default:1 }}" step="{{ item.variant.quantity_rule.increment | default:1 }}"{% if item.variant.quantity_rule.max %} max="{{ item.variant.quantity_rule.max }}"{% endif %} aria-label="{{ section.settings.quantity_label | escape }}: {{ item.product.title | escape }}"><button type="button" class="stepper-btn" data-cart-quantity="{{ item.quantity | plus:quantity_step }}" data-line-key="{{ item.key | escape }}" data-line-index="{{ forloop.index }}" aria-label="{{ section.settings.increase_label | escape }}: {{ item.product.title | escape }}">{% render 'cart-icon',name:'plus' %}</button></div>
         </div>
        </div>
       </article>
      {% endfor %}
      </div>
      {% if addon != blank and addon_variant.available and addon.has_only_default_variant and addon.requires_selling_plan == false %}<div class="sheet-mask-addon-bump{% if addon_selected %} is-added{% endif %}"><label class="addon-checkbox-label"><input type="checkbox" class="addon-checkbox" data-cart-addon data-variant="{{ addon_variant.id }}"{% if addon_selected %} checked{% endif %}><span class="custom-checkbox-box">{% render 'cart-icon',name:'check' %}</span><span class="addon-copy-wrap"><span class="addon-copy-text" data-addon-copy data-product-title="{{ addon.title | escape }}" data-addon-price="{{ addon_variant.price }}"></span></span>{% if addon.featured_image %}{{ addon.featured_image | image_url:width:100 | image_tag:class:'addon-mini-thumb',loading:'lazy',alt:'' }}{% endif %}</label></div>{% endif %}
      {% if section.settings.show_note %}<details class="atelier-cart__note"><summary>{{ section.settings.note_label | escape }}</summary><textarea data-cart-note aria-label="{{ section.settings.note_label | escape }}" placeholder="{{ section.settings.note_placeholder | escape }}">{{ cart.note | escape }}</textarea><button type="button" class="btn-apply-coupon" data-cart-note-save>{{ section.settings.save_note | escape }}</button></details>{% endif %}
     </section>
     {% if section.settings.show_coupons %}
      <section class="coupon-section" aria-label="{{ section.settings.coupons_label | escape }}"><form class="coupon-input-row" data-cart-coupon-form><input type="text" class="coupon-input" name="discount" placeholder="{{ section.settings.coupon_placeholder | escape }}" autocomplete="off" autocapitalize="characters" aria-label="{{ section.settings.coupon_placeholder | escape }}"><button type="submit" class="btn-apply-coupon">{{ section.settings.apply_label | escape }}</button></form><div class="coupon-applied-feedback" data-coupon-feedback hidden><span></span><button type="button" data-coupon-remove>{{ section.settings.remove_label | escape }}</button></div>
       {% if coupon_count > 0 %}<div class="coupon-cards-scroll" data-coupon-carousel>{% for block in section.blocks %}{% if block.type == 'coupon' and block.settings.code != blank and block.settings.title != blank %}<div class="coupon-card" data-coupon-card data-code="{{ block.settings.code | escape }}" data-minimum="{{ block.settings.minimum | times:100 }}" data-priority="{{ block.settings.priority }}" {{ block.shopify_attributes }}><div class="coupon-card-left"><span class="coupon-percent-icon">%</span><div class="coupon-details"><div class="coupon-heading">{{ block.settings.title | escape }} • <span class="coupon-dashed-pill">{{ block.settings.code | escape }}</span></div>{% if block.settings.condition != blank %}<div class="coupon-condition">{{ block.settings.condition | escape }}</div>{% endif %}</div></div><button type="button" class="btn-coupon-card-apply" data-cart-coupon="{{ block.settings.code | escape }}">{{ section.settings.apply_label | escape }}</button></div>{% endif %}{% endfor %}</div>{% endif %}
       {% if coupon_count > 0 or reward_count > 0 %}<button type="button" class="view-offers-toggle" data-cart-sheet-open="offers"><span>{{ section.settings.all_offers_label | escape }}</span>{% render 'cart-icon',name:'next' %}</button>{% endif %}
      </section>
     {% endif %}
     {% if section.settings.recommendation_collection.products_count > 0 %}
      <div class="section-divider"></div><section class="you-may-also-like-section"><div class="cross-sell-header-row"><h2 class="section-title-bold">{{ section.settings.recommendations_title | escape }}</h2><div class="carousel-nav-arrows"><button type="button" class="carousel-arrow-btn" data-cross-sell="-1" aria-label="{{ section.settings.previous_label | escape }}">{% render 'cart-icon',name:'previous' %}</button><button type="button" class="carousel-arrow-btn" data-cross-sell="1" aria-label="{{ section.settings.next_label | escape }}">{% render 'cart-icon',name:'next' %}</button></div></div><div class="recommended-products-scroll" data-cross-sell-track tabindex="0" aria-label="{{ section.settings.recommendations_title | escape }}">
       {% for recommendation in section.settings.recommendation_collection.products limit:section.settings.recommendation_limit %}{% assign recommendation_variant = recommendation.selected_or_first_available_variant %}<article class="rec-card"><a href="{{ recommendation.url }}" class="rec-img-wrap">{% if recommendation.featured_image %}{{ recommendation.featured_image | image_url:width:360 | image_tag:loading:'lazy',widths:'180,360',sizes:'144px',alt:recommendation.title }}{% endif %}</a><a class="rec-title" href="{{ recommendation.url }}">{{ recommendation.title | escape }}</a><div class="rec-price-row">{% if recommendation_variant.compare_at_price > recommendation_variant.price %}<s class="rec-mrp">{{ section.settings.currency_symbol | escape }}{{ recommendation_variant.compare_at_price | money_without_currency | remove:'.00' }}</s>{% endif %}<span class="rec-price">{{ section.settings.currency_symbol | escape }}{{ recommendation_variant.price | money_without_currency | remove:'.00' }}</span></div>{% if recommendation.available == false %}<button type="button" class="btn-rec-add" disabled>{{ section.settings.sold_label | escape }}</button>{% elsif recommendation.requires_selling_plan %}<a class="btn-rec-add" href="{{ recommendation.url }}">{{ section.settings.choose_label | escape }}</a>{% elsif recommendation.has_only_default_variant %}<button type="button" class="btn-rec-add" data-cart-add="{{ recommendation_variant.id }}">{{ section.settings.add_label | escape }}</button>{% else %}<button type="button" class="btn-rec-add" data-cart-choose="{{ recommendation.handle | escape }}">{{ section.settings.add_label | escape }}</button>{% endif %}</article>{% endfor %}
      </div></section>
     {% endif %}
     <div class="section-divider"></div><section class="price-summary-section" data-cart-summary><h2 class="section-title-bold">{{ section.settings.summary_title | escape }}</h2><div class="summary-row"><span>{{ section.settings.mrp_label | escape }}</span><span>{{ section.settings.currency_symbol | escape }}{{ mrp_total | money_without_currency | remove:'.00' }}</span></div>{% if product_savings > 0 %}<div class="summary-row savings"><span>{{ section.settings.savings_label | escape }}</span><span>−{{ section.settings.currency_symbol | escape }}{{ product_savings | money_without_currency | remove:'.00' }}</span></div>{% endif %}{% if cart.total_discount > 0 %}<div class="summary-row savings"><span>{{ section.settings.discount_label | escape }}</span><span>−{{ section.settings.currency_symbol | escape }}{{ cart.total_discount | money_without_currency | remove:'.00' }}</span></div>{% endif %}{% if cart.requires_shipping %}<div class="summary-row"><span>{{ section.settings.shipping_label | escape }}</span><span>{% if shipping_threshold > 0 and cart.total_price >= shipping_threshold %}{{ section.settings.free_label | escape }}{% else %}{{ section.settings.shipping_pending | escape }}{% endif %}</span></div>{% endif %}<div class="summary-dotted-line"></div><div class="summary-row grand-total-row"><span>{{ section.settings.total_label | escape }}</span><span>{{ section.settings.currency_symbol | escape }}{{ cart.total_price | money_without_currency | remove:'.00' }}</span></div><div class="summary-subtext">{% if cart.taxes_included %}{{ section.settings.tax_included | escape }}{% else %}{{ section.settings.tax_pending | escape }}{% endif %}</div><div class="payment-trust-row">{% if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 %}<div class="payment-logos-list">{% for payment_type in shop.enabled_payment_types %}<span class="pay-logo-badge">{{ payment_type | payment_type_svg_tag }}</span>{% endfor %}</div>{% endif %}<div class="secured-shield">{% render 'cart-icon',name:'shield' %}<span>{{ section.settings.secure_label | escape }}</span></div></div></section>
     {% if section.settings.prepaid_heading != blank and section.settings.prepaid_details != blank %}<section class="prepaid-rewards-banner"><div class="prepaid-left"><span class="prepaid-icon">{% render 'cart-icon',name:'tag' %}</span><span class="prepaid-text">{{ section.settings.prepaid_heading | escape }}</span></div><button type="button" class="btn-prepaid-view" data-cart-sheet-open="prepaid">{{ section.settings.view_label | escape }}</button></section>{% endif %}
    {% else %}
     <section class="atelier-cart__empty"><div>{% render 'cart-icon',name:'bag' %}</div><h3>{{ section.settings.empty_heading | escape }}</h3><p>{{ section.settings.empty_text | escape }}</p><a href="{{ section.settings.continue_url | default:routes.all_products_collection_url }}">{{ section.settings.continue_label | escape }}</a></section>
    {% endif %}
   </main>
   {% if cart.item_count > 0 %}<footer class="sticky-checkout-bar"><button type="button" class="bottom-price-view" data-cart-summary-scroll aria-label="{{ section.settings.summary_title | escape }}"><span class="bottom-grand-total">{{ section.settings.currency_symbol | escape }}{{ cart.total_price | money_without_currency | remove:'.00' }}</span>{% render 'cart-icon',name:'up' %}</button><a class="btn-checkout-primary" href="{{ routes.root_url }}checkout" data-cart-checkout><span>{{ section.settings.checkout_label | escape }}</span></a></footer>{% endif %}
  </div>
  <div class="offers-modal-backdrop" data-cart-sheet="offers" aria-hidden="true"><section class="offers-modal-sheet" role="dialog" aria-modal="true" aria-labelledby="CartOffersTitle" tabindex="-1"><div class="offers-sheet-handle"></div><header class="offers-modal-header"><div><h3 class="offers-sheet-title" id="CartOffersTitle">{{ section.settings.offers_title | escape }}</h3><p class="offers-sheet-subtitle">{{ section.settings.offers_subtitle | escape }}</p></div><button type="button" class="btn-close-offers" data-cart-sheet-close aria-label="{{ section.settings.close_label | escape }}">{% render 'cart-icon',name:'close' %}</button></header><div class="offers-modal-body">
   {% if reward_count > 0 %}<div class="offers-section-block"><div class="offers-section-heading"><span class="offers-tag-pill milestones">{% render 'cart-icon',name:'gift' %} {{ section.settings.rewards_label | escape }}</span></div><div class="offers-cards-list">{% for block in section.blocks %}{% if block.type == 'milestone' and block.settings.title != blank and block.settings.threshold > 0 %}<article class="mo-card" data-offer-threshold="{{ block.settings.threshold | times:100 }}"><div class="mo-card-left"><span class="mo-icon-bubble">{% render 'cart-icon',name:'gift' %}</span><div class="mo-details"><h4 class="mo-title">{{ block.settings.title | escape }}</h4><div class="mo-desc">{% if block.settings.details != blank %}{{ block.settings.details }}{% else %}{{ section.settings.currency_symbol | escape }}{{ block.settings.threshold }}{% endif %}</div>{% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{{ section.settings.view_label | escape }}</a>{% endif %}</div></div><span class="mo-badge" data-milestone-badge></span></article>{% endif %}{% endfor %}</div></div>{% endif %}
   {% if coupon_count > 0 %}<div class="offers-section-block"><div class="offers-section-heading"><span class="offers-tag-pill coupons">{% render 'cart-icon',name:'tag' %} {{ section.settings.coupons_label | escape }}</span></div><div class="offers-cards-list">{% for block in section.blocks %}{% if block.type == 'coupon' and block.settings.code != blank and block.settings.title != blank %}<article class="mo-card" data-coupon-card data-code="{{ block.settings.code | escape }}" data-minimum="{{ block.settings.minimum | times:100 }}" data-priority="{{ block.settings.priority }}"><div class="mo-card-left"><span class="mo-icon-bubble coupon-bubble">%</span><div class="mo-details"><h4 class="mo-title">{{ block.settings.title | escape }} <span class="coupon-dashed-pill">{{ block.settings.code | escape }}</span></h4><div class="mo-desc">{{ block.settings.condition | escape }}{{ block.settings.details }}</div></div></div><button type="button" class="btn-mo-apply" data-cart-coupon="{{ block.settings.code | escape }}">{{ section.settings.apply_label | escape }}</button></article>{% endif %}{% endfor %}</div></div>{% endif %}
  </div></section></div>
  <div class="offers-modal-backdrop" data-cart-sheet="prepaid" aria-hidden="true"><section class="offers-modal-sheet" role="dialog" aria-modal="true" aria-labelledby="CartPrepaidTitle" tabindex="-1"><div class="offers-sheet-handle"></div><header class="offers-modal-header"><h3 class="offers-sheet-title" id="CartPrepaidTitle">{{ section.settings.prepaid_heading | escape }}</h3><button type="button" class="btn-close-offers" data-cart-sheet-close aria-label="{{ section.settings.close_label | escape }}">{% render 'cart-icon',name:'close' %}</button></header><div class="offers-modal-body">{{ section.settings.prepaid_details }}</div></section></div>
  <div class="offers-modal-backdrop" data-cart-sheet="variant" aria-hidden="true"><section class="offers-modal-sheet" role="dialog" aria-modal="true" aria-labelledby="CartVariantTitle" tabindex="-1"><div class="offers-sheet-handle"></div><header class="offers-modal-header"><h3 class="offers-sheet-title" id="CartVariantTitle">{{ section.settings.variant_title | escape }}</h3><button type="button" class="btn-close-offers" data-cart-sheet-close aria-label="{{ section.settings.close_label | escape }}">{% render 'cart-icon',name:'close' %}</button></header><form class="offers-modal-body atelier-cart__variant-form" data-cart-variant-form><img data-cart-option-image width="220" height="220" alt=""><h4 data-cart-option-title></h4><label>{{ section.settings.variant_label | escape }}<select name="id" data-cart-option-select required></select></label><strong data-cart-option-price></strong><button type="submit" class="btn-rec-add" data-cart-option-add>{{ section.settings.add_label | escape }}</button><p data-cart-option-error role="alert" hidden></p></form></section></div>
  <script type="application/json" data-side-cart-state>{{ cart | json | replace:'</','<\/' }}</script>
  <script type="application/json" data-side-cart-config>{"designMode":{{ request.design_mode | json }},"autoRotate":{{ section.settings.auto_rotate | json }},"celebrate":{{ section.settings.celebrate | json }},"currency":{{ cart.currency.iso_code | default:shop.currency | json }},"symbol":{{ section.settings.currency_symbol | json }},"deadline":{{ section.settings.offer_deadline | json }},"labels":{"milestone_more":{{ section.settings.milestone_more | json }},"milestone_unlocked":{{ section.settings.milestone_unlocked | json }},"timer_label":{{ section.settings.timer_label | json }},"error_label":{{ section.settings.error_label | json }},"variant_partial_error":{{ section.settings.variant_partial_error | json }},"coupon_success":{{ section.settings.coupon_success | json }},"coupon_pending":{{ section.settings.coupon_pending | json }},"coupon_invalid":{{ section.settings.coupon_invalid | json }},"applied_label":{{ section.settings.applied_label | json }},"apply_label":{{ section.settings.apply_label | json }},"locked_label":{{ section.settings.locked_label | json }},"unlocked_label":{{ section.settings.unlocked_label | json }},"offer_expired":{{ section.settings.offer_expired | json }},"addon_copy":{{ section.settings.addon_copy | json }},"added_label":{{ section.settings.added_label | json }},"add_label":{{ section.settings.add_label | json }},"loading_label":{{ section.settings.loading_label | json }},"sold_label":{{ section.settings.sold_label | json }}},"discountApplications":[{% assign application_separator = '' %}{% for application in cart.cart_level_discount_applications %}{{ application_separator }}{"title":{{ application.title | json }},"type":{{ application.type | json }}}{% assign application_separator = ',' %}{% endfor %}{% for line in cart.items %}{% for allocation in line.line_level_discount_allocations %}{{ application_separator }}{"title":{{ allocation.discount_application.title | json }},"type":{{ allocation.discount_application.type | json }}}{% assign application_separator = ',' %}{% endfor %}{% endfor %}]}</script>
  <p class="atelier-cart__sr-only" data-cart-status role="status" aria-live="polite"></p>
 </div>
</cart-drawer>
{% schema %}
{
  "name": "Side cart",
  "tag": "section",
  "class": "side-cart-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout and colors"
    },
    {
      "type": "range",
      "id": "width",
      "label": "Desktop drawer width",
      "min": 400,
      "max": 560,
      "step": 10,
      "unit": "px",
      "default": 480
    },
    {
      "type": "color",
      "id": "primary",
      "label": "Primary button",
      "default": "#5A3825"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Highlights",
      "default": "#C85A32"
    },
    {
      "type": "color",
      "id": "success",
      "label": "Reward progress",
      "default": "#2D6A4F"
    },
    {
      "type": "color",
      "id": "canvas",
      "label": "Scrolling area",
      "default": "#FDFBF7"
    },
    {
