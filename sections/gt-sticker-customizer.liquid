{% liquid
  assign is_visible = true

  if template.name == 'collection'
    assign is_visible = false
    assign col_h = collection.handle | downcase
    assign col_t = collection.title | downcase
    if col_h contains 'sticker' or col_t contains 'sticker' or col_h contains 'decal' or col_t contains 'decal' or col_h contains 'vinyl' or col_t contains 'vinyl'
      assign is_visible = true
    endif
    if request.design_mode
      assign is_visible = true
    endif
  endif
%}

{% if is_visible %}
<!-- Google Fonts Strict Import -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Quicksand:wght@500;600;700&display=swap" rel="stylesheet">

{%- style -%}
  #gt-customizer-{{ section.id }} {
    --gt-bg: {{ section.settings.bg_color | default: '#363638' }};
    --gt-text: {{ section.settings.text_color | default: '#E9DFC2' }};
    --gt-sand: #C6B58E;
    --gt-coffee: #4D351D;
    --gt-gold: #D4AF37;
    --gt-paper: #F8F5ED;
    --gt-font-display: 'DM Serif Display', Georgia, serif;
    --gt-font-ui: 'Inter', -apple-system, sans-serif;
    --gt-font-pill: 'Quicksand', sans-serif;

    background-color: var(--gt-bg);
    color: var(--gt-text);
    font-family: var(--gt-font-ui);
    position: relative;
    overflow: hidden;
    padding: {{ section.settings.padding_top | default: 60 }}px 0 {{ section.settings.padding_bottom | default: 60 }}px;
    border-top: 1px solid rgba(198, 181, 142, 0.15);
    border-bottom: 1px solid rgba(198, 181, 142, 0.15);
  }

  #gt-customizer-{{ section.id }} * {
    box-sizing: border-box;
  }

  .gt-customizer-inner {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Header */
  .gt-customizer-header {
    text-align: center;
    max-width: 760px;
    margin-bottom: 32px;
  }
  .gt-customizer-badge {
    display: inline-block;
    font-family: var(--gt-font-pill);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gt-sand);
    background: rgba(198, 181, 142, 0.12);
    border: 1px solid rgba(198, 181, 142, 0.28);
    border-radius: 999px;
    padding: 6px 14px;
    margin-bottom: 12px;
  }
  .gt-customizer-title {
    font-family: var(--gt-font-display);
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.15;
    color: var(--gt-text);
    margin: 0 0 10px;
    letter-spacing: -0.01em;
  }
  .gt-customizer-subtitle {
    font-size: 14px;
    line-height: 1.6;
    color: var(--gt-sand);
    margin: 0;
    opacity: 0.88;
  }

  /* Toolbar */
  .gt-customizer-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    max-width: 980px;
    background: rgba(24, 22, 20, 0.72);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    padding: 8px 14px;
    margin-bottom: 36px;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.35);
  }
  @media (max-width: 768px) {
    .gt-customizer-toolbar {
      flex-direction: column;
      border-radius: 20px;
      padding: 12px;
      gap: 12px;
    }
  }

  .gt-device-tabs {
    display: flex;
    gap: 6px;
  }
  .gt-device-tab-btn {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 7px 16px;
    border-radius: 999px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--gt-text);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .gt-device-tab-btn:hover {
    background: rgba(255, 255, 255, 0.08);
  }
  .gt-device-tab-btn.is-active {
    background: var(--gt-coffee);
    color: #FFFFFF;
    border-color: rgba(255, 255, 255, 0.2);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  }

  .gt-color-switcher {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .gt-color-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--gt-sand);
    text-transform: uppercase;
  }
  .gt-color-dots {
    display: flex;
    gap: 8px;
  }
  .gt-color-dot {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    cursor: pointer;
    border: 2px solid transparent;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .gt-color-dot:hover {
    transform: scale(1.15);
  }
  .gt-color-dot.is-active {
    border-color: var(--gt-gold);
    transform: scale(1.2);
    box-shadow: 0 0 0 2px rgba(212, 175, 55, 0.4);
  }

  .gt-action-buttons {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .gt-btn-action {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.06);
    color: var(--gt-text);
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .gt-btn-action:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.28);
  }

  /* Hardware Stage */
  .gt-stage-wrapper {
    position: relative;
    width: 100%;
    min-height: 480px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 40px;
  }

  /* 1. MacBook Pro Mockup */
  .gt-macbook-wrap {
    display: block;
    position: relative;
    width: 620px;
    height: 400px;
    filter: drop-shadow(0 25px 50px rgba(0, 0, 0, 0.6));
  }
  @media (max-width: 680px) {
    .gt-macbook-wrap {
      transform: scale(0.55);
      margin: -60px 0;
    }
  }
  .gt-macbook-lid {
    position: relative;
    width: 100%;
    height: 388px;
    border-radius: 22px 22px 6px 6px;
    background: {{ section.settings.finish_1_color | default: '#4A4D52' }};
    border: 2.5px solid rgba(255, 255, 255, 0.22);
    box-shadow: inset 0 0 0 1.5px rgba(0, 0, 0, 0.4), inset 0 2px 6px rgba(255, 255, 255, 0.2), 0 20px 40px rgba(0, 0, 0, 0.4);
    overflow: hidden;
    transition: background-color 0.4s ease;
  }
  .gt-macbook-hinge {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 240px;
    height: 5px;
    background: #1B1E22;
    border-radius: 0 0 4px 4px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    z-index: 8;
  }
  .gt-macbook-thumb-scoop {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 90px;
    height: 7px;
    background: #1A1D20;
    border-radius: 5px 5px 0 0;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-bottom: none;
    z-index: 8;
  }
  .gt-macbook-base-lip {
    position: relative;
    width: 640px;
    margin-left: -10px;
    height: 12px;
    background: linear-gradient(180deg, #2D3035 0%, #1A1C1F 100%);
    border-radius: 0 0 10px 10px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-top: none;
    display: flex;
    justify-content: space-between;
    padding: 0 32px;
  }
  .gt-macbook-foot {
    width: 24px;
    height: 3px;
    background: #0E1012;
    border-radius: 2px;
    margin-top: 5px;
  }

  /* 2. iPad Pro Mockup */
  .gt-ipad-wrap {
    display: none;
    position: relative;
    width: 460px;
    height: 600px;
    filter: drop-shadow(0 25px 50px rgba(0, 0, 0, 0.55));
  }
  @media (max-width: 520px) {
    .gt-ipad-wrap {
      transform: scale(0.65);
      margin: -60px 0;
    }
  }
  .gt-ipad-chassis {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 34px;
    background: {{ section.settings.finish_1_color | default: '#4A4D52' }};
    border: 3px solid rgba(255, 255, 255, 0.22);
    box-shadow: inset 0 0 0 1.5px rgba(0, 0, 0, 0.4), inset 0 2px 6px rgba(255, 255, 255, 0.18), 0 20px 40px rgba(0, 0, 0, 0.4);
    overflow: hidden;
    transition: background-color 0.4s ease;
  }
  .gt-ipad-camera {
    position: absolute;
    top: 14px;
    left: 14px;
    width: 48px;
    height: 84px;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.25);
    box-shadow: 2px 4px 12px rgba(0, 0, 0, 0.4);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-evenly;
    padding: 4px 0;
    z-index: 10;
    pointer-events: none;
  }
  .gt-ipad-lens {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #2A313D 0%, #080A0D 70%, #000 100%);
    border: 2px solid rgba(255, 255, 255, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.6);
  }
  .gt-ipad-lens::after {
    content: '';
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 35%, #183050 0%, #07101A 60%, #000205 100%);
  }
  .gt-ipad-flash {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: radial-gradient(circle, #FFF6D8 25%, #E5B338 75%, #8B6508 100%);
    border: 1px solid rgba(0, 0, 0, 0.3);
  }
  .gt-ipad-pencil-strip {
    position: absolute;
    top: 140px;
    right: 0;
    width: 5px;
    height: 120px;
    background: rgba(0, 0, 0, 0.3);
    border-radius: 3px 0 0 3px;
  }
  .gt-ipad-smart-connector {
    position: absolute;
    bottom: 14px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    z-index: 6;
  }
  .gt-ipad-smart-connector span {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #D4AF37;
    border: 1px solid #785A14;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
  }

  /* 3. iPhone 18 Pro Max Mockup */
  .gt-iphone-wrap {
    display: none;
    position: relative;
    width: 310px;
    height: 640px;
    filter: drop-shadow(0 25px 50px rgba(0, 0, 0, 0.55));
  }
  @media (max-width: 400px) {
    .gt-iphone-wrap {
      transform: scale(0.85);
      margin: -30px 0;
    }
  }
  .gt-iphone-chassis {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 54px;
    background: {{ section.settings.finish_1_color | default: '#4A4D52' }};
    border: 3.5px solid rgba(255, 255, 255, 0.22);
    box-shadow: inset 0 0 0 1.5px rgba(0, 0, 0, 0.5), inset 0 2px 6px rgba(255, 255, 255, 0.2), 0 20px 40px rgba(0, 0, 0, 0.4);
    overflow: hidden;
    transition: background-color 0.4s ease;
  }
  .gt-iphone-action-btn { position: absolute; left: -5px; top: 110px; width: 4px; height: 28px; background: rgba(255,255,255,0.25); border-radius: 2px 0 0 2px; }
  .gt-iphone-volume-up { position: absolute; left: -5px; top: 154px; width: 4px; height: 50px; background: rgba(255,255,255,0.25); border-radius: 2px 0 0 2px; }
  .gt-iphone-volume-down { position: absolute; left: -5px; top: 218px; width: 4px; height: 50px; background: rgba(255,255,255,0.25); border-radius: 2px 0 0 2px; }
  .gt-iphone-power-btn { position: absolute; right: -5px; top: 160px; width: 4px; height: 75px; background: rgba(255,255,255,0.25); border-radius: 0 2px 2px 0; }
  .gt-iphone-camera-control-btn { position: absolute; right: -5px; top: 460px; width: 4px; height: 48px; background: rgba(255,255,255,0.35); border-radius: 0 2px 2px 0; }

  /* Authentic Pro Max Camera Island */
  .gt-iphone-island {
    position: absolute;
    top: 14px;
    left: 14px;
    width: 128px;
    height: 132px;
    border-radius: 34px;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 4px 6px 20px rgba(0, 0, 0, 0.4), inset 0 1px 2px rgba(255, 255, 255, 0.45);
    z-index: 10;
    pointer-events: none;
  }
  .gt-lens-ring {
    position: absolute;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #2A313D 0%, #080A0D 70%, #000 100%);
    border: 2.5px solid rgba(255, 255, 255, 0.4);
    box-shadow: 0 3px 8px rgba(0, 0, 0, 0.7), inset 0 1px 3px rgba(0, 0, 0, 0.95);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .gt-lens-ring::after {
    content: '';
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 35%, #183050 0%, #07101A 60%, #000205 100%);
    box-shadow: inset 0 0 4px #000, 0 0 2px rgba(90, 160, 255, 0.3);
  }
  .gt-lens-top-left { top: 12px; left: 12px; }
  .gt-lens-bottom-left { bottom: 12px; left: 12px; }
  .gt-lens-mid-right { top: 44px; right: 12px; }
  .gt-flash-ring {
    position: absolute;
    top: 18px;
    right: 22px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: radial-gradient(circle, #FFF6D8 25%, #E5B338 75%, #8B6508 100%);
    border: 1px solid rgba(0, 0, 0, 0.3);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.4), inset 0 0 2px rgba(255, 255, 255, 0.8);
  }
  .gt-lidar-sensor {
    position: absolute;
    bottom: 20px;
    right: 22px;
    width: 17px;
    height: 17px;
    border-radius: 50%;
    background: #08090C;
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.9);
  }
  .gt-mic-hole {
    position: absolute;
    bottom: 44px;
    right: 28px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #000;
    box-shadow: inset 0 0 1px #fff3;
  }

  /* Center Apple Mirror Logo */
  .gt-apple-logo-wrap {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 5;
  }
  .gt-apple-logo-wrap svg {
    width: 52px;
    height: 52px;
    color: rgba(255, 255, 255, 0.35);
    filter: drop-shadow(0 1px 2px rgba(255, 255, 255, 0.25));
    transition: color 0.35s ease;
  }

  /* Sticker Drop/Mount Zone */
  .gt-mount-zone {
    position: absolute;
    inset: 0;
    z-index: 7;
  }

  /* Placed Sticker */
  .gt-placed-sticker {
    position: absolute;
    cursor: grab;
    user-select: none;
    touch-action: none;
    z-index: 8;
    transition: filter 0.15s ease;
  }
  .gt-placed-sticker:active {
    cursor: grabbing;
  }
  .gt-placed-sticker.is-selected {
    filter: drop-shadow(0 0 0 2px var(--gt-gold)) drop-shadow(0 8px 16px rgba(0, 0, 0, 0.5));
  }
  .gt-placed-sticker img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
  }
  .gt-placed-sticker .gt-sticker-del {
    position: absolute;
    top: -10px;
    right: -10px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #E84D4D;
    color: #FFFFFF;
    border: 1.5px solid #FFFFFF;
    font-size: 11px;
    line-height: 1;
    display: grid;
    place-items: center;
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(0,0,0,0.4);
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .gt-placed-sticker:hover .gt-sticker-del,
  .gt-placed-sticker.is-selected .gt-sticker-del {
    opacity: 1;
  }

  /* Sticker Tray */
  .gt-tray-card {
    width: 100%;
    max-width: 1080px;
    background: rgba(24, 22, 20, 0.72);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;
    padding: 18px 22px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
  }
  .gt-tray-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }
  .gt-tray-title {
    font-family: var(--gt-font-ui);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--gt-sand);
    margin: 0;
  }
  .gt-tray-status {
    font-size: 12px;
    color: rgba(233, 223, 194, 0.6);
  }
  .gt-tray-grid {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    padding-bottom: 8px;
    scrollbar-width: thin;
  }
  .gt-tray-grid::-webkit-scrollbar {
    height: 6px;
  }
  .gt-tray-grid::-webkit-scrollbar-thumb {
    background: rgba(198, 181, 142, 0.3);
    border-radius: 3px;
  }
  .gt-tray-item {
    flex: 0 0 96px;
    width: 96px;
    height: 96px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.06);
    border: 1.5px dashed rgba(255, 255, 255, 0.18);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
    cursor: grab;
    transition: all 0.2s ease;
  }
  .gt-tray-item:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: var(--gt-gold);
    transform: translateY(-2px);
  }
  .gt-tray-item img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    pointer-events: none;
  }
  .gt-tray-empty {
    width: 100%;
    text-align: center;
    padding: 24px 0;
    color: rgba(233, 223, 194, 0.6);
    font-size: 13px;
  }
{%- endstyle -%}

<section id="gt-customizer-{{ section.id }}" aria-label="Interactive Device and Sticker Customizer">
  <div class="gt-customizer-inner">

    <!-- Section Heading -->
    {%- if section.settings.title != blank or section.settings.subtitle != blank or section.settings.badge != blank -%}
      <div class="gt-customizer-header">
        {%- if section.settings.badge != blank -%}
          <span class="gt-customizer-badge">{{ section.settings.badge | escape }}</span>
        {%- endif -%}

        {%- if section.settings.title != blank -%}
          <h2 class="gt-customizer-title">{{ section.settings.title | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.subtitle != blank -%}
          <p class="gt-customizer-subtitle">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- Controls Toolbar -->
    <div class="gt-customizer-toolbar">
      <!-- Device Switcher Tabs -->
      <div class="gt-device-tabs" role="tablist">
        <button type="button" class="gt-device-tab-btn is-active" data-device="macbook" onclick="gtSwitchDevice('{{ section.id }}', 'macbook')">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M2 20h20"/></svg>
          <span>{{ section.settings.device_label_laptop | default: 'Laptop' | escape }}</span>
        </button>

        <button type="button" class="gt-device-tab-btn" data-device="ipad" onclick="gtSwitchDevice('{{ section.id }}', 'ipad')">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="3"/><circle cx="12" cy="18" r="0.5"/></svg>
          <span>{{ section.settings.device_label_tablet | default: 'Tablet' | escape }}</span>
        </button>

        <button type="button" class="gt-device-tab-btn" data-device="iphone" onclick="gtSwitchDevice('{{ section.id }}', 'iphone')">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="4"/><path d="M12 18h.01"/></svg>
          <span>{{ section.settings.device_label_phone | default: 'Phone' | escape }}</span>
        </button>
      </div>

      <!-- Color Variant Switcher -->
      <div class="gt-color-switcher" id="gt-color-switcher-{{ section.id }}">
        <span class="gt-color-label">{{ section.settings.finish_label | default: 'FINISH:' | escape }}</span>
        <div class="gt-color-dots" id="gt-color-dots-{{ section.id }}">
          <button type="button" class="gt-color-dot is-active" style="background: {{ section.settings.finish_1_color | default: '#4A4D52' }};" title="{{ section.settings.finish_1_name | default: 'Space Gray' | escape }}" onclick="gtSetFinish('{{ section.id }}', '{{ section.settings.finish_1_color | default: '#4A4D52' }}', this)"></button>
          <button type="button" class="gt-color-dot" style="background: {{ section.settings.finish_2_color | default: '#E3E4E6' }};" title="{{ section.settings.finish_2_name | default: 'Silver' | escape }}" onclick="gtSetFinish('{{ section.id }}', '{{ section.settings.finish_2_color | default: '#E3E4E6' }}', this)"></button>
          <button type="button" class="gt-color-dot" style="background: {{ section.settings.finish_3_color | default: '#1D2127' }};" title="{{ section.settings.finish_3_name | default: 'Midnight' | escape }}" onclick="gtSetFinish('{{ section.id }}', '{{ section.settings.finish_3_color | default: '#1D2127' }}', this)"></button>
          <button type="button" class="gt-color-dot" style="background: {{ section.settings.finish_4_color | default: '#D4CBBD' }};" title="{{ section.settings.finish_4_name | default: 'Starlight / Titanium' | escape }}" onclick="gtSetFinish('{{ section.id }}', '{{ section.settings.finish_4_color | default: '#D4CBBD' }}', this)"></button>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="gt-action-buttons">
        {%- if section.settings.show_logo_toggle -%}
          <button type="button" class="gt-btn-action" id="gt-btn-logo-{{ section.id }}" onclick="gtToggleLogo('{{ section.id }}')" title="Toggle Apple Logo">
            <span>Logo</span>
          </button>
        {%- endif -%}
        {%- if section.settings.show_auto_collage -%}
          <button type="button" class="gt-btn-action" onclick="gtAutoCollage('{{ section.id }}')" title="Auto-arrange stickers">
            <span>✨ Auto-Collage</span>
          </button>
        {%- endif -%}
        {%- if section.settings.show_reset -%}
          <button type="button" class="gt-btn-action" onclick="gtResetTray('{{ section.id }}')" title="Reset stickers">
            <span>🔄 Reset</span>
          </button>
        {%- endif -%}
      </div>
    </div>

    <!-- Hardware Stage -->
    <div class="gt-stage-wrapper">
      
      <!-- 1. MacBook Pro Mockup -->
      <div class="gt-macbook-wrap" id="gt-macbook-wrap-{{ section.id }}">
        <div class="gt-macbook-lid" id="gt-macbook-lid-{{ section.id }}">
          <div class="gt-macbook-hinge"></div>
          <div class="gt-macbook-thumb-scoop"></div>
          
          <div class="gt-apple-logo-wrap" id="gt-macbook-logo-{{ section.id }}">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 4.15c.66-.8 1.11-1.92.99-3.04-1 .04-2.14.65-2.82 1.45-.6.69-1.12 1.83-.98 2.94 1.12.09 2.15-.55 2.81-1.35z"/>
