          <div class="gt-mount-zone" id="gt-mount-macbook-{{ section.id }}" data-drop-zone="macbook"></div>
        </div>
        <div class="gt-macbook-base-lip">
          <div class="gt-macbook-foot"></div>
          <div class="gt-macbook-foot"></div>
        </div>
      </div>

      <!-- 2. iPad Pro Mockup -->
      <div class="gt-ipad-wrap" id="gt-ipad-wrap-{{ section.id }}">
        <div class="gt-ipad-chassis" id="gt-ipad-chassis-{{ section.id }}">
          <div class="gt-ipad-camera">
            <div class="gt-ipad-lens"></div>
            <div class="gt-ipad-flash"></div>
          </div>
          <div class="gt-ipad-pencil-strip"></div>
          <div class="gt-ipad-smart-connector"><span></span><span></span><span></span></div>

          <div class="gt-apple-logo-wrap" id="gt-ipad-logo-{{ section.id }}">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 4.15c.66-.8 1.11-1.92.99-3.04-1 .04-2.14.65-2.82 1.45-.6.69-1.12 1.83-.98 2.94 1.12.09 2.15-.55 2.81-1.35z"/>
            </svg>
          </div>

          <div class="gt-mount-zone" id="gt-mount-ipad-{{ section.id }}" data-drop-zone="ipad"></div>
        </div>
      </div>

      <!-- 3. iPhone 18 Pro Max Mockup -->
      <div class="gt-iphone-wrap" id="gt-iphone-wrap-{{ section.id }}">
        <div class="gt-iphone-action-btn"></div>
        <div class="gt-iphone-volume-up"></div>
        <div class="gt-iphone-volume-down"></div>
        <div class="gt-iphone-power-btn"></div>
        <div class="gt-iphone-camera-control-btn"></div>

        <div class="gt-iphone-chassis" id="gt-iphone-chassis-{{ section.id }}">
          <!-- Authentic Pro Max Triple Lens Island -->
          <div class="gt-iphone-island">
            <div class="gt-lens-ring gt-lens-top-left"></div>
            <div class="gt-lens-ring gt-lens-bottom-left"></div>
            <div class="gt-lens-ring gt-lens-mid-right"></div>
            <div class="gt-flash-ring"></div>
            <div class="gt-lidar-sensor"></div>
            <div class="gt-mic-hole"></div>
          </div>

          <div class="gt-apple-logo-wrap" id="gt-iphone-logo-{{ section.id }}">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 4.15c.66-.8 1.11-1.92.99-3.04-1 .04-2.14.65-2.82 1.45-.6.69-1.12 1.83-.98 2.94 1.12.09 2.15-.55 2.81-1.35z"/>
            </svg>
          </div>

          <div class="gt-mount-zone" id="gt-mount-iphone-{{ section.id }}" data-drop-zone="iphone"></div>
        </div>
      </div>

    </div>

    <!-- Sticker Tray -->
    <div class="gt-tray-card">
      <div class="gt-tray-header">
        {%- if section.settings.tray_title != blank -%}
          <h3 class="gt-tray-title">{{ section.settings.tray_title | escape }}</h3>
        {%- endif -%}
        <span class="gt-tray-status" id="gt-tray-count-{{ section.id }}"></span>
      </div>

      <div class="gt-tray-grid" id="gt-tray-{{ section.id }}">
        {%- assign total_stickers = 0 -%}

        {%- for block in section.blocks -%}
          {%- if block.settings.sticker_image != blank -%}
            {%- assign total_stickers = total_stickers | plus: 1 -%}
            <div class="gt-tray-item" 
                 id="gt-stk-{{ block.id }}" 
                 data-sticker-src="{{ block.settings.sticker_image | image_url: width: 320 }}" 
                 data-title="{{ block.settings.title | default: 'Sticker' | escape }}"
                 {{ block.shopify_attributes }}>
              {{ block.settings.sticker_image | image_url: width: 180, height: 180 | image_tag: loading: 'lazy', alt: block.settings.title | escape }}
            </div>
          {%- endif -%}
        {%- endfor -%}

        {%- if section.settings.sticker_collection != blank and section.settings.sticker_collection.products.size > 0 -%}
          {%- for p in section.settings.sticker_collection.products limit: 16 -%}
            {%- if p.featured_image != blank -%}
              {%- assign total_stickers = total_stickers | plus: 1 -%}
              <div class="gt-tray-item" 
                   id="gt-stk-p-{{ p.id }}" 
                   data-sticker-src="{{ p.featured_image | image_url: width: 320 }}" 
                   data-title="{{ p.title | escape }}">
                {{ p.featured_image | image_url: width: 180, height: 180 | image_tag: loading: 'lazy', alt: p.title | escape }}
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {%- if total_stickers == 0 -%}
          <div class="gt-tray-empty">
            <p>No vinyl stickers added yet. Add stickers as blocks in the theme editor.</p>
          </div>
        {%- endif -%}
      </div>
    </div>

  </div>
</section>

<script>
  (function() {
    const sId = '{{ section.id }}';
    let currentDevice = 'macbook';
    let showLogo = true;

    function updateTrayCount() {
      const counter = document.getElementById('gt-tray-count-' + sId);
      const tray = document.getElementById('gt-tray-' + sId);
      if (counter && tray) {
        const count = tray.querySelectorAll('.gt-tray-item').length;
        counter.textContent = count > 0 ? count + ' Available in Tray' : '';
      }
    }

    window.gtSwitchDevice = function(id, device) {
      if (id !== sId) return;
      currentDevice = device;
      
      const wrapMac = document.getElementById('gt-macbook-wrap-' + sId);
      const wrapIpad = document.getElementById('gt-ipad-wrap-' + sId);
      const wrapIphone = document.getElementById('gt-iphone-wrap-' + sId);

      if (wrapMac) wrapMac.style.display = device === 'macbook' ? 'block' : 'none';
      if (wrapIpad) wrapIpad.style.display = device === 'ipad' ? 'block' : 'none';
      if (wrapIphone) wrapIphone.style.display = device === 'iphone' ? 'block' : 'none';

      document.querySelectorAll('#gt-customizer-' + sId + ' .gt-device-tab-btn').forEach(btn => {
        btn.classList.toggle('is-active', btn.dataset.device === device);
      });
    };

    window.gtSetFinish = function(id, color, dot) {
      if (id !== sId) return;
      const lidMac = document.getElementById('gt-macbook-lid-' + sId);
      const chassisIpad = document.getElementById('gt-ipad-chassis-' + sId);
      const chassisIphone = document.getElementById('gt-iphone-chassis-' + sId);

      if (lidMac) lidMac.style.backgroundColor = color;
      if (chassisIpad) chassisIpad.style.backgroundColor = color;
      if (chassisIphone) chassisIphone.style.backgroundColor = color;

      document.querySelectorAll('#gt-customizer-' + sId + ' .gt-color-dot').forEach(d => {
        d.classList.toggle('is-active', d === dot);
      });
    };

    window.gtToggleLogo = function(id) {
      if (id !== sId) return;
      showLogo = !showLogo;
      const logoMac = document.getElementById('gt-macbook-logo-' + sId);
      const logoIpad = document.getElementById('gt-ipad-logo-' + sId);
      const logoIphone = document.getElementById('gt-iphone-logo-' + sId);

      const op = showLogo ? '1' : '0';
      if (logoMac) logoMac.style.opacity = op;
      if (logoIpad) logoIpad.style.opacity = op;
      if (logoIphone) logoIphone.style.opacity = op;

      const btn = document.getElementById('gt-btn-logo-' + sId);
      if (btn) btn.style.background = showLogo ? 'rgba(255,255,255,0.06)' : 'rgba(255,255,255,0.25)';
    };

    window.gtResetTray = function(id) {
      if (id !== sId) return;
      document.querySelectorAll('#gt-customizer-' + sId + ' .gt-placed-sticker').forEach(el => {
        returnStickerToTray(el);
      });
    };

    window.gtAutoCollage = function(id) {
      if (id !== sId) return;
      const tray = document.getElementById('gt-tray-' + sId);
      const zone = document.getElementById('gt-mount-' + currentDevice + '-' + sId);
      if (!tray || !zone) return;

      const items = Array.from(tray.querySelectorAll('.gt-tray-item'));
      if (items.length === 0) return;

      const rect = zone.getBoundingClientRect();
      const numToPlace = Math.min(items.length, currentDevice === 'iphone' ? 3 : 5);

      for (let i = 0; i < numToPlace; i++) {
        const item = items[i];
        const src = item.dataset.stickerSrc;
        const title = item.dataset.title;
        const width = currentDevice === 'iphone' ? 84 : 100;
        const height = width;

        const maxL = Math.max(20, rect.width - width - 20);
        const maxT = Math.max(20, rect.height - height - 20);
        const l = 20 + Math.random() * (maxL - 20);
        const t = 20 + Math.random() * (maxT - 20);
        const rot = (Math.random() - 0.5) * 36;

        placeStickerOnDevice(item, src, title, l, t, rot, zone);
      }
    };

    function placeStickerOnDevice(trayItem, src, title, left, top, rot, zone) {
      trayItem.style.display = 'none';

      const placed = document.createElement('div');
      placed.className = 'gt-placed-sticker';
      const size = currentDevice === 'iphone' ? 88 : 108;
      placed.style.width = size + 'px';
      placed.style.height = size + 'px';
      placed.style.left = left + 'px';
      placed.style.top = top + 'px';
      placed.style.transform = 'rotate(' + (rot || 0) + 'deg)';
      placed.dataset.rot = rot || 0;
      placed.dataset.originId = trayItem.id;

      const img = document.createElement('img');
      img.src = src;
      img.alt = title || 'Sticker';
      placed.appendChild(img);

      const del = document.createElement('button');
      del.type = 'button';
      del.className = 'gt-sticker-del';
      del.innerHTML = '✕';
      del.title = 'Remove';
      del.onclick = function(e) {
        e.stopPropagation();
        returnStickerToTray(placed);
      };
      placed.appendChild(del);

      // Dragging logic
      initStickerDrag(placed, zone);

      zone.appendChild(placed);
      updateTrayCount();
    }

    function returnStickerToTray(placed) {
      const origId = placed.dataset.originId;
      if (origId) {
        const orig = document.getElementById(origId);
        if (orig) orig.style.display = '';
      }
      placed.remove();
      updateTrayCount();
    }

    function initStickerDrag(el, zone) {
      let isDragging = false;
      let startX = 0, startY = 0;
      let initL = 0, initT = 0;

      function onDown(e) {
        if (e.target.closest('.gt-sticker-del')) return;
        isDragging = true;
        el.classList.add('is-selected');
        const evt = e.touches ? e.touches[0] : e;
        startX = evt.clientX;
        startY = evt.clientY;
        initL = parseFloat(el.style.left) || 0;
        initT = parseFloat(el.style.top) || 0;

        document.addEventListener('mousemove', onMove);
        document.addEventListener('mouseup', onUp);
        document.addEventListener('touchmove', onMove, { passive: false });
        document.addEventListener('touchend', onUp);
      }

      function onMove(e) {
        if (!isDragging) return;
        if (e.cancelable) e.preventDefault();
        const evt = e.touches ? e.touches[0] : e;
        const dx = evt.clientX - startX;
        const dy = evt.clientY - startY;

        const zoneRect = zone.getBoundingClientRect();
        const w = el.offsetWidth;
        const h = el.offsetHeight;

        let newL = Math.max(-w/2, Math.min(zoneRect.width - w/2, initL + dx));
        let newT = Math.max(-h/2, Math.min(zoneRect.height - h/2, initT + dy));

        el.style.left = newL + 'px';
        el.style.top = newT + 'px';
      }

      function onUp() {
        isDragging = false;
        document.removeEventListener('mousemove', onMove);
        document.removeEventListener('mouseup', onUp);
        document.removeEventListener('touchmove', onMove);
        document.removeEventListener('touchend', onUp);
      }

      el.addEventListener('mousedown', onDown);
      el.addEventListener('touchstart', onDown, { passive: true });

      // Double-click/double-tap to rotate 15 deg
      let lastTap = 0;
      el.addEventListener('click', function(e) {
        if (e.target.closest('.gt-sticker-del')) return;
        const now = Date.now();
        if (now - lastTap < 350) {
          let curRot = (parseFloat(el.dataset.rot) || 0) + 15;
          if (curRot >= 360) curRot = 0;
          el.dataset.rot = curRot;
          el.style.transform = 'rotate(' + curRot + 'deg)';
        }
        lastTap = now;
      });
    }

    // Initialize tray item clicks to place on device
    function initTray() {
      const tray = document.getElementById('gt-tray-' + sId);
      if (!tray) return;

      tray.addEventListener('click', function(e) {
        const item = e.target.closest('.gt-tray-item');
        if (!item || item.style.display === 'none') return;

        const zone = document.getElementById('gt-mount-' + currentDevice + '-' + sId);
        if (!zone) return;

        const rect = zone.getBoundingClientRect();
        const src = item.dataset.stickerSrc;
        const title = item.dataset.title;
        const size = currentDevice === 'iphone' ? 88 : 108;

        const l = Math.max(20, (rect.width - size) / 2 + (Math.random() - 0.5) * 60);
        const t = Math.max(20, (rect.height - size) / 2 + (Math.random() - 0.5) * 60);
        const rot = (Math.random() - 0.5) * 20;

        placeStickerOnDevice(item, src, title, l, t, rot, zone);
      });

      updateTrayCount();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTray);
    } else {
      initTray();
    }
  })();
</script>
{% endif %}

