{% liquid
  assign is_sticker_product = false

  if template.name == 'product'
    assign p_type = product.type | downcase | strip
    if p_type contains 'sticker' or p_type contains 'decal'
      assign is_sticker_product = true
    endif

    unless is_sticker_product
      for tag in product.tags
        assign t = tag | downcase | strip
        if t == 'sticker' or t == 'stickers' or t contains 'sticker' or t contains 'vinyl' or t contains 'decal'
          assign is_sticker_product = true
          break
        endif
      endfor
    endunless

    unless is_sticker_product
      for col in product.collections
        assign c_handle = col.handle | downcase
        assign c_title = col.title | downcase
        if c_handle contains 'sticker' or c_title contains 'sticker'
          assign is_sticker_product = true
          break
        endif
      endfor
    endunless

    unless is_sticker_product
      assign p_title = product.title | downcase
      if p_title contains 'sticker' or p_title contains 'decal'
        assign is_sticker_product = true
      endif
    endunless

    unless is_sticker_product
      if product.metafields.custom.is_sticker == true or product.metafields.custom.sticker_preview != blank
        assign is_sticker_product = true
      endif
    endunless

    if section.settings.always_show
      assign is_sticker_product = true
    endif
  else
    assign is_sticker_product = true
  endif
%}

{% if is_sticker_product %}
{% comment %}
  Graffeine Tales — Independent Multi-Device & Sticker Customizer Section
  Compatible with: Homepage (index.json), Collection (collection.json), PDPs

  Typography Hierarchy (Strict Brand Guidelines):
    - Primary Display Serif: 'DM Serif Display', Georgia, serif
    - Secondary Editorial Serif: 'Playfair Display', serif
    - Clean UI Sans: 'Inter', -apple-system, sans-serif
    - Tactile Script Accent: 'Patrick Hand', cursive
    - Badges & Pills: 'Quicksand', sans-serif

  Authentic Device Models:
    1. MacBook Pro/Air (16:10 Laptop Lid + Display Notch Scoop + Base Lip & Hinge)
    2. iPad Pro (Vertical 3:4 Portrait + Apple Pencil Dock + Corner Camera + Smart Connector)
    3. iPhone 18 Pro Max (Vertical 9:19.5 + Titanium Band + Giant Triple-Lens Camera Island + LiDAR)
{% endcomment %}

<!-- Google Fonts Strict Import -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@300;400;500;600;700&family=Patrick+Hand&family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Quicksand:wght@500;600;700&display=swap" rel="stylesheet">

{%- style -%}
  #gt-customizer-{{ section.id }} {
    --gt-bg: {{ section.settings.bg_color | default: '#363638' }};
    --gt-text: {{ section.settings.text_color | default: '#E9DFC2' }};
    --gt-sand: #C6B58E;
    --gt-coffee: #4D351D;
    --gt-gold: #D4AF37;
    --gt-paper: #F8F5ED;
    --gt-font-display: 'DM Serif Display', Georgia, serif;
    --gt-font-editorial: 'Playfair Display', serif;
    --gt-font-ui: 'Inter', -apple-system, sans-serif;
    --gt-font-script: 'Patrick Hand', cursive;
    --gt-font-pill: 'Quicksand', sans-serif;

    background-color: var(--gt-bg);
    color: var(--gt-text);
    font-family: var(--gt-font-ui);
    position: relative;
    overflow: hidden;
    padding: {{ section.settings.padding_top | default: 60 }}px 16px {{ section.settings.padding_bottom | default: 80 }}px;
  }

  #gt-customizer-{{ section.id }}::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at top, rgba(77, 53, 29, 0.45) 0%, rgba(54, 54, 56, 0.95) 60%, rgba(28, 27, 26, 1) 100%);
    pointer-events: none;
    z-index: 1;
  }

  .gt-customizer-inner {
    position: relative;
    z-index: 2;
    max-width: 1240px;
    margin: 0 auto;
  }

  /* Section Header */
  .gt-customizer-header {
    text-align: center;
    max-width: 780px;
    margin: 0 auto 2.25rem;
  }

  .gt-customizer-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--gt-font-pill);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gt-text);
    background: rgba(77, 53, 29, 0.75);
    border: 1px solid var(--gt-sand);
    backdrop-filter: blur(8px);
    padding: 0.35rem 1.15rem;
    border-radius: 9999px;
    margin-bottom: 0.85rem;
  }

  .gt-customizer-title {
    font-family: var(--gt-font-display);
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    line-height: 1.12;
    color: var(--gt-text);
    font-weight: 400;
    margin: 0 0 0.85rem;
  }

  .gt-customizer-subtitle {
    font-family: var(--gt-font-editorial);
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.6;
    color: var(--gt-sand);
    font-style: italic;
    margin: 0;
  }

  .gt-customizer-script-note {
    font-family: var(--gt-font-script);
    font-size: 1.25rem;
    color: var(--gt-gold);
    display: block;
    margin-top: 0.5rem;
  }

  /* Controls Toolbar */
  .gt-customizer-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(198, 181, 142, 0.35);
    backdrop-filter: blur(12px);
    border-radius: 9999px;
    padding: 0.5rem 0.85rem;
    margin-bottom: 2.5rem;
  }

  @media (max-width: 768px) {
    .gt-customizer-toolbar {
      border-radius: 1.5rem;
      justify-content: center;
    }
  }

  .gt-device-tabs {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .gt-device-tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--gt-font-ui);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--gt-text);
    background: transparent;
    border: none;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .gt-device-tab-btn:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .gt-device-tab-btn.is-active {
    background: var(--gt-coffee);
    color: #FFFFFF;
    box-shadow: 0 4px 14px rgba(77, 53, 29, 0.45);
  }

  .gt-color-switcher {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .gt-color-label {
    font-family: var(--gt-font-pill);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(233, 223, 194, 0.7);
    margin-right: 0.35rem;
  }

  .gt-color-dot {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 2px solid transparent;
    cursor: pointer;
    transition: all 0.2s ease;
    padding: 0;
  }

  .gt-color-dot:hover {
    transform: scale(1.15);
  }

  .gt-color-dot.is-active {
    border-color: var(--gt-sand);
    box-shadow: 0 0 0 2px var(--gt-coffee);
    transform: scale(1.12);
  }

  .gt-action-buttons {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .gt-btn-action {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--gt-font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--gt-text);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(198, 181, 142, 0.3);
    padding: 0.4rem 0.85rem;
    border-radius: 9999px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .gt-btn-action:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: var(--gt-sand);
  }

  /* ========================================================
     AUTHENTIC DEVICE MOCKUP HARDWARE STAGES
     ======================================================== */
  .gt-stage-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-bottom: 2.75rem;
    min-height: 480px;
    position: relative;
  }

  /* --------------------------------------------------------
     1. MACBOOK HARDWARE ARCHITECTURE (Unibody Lid + Base Lip)
     -------------------------------------------------------- */
  .gt-macbook-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(94%, 660px);
  }

  .gt-macbook-lid {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 20px 20px 6px 6px;
    border: 2px solid rgba(255, 255, 255, 0.25);
    box-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.5), inset 0 -2px 4px rgba(0, 0, 0, 0.3), 0 35px 65px -15px rgba(0, 0, 0, 0.7);
    overflow: hidden;
    user-select: none;
    transition: background 0.35s ease, border-color 0.35s ease;
  }

  /* Thumb scoop opening recess */
  .gt-macbook-thumb-scoop {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 84px;
    height: 4px;
    background: rgba(0, 0, 0, 0.4);
    border-radius: 0 0 5px 5px;
    z-index: 10;
    box-shadow: inset 0 -1px 1px rgba(255, 255, 255, 0.15);
  }

  /* Laptop Base & Hinge */
  .gt-macbook-hinge {
    width: 170px;
    height: 7px;
    background: #18191B;
    border-radius: 0 0 4px 4px;
    z-index: 8;
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.8);
  }

  .gt-macbook-base-lip {
    width: 103%;
    height: 12px;
    margin-top: -3px;
    background: linear-gradient(180deg, #353639 0%, #1F2022 100%);
    border-radius: 0 0 16px 16px;
    box-shadow: 0 25px 45px rgba(0, 0, 0, 0.7), inset 0 1px 1px rgba(255, 255, 255, 0.25);
    display: flex;
    justify-content: space-between;
    padding: 0 35px;
  }

  .gt-macbook-foot {
    width: 28px;
    height: 2px;
    background: #0A0A0A;
    border-radius: 2px;
    margin-top: 8px;
    opacity: 0.6;
  }

  /* --------------------------------------------------------
     2. IPAD PRO HARDWARE ARCHITECTURE (VERTICAL 3:4 PORTRAIT)
     -------------------------------------------------------- */
  .gt-ipad-wrap {
    display: none;
    flex-direction: column;
    align-items: center;
    width: min(84%, 370px);
  }

  .gt-ipad-chassis {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    border-radius: 32px;
    border: 2px solid rgba(255, 255, 255, 0.22);
    box-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.6), inset 0 0 0 1px rgba(0, 0, 0, 0.25), 0 35px 70px -15px rgba(0, 0, 0, 0.65);
    overflow: hidden;
    user-select: none;
    transition: background 0.35s ease;
  }

  /* Apple Pencil Magnetic Dock Strip (Right side) */
  .gt-ipad-pencil-strip {
    position: absolute;
    right: 0;
    top: 26%;
    width: 4px;
    height: 115px;
    background: rgba(255, 255, 255, 0.45);
    border-radius: 3px 0 0 3px;
    box-shadow: -1px 0 3px rgba(0, 0, 0, 0.25);
    z-index: 10;
  }

  /* Top Camera Pod */
  .gt-ipad-camera {
    position: absolute;
    top: 14px;
    right: 18px;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #0E1012;
    border: 2px solid rgba(255, 255, 255, 0.35);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
    z-index: 10;
  }

  .gt-ipad-camera::after {
    content: '';
    position: absolute;
    inset: 4px;
    border-radius: 50%;
    background: radial-gradient(circle, #212936 30%, #050608 100%);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  /* Smart Connector 3-Pin Dots */
  .gt-ipad-smart-connector {
    position: absolute;
    bottom: 14px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 5px;
    z-index: 10;
  }

  .gt-ipad-smart-connector span {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #D4AF37;
    box-shadow: inset 0 1px 1px rgba(0, 0, 0, 0.4);
  }

  /* --------------------------------------------------------
     3. IPHONE 18 PRO MAX HARDWARE ARCHITECTURE (VERTICAL 9:19.5)
     -------------------------------------------------------- */
  .gt-iphone-wrap {
    display: none;
    flex-direction: column;
    align-items: center;
    width: min(74%, 290px);
    position: relative;
  }

  .gt-iphone-chassis {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 19.2;
    border-radius: 48px;
    border: 3.5px solid rgba(255, 255, 255, 0.28);
    box-shadow: inset 0 1px 3px rgba(255, 255, 255, 0.5), inset 0 0 0 1px rgba(0, 0, 0, 0.35), 0 35px 70px -15px rgba(0, 0, 0, 0.7);
    overflow: hidden;
    user-select: none;
    transition: background 0.35s ease;
  }

  /* Left/Right Titanium Buttons */
  .gt-iphone-action-btn {
    position: absolute;
    left: -4px;
    top: 96px;
    width: 4px;
    height: 24px;
    border-radius: 2px 0 0 2px;
    background: inherit;
    filter: brightness(0.85);
  }

  .gt-iphone-volume-up {
    position: absolute;
    left: -4px;
    top: 136px;
    width: 4px;
    height: 46px;
    border-radius: 2px 0 0 2px;
    background: inherit;
    filter: brightness(0.85);
  }

  .gt-iphone-volume-down {
    position: absolute;
    left: -4px;
    top: 194px;
    width: 4px;
    height: 46px;
    border-radius: 2px 0 0 2px;
    background: inherit;
    filter: brightness(0.85);
  }

  .gt-iphone-camera-control-btn {
    position: absolute;
    right: -4px;
    bottom: 120px;
    width: 4px;
    height: 58px;
    border-radius: 0 2px 2px 0;
    background: inherit;
    filter: brightness(0.8);
    box-shadow: inset 0 0 2px rgba(0, 0, 0, 0.5);
  }

  /* Massive Authentic Triple-Lens Camera Island */
  .gt-iphone-island {
    position: absolute;
    top: 14px;
    left: 14px;
    width: 126px;
    height: 130px;
    border-radius: 34px;
    background: inherit;
    filter: brightness(0.92);
    box-shadow: 4px 6px 18px rgba(0, 0, 0, 0.4), inset 0 1px 2px rgba(255, 255, 255, 0.35);
    z-index: 10;
    pointer-events: none;
  }

  /* 3 Giant Pro Max Lenses (Triangle layout) */
  .gt-lens-ring {
    position: absolute;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #0D0F12;
    border: 2.5px solid rgba(255, 255, 255, 0.38);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.6), inset 0 1px 3px rgba(0, 0, 0, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .gt-lens-ring::after {
    content: '';
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 35%, #1F2836 0%, #050709 100%);
    box-shadow: inset 0 0 4px #000;
  }

  .gt-lens-top-left { top: 12px; left: 12px; }
  .gt-lens-bottom-left { bottom: 12px; left: 12px; }
  .gt-lens-mid-right { top: 44px; right: 12px; }

  /* True Tone Flash */
  .gt-flash-ring {
    position: absolute;
    top: 16px;
    right: 22px;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: radial-gradient(circle, #FFF5D6 30%, #D4AF37 100%);
    border: 1px solid rgba(0, 0, 0, 0.25);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
  }

  /* LiDAR Sensor */
  .gt-lidar-sensor {
    position: absolute;
    bottom: 18px;
    right: 22px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #08090B;
    border: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.8);
  }

  /* Shared Center Apple Mirror Logo */
  .gt-apple-logo-wrap {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 5;
  }

  .gt-apple-logo-wrap svg {
    width: 52px;
    height: 52px;
    filter: drop-shadow(0 1px 2px rgba(255, 255, 255, 0.35));
    transition: color 0.35s ease;
  }

  /* Reflection highlights */
  .gt-chassis-gloss {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0.02) 40%, rgba(0, 0, 0, 0.15) 100%);
    pointer-events: none;
    z-index: 2;
  }

  /* Mount container for stickers */
  .gt-mount-zone {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    overflow: hidden;
    z-index: 20;
    pointer-events: none;
  }

  /* Drop feedback */
  .drop-highlight {
    box-shadow: 0 0 0 4px var(--gt-gold), 0 35px 70px rgba(212, 175, 55, 0.4) !important;
  }

  /* ========================================================
     STICKER TRAY (PICKUP ZONE)
     ======================================================== */
  .gt-tray-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(198, 181, 142, 0.25);
    border-radius: 24px;
    padding: 1.5rem;
    backdrop-filter: blur(12px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  .gt-tray-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(198, 181, 142, 0.2);
  }

  .gt-tray-title {
    font-family: var(--gt-font-display);
    font-size: 1.25rem;
    color: var(--gt-text);
    margin: 0;
    font-weight: 400;
  }

  .gt-tray-status {
    font-family: var(--gt-font-ui);
    font-size: 0.75rem;
    color: var(--gt-sand);
    font-weight: 500;
  }

  .gt-tray-grid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    min-height: 140px;
    padding: 0.5rem;
  }

  .gt-die-cut-sticker {
    position: relative;
    width: 82px;
    height: 82px;
    cursor: grab;
    user-select: none;
    -webkit-user-drag: none;
    touch-action: none;
    transition: transform 0.2s cubic-bezier(0.2, 0, 0, 1), filter 0.2s ease;
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.3));
    pointer-events: auto;
  }

  @media (min-width: 640px) {
    .gt-die-cut-sticker {
      width: 94px;
      height: 94px;
    }
  }

  .gt-die-cut-sticker:hover {
    transform: scale(1.08) rotate(3deg);
    filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.45));
  }

  .gt-die-cut-sticker.is-dragging {
    cursor: grabbing;
    position: fixed !important;
    z-index: 99999 !important;
    transition: none !important;
    filter: drop-shadow(0 20px 30px rgba(0, 0, 0, 0.55)) !important;
  }

  .gt-die-cut-sticker.placed-on-device {
    position: absolute !important;
    cursor: move;
  }

  .gt-sticker-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    pointer-events: none;
    filter: drop-shadow(0 0 2px rgba(255, 255, 255, 0.85));
  }

  .gt-customizer-toast {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 100000;
    background: #363638;
    color: #E9DFC2;
    border: 1px solid var(--gt-sand);
    padding: 0.65rem 1.25rem;
    border-radius: 9999px;
    font-family: var(--gt-font-ui);
    font-size: 0.8125rem;
    font-weight: 500;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.35);
    opacity: 0;
    transform: translateY(12px);
    transition: all 0.25s ease;
    pointer-events: none;
  }
  .gt-customizer-toast.show {
    opacity: 1;
    transform: translateY(0);
  }

  .gt-current-sticker-badge {
    position: absolute;
    top: -6px;
    left: 50%;
    transform: translateX(-50%);
    background: #D4AF37;
    color: #181614;
    font-family: var(--gt-font-pill);
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.05em;
    padding: 2px 6px;
    border-radius: 999px;
    white-space: nowrap;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
    pointer-events: none;
    z-index: 10;
  }


  /* Hardware Logo Toggle */
  .gt-apple-logo-wrap.is-hidden {
    opacity: 0 !important;
    pointer-events: none !important;
  }

  /* Sticker Remove / Return Button */
  .gt-sticker-remove-btn {
    position: absolute;
    top: -8px;
    right: -8px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #C85A32;
    color: #FFFFFF;
    border: 2px solid #FFFFFF;
    font-size: 13px;
    font-weight: 700;
    line-height: 1;
    display: none;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
    z-index: 100;
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .gt-sticker-remove-btn:hover {
    background: #4D351D;
    transform: scale(1.15);
  }
  .gt-die-cut-sticker.placed-on-device .gt-sticker-remove-btn {
    display: flex;
  }

  /* Curated Studio Die-Cut Typography Badges */
  .gt-badge-sticker {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 6px;
    border: 2.5px solid #FFFFFF;
