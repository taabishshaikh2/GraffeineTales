{% liquid
 assign catalogue_collection = section.settings.collection
 if catalogue_collection.products.size == 0 or catalogue_collection == blank
  for entry in section.blocks
   if entry.settings.collection.products.size > 0
    assign catalogue_collection = entry.settings.collection
    break
   endif
  endfor
 endif
%}
{% if catalogue_collection.products.size > 0 %}
{{ 'product-showcase.css' | asset_url | stylesheet_tag }}
{{ 'catalogue.css' | asset_url | stylesheet_tag }}
<script src="{{ 'catalogue.js' | asset_url }}" defer></script>
<script src="{{ 'product-showcase.js' | asset_url }}" defer></script>
<atelier-product-showcase id="catalogue-section" data-catalogue data-showcase-columns="{{ section.settings.columns }}" data-currency="{{ cart.currency.iso_code | escape }}" data-add-label="{{ section.settings.add_label | escape }}" data-adding-label="{{ section.settings.adding_label | escape }}" data-added-label="{{ section.settings.added_label | escape }}" data-error-label="{{ section.settings.error_label | escape }}" data-sold-out-label="{{ section.settings.sold_out_label | escape }}" style="--catalogue-filter-background:{{ section.settings.filter_background }};--catalogue-filter-text:{{ section.settings.filter_text }};--catalogue-active-background:{{ section.settings.active_filter_background }};--catalogue-active-text:{{ section.settings.active_filter_text }};--showcase-background:{{ section.settings.background }};--showcase-card:{{ section.settings.card_background }};--showcase-image:{{ section.settings.image_background }};--showcase-text:{{ section.settings.text_color }};--showcase-accent:{{ section.settings.accent }};--showcase-button:{{ section.settings.button_background }};--showcase-button-text:{{ section.settings.button_color }};--showcase-badge:{{ section.settings.badge_background }};--showcase-badge-text:{{ section.settings.badge_color }};--showcase-gold:{{ section.settings.gold_badge_background }};--showcase-gold-text:{{ section.settings.gold_badge_color }};--showcase-width:{{ section.settings.width }}px;--showcase-columns:{{ section.settings.columns }};--showcase-gap:{{ section.settings.gap }}px;--showcase-mobile-width:{{ section.settings.mobile_width }}px;--showcase-card-height:{{ section.settings.card_height }}px;--showcase-image-height:{{ section.settings.image_height }}px;--showcase-image-padding:{{ section.settings.image_padding }}px;--showcase-radius:{{ section.settings.radius }}px;--showcase-heading-size:{{ section.settings.heading_size }}px;--showcase-top:{{ section.settings.padding_top }}px;--showcase-bottom:{{ section.settings.padding_bottom }}px">
  <div class="atelier-showcase__inner">
    <header class="atelier-showcase__heading">
      {% if section.settings.eyebrow != blank %}<p>{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
      {% if section.settings.description != blank %}<div class="atelier-showcase__intro">{{ section.settings.description | escape }}</div>{% endif %}
    </header>
    <catalogue-filters data-results-label="{{ section.settings.results_label | escape }}">
      <div class="atelier-catalogue__filters" data-catalogue-filter-controls hidden role="group" aria-label="{{ section.settings.filter_label | escape }}">
        <button type="button" class="atelier-catalogue__filter" data-catalogue-filter="all" aria-pressed="true" aria-controls="CatalogueGrid-{{ section.id }}">{{ section.settings.all_label | escape }}</button>
        {% for block in section.blocks %}{% if block.settings.collection.products.size > 0 %}<button type="button" class="atelier-catalogue__filter" data-catalogue-filter="{{ block.id }}" data-block-id="{{ block.id }}" aria-pressed="false" aria-controls="CatalogueGrid-{{ section.id }}" {{ block.shopify_attributes }}>{{ block.settings.label | default: block.settings.collection.title | escape }}</button>{% endif %}{% endfor %}
      </div>
      <div class="atelier-showcase__grid" id="CatalogueGrid-{{ section.id }}" data-catalogue-grid>
        {% for card_product in catalogue_collection.products limit: section.settings.product_limit %}{% render 'product-card', card_product: card_product, section: section %}{% endfor %}
      </div>
      <p class="visually-hidden" data-catalogue-status role="status" aria-live="polite"></p>
      {% if section.settings.show_collection_link %}<a class="atelier-catalogue__collection-link" data-catalogue-collection-link href="{{ catalogue_collection.url | default: routes.all_products_collection_url }}">{{ section.settings.collection_link_label | escape }}{% render 'header-icon', name: 'arrow' %}</a>{% endif %}
      <template data-catalogue-template="all" data-collection-url="{{ catalogue_collection.url | default: routes.all_products_collection_url }}">
        {% for card_product in catalogue_collection.products limit: section.settings.product_limit %}{% render 'product-card', card_product: card_product, section: section %}{% endfor %}
      </template>
      {% for block in section.blocks %}
        {% if block.settings.collection.products.size > 0 %}
          <template data-catalogue-template="{{ block.id }}" data-collection-url="{{ block.settings.collection.url }}">
            {% for card_product in block.settings.collection.products limit: section.settings.product_limit %}{% render 'product-card', card_product: card_product, section: section %}{% endfor %}
          </template>
        {% endif %}
      {% endfor %}
    </catalogue-filters>
    <p class="atelier-showcase__status visually-hidden" data-showcase-status role="status" aria-live="polite"></p>
  </div>
  <dialog class="atelier-quick-view" data-quick-view-dialog aria-labelledby="QuickViewTitle-{{ section.id }}">
    <button type="button" class="atelier-quick-view__close" data-close-quick-view aria-label="{{ section.settings.close_label | escape }}">{% render 'header-icon', name: 'close' %}</button>
    <p class="atelier-quick-view__loading" data-quick-view-loading>{{ section.settings.loading_label | escape }}</p>
    <div class="atelier-quick-view__layout" data-quick-view-body hidden>
      <div class="atelier-quick-view__media"><img data-quick-view-image alt="" width="600" height="700"></div>
      <div class="atelier-quick-view__details">
        <h2 id="QuickViewTitle-{{ section.id }}" data-quick-view-title>{{ section.settings.quick_view_label | escape }}</h2>
        <p class="atelier-quick-view__price" data-quick-view-price></p>
        <div class="atelier-quick-view__description" data-quick-view-description></div>
        <form data-atelier-product-form data-quick-view-form action="{{ routes.cart_add_url }}" method="post">
          <div data-quick-view-variant-row><label for="QuickViewVariant-{{ section.id }}">{{ section.settings.variant_label | escape }}</label><select id="QuickViewVariant-{{ section.id }}" name="id" data-quick-view-variants></select></div>
          <label for="QuickViewQuantity-{{ section.id }}">{{ section.settings.quantity_label | escape }}</label>
          <div class="atelier-quick-view__quantity"><button type="button" data-quantity-change="-1" aria-label="{{ 'products.product.quantity.decrease' | t: product: section.settings.quick_view_label }}">−</button><input id="QuickViewQuantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" step="1" inputmode="numeric"><button type="button" data-quantity-change="1" aria-label="{{ 'products.product.quantity.increase' | t: product: section.settings.quick_view_label }}">+</button></div>
          <button class="atelier-product-card__add" type="submit" data-quick-view-add>{{ section.settings.add_label | escape }}</button>
        </form>
        <p class="atelier-product-card__error" data-quick-view-error role="alert" hidden></p>
        <a class="atelier-quick-view__link" data-quick-view-link>{{ section.settings.details_label | escape }}</a>
      </div>
    </div>
  </dialog>
</atelier-product-showcase>


{% else %}{% style %}#shopify-section-{{ section.id }}{display:none}{% endstyle %}{% endif %}
{% stylesheet %}
@media (min-width: 1024px) and (max-width: 1279px) {
  atelier-product-showcase[data-showcase-columns="4"] .atelier-showcase__grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}
{% endstylesheet %}
{% schema %}
{
  "name": "Atelier catalogue",
  "tag": "section",
  "class": "product-showcase-section",
  "settings": [
    {
      "type": "header",
      "content": "Content and products"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Full Studio Archive"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Complete Atelier Collection"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Optional introduction"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Products and their order are managed in this collection in Shopify admin."
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Maximum products",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 48,
      "info": "Maximum cards per filter. Use the collection link below to browse more products."
    },
    {
      "type": "text",
      "id": "default_badge",
      "label": "Default badge",
      "default": "Studio Edit"
    },
    {
      "type": "checkbox",
      "id": "use_product_badges",
      "label": "Use product badge tags",
      "default": true,
      "info": "Use product tags such as badge:Artisan and badge-style:gold or badge-style:sage."
    },
    {
      "type": "select",
      "id": "default_badge_style",
      "label": "Badge style",
      "options": [
        {
          "value": "sage",
          "label": "Sage"
        },
        {
          "value": "gold",
          "label": "Gold"
        }
      ],
      "default": "gold"
    },
    {
