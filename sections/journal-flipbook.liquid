{% liquid
 assign preview = product.metafields.graffeine_journal.preview_book.value
 assign page_keys = 'front_image,page_1,page_2,page_3,page_4,back_image' | split: ','
%}
{% liquid
 assign preview_page_count = 0
 for page_key in page_keys
  if preview[page_key].value != blank
   assign preview_page_count = preview_page_count | plus:1
  endif
 endfor
%}
{% if preview != blank and preview_page_count == 6 %}
{{ 'journal-flipbook.css' | asset_url | stylesheet_tag }}
<script src="{{ 'page-flip.js' | asset_url }}" defer></script>
<script src="{{ 'journal-flipbook.js' | asset_url }}" defer></script>
<journal-flipbook class="journal-flipbook" aria-label="{{ preview.name.value | escape }}" data-width="{{ section.settings.page_width }}" data-duration="{{ section.settings.turn_time }}" data-counter-label="{{ section.settings.counter_label | escape }}" data-error-label="{{ section.settings.error_label | escape }}" style="--flip-background:{{ section.settings.background }};--flip-coffee:{{ section.settings.coffee }};--flip-card:{{ section.settings.card_background }};--flip-card-border:{{ section.settings.card_border }};--flip-card-radius:{{ section.settings.card_radius }}px;--flip-card-width:{{ section.settings.card_width }}px">
 <h2>{{ section.settings.heading | escape }}</h2>
 <div class="journal-flipbook__desk" data-book-desk><div class="journal-flipbook__instructions"><span>{{ section.settings.drag_back | escape }}</span><span>{{ section.settings.drag_next | escape }}</span></div>
  <div class="journal-flipbook__stage" data-book-stage>
   <div class="journal-flipbook__fallback" data-book-fallback>{% assign first_page = preview.front_image.value %}{{ first_page | image_url: width: 1000 | image_tag: loading: 'lazy', alt: first_page.alt }}{% assign second_page = preview.page_1.value %}{{ second_page | image_url: width: 1000 | image_tag: loading: 'lazy', alt: second_page.alt }}</div>
   {% if section.settings.peel_hint %}<button id="flip-page-peel-hint" type="button" class="journal-flipbook__peel" data-book-peel aria-label="{{ section.settings.peel_label | escape }}" hidden><span class="journal-flipbook__fold"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 17c1-7 8-9 14-6m-5-5 5 5-6 3"/></svg></span><span class="journal-flipbook__tooltip">{{ section.settings.peel_label | escape }}</span></button>{% endif %}
  </div>
 </div>
 <div class="journal-flipbook__controls"><button type="button" data-book-back disabled>{{ section.settings.back_label | escape }}</button><span data-book-count role="status" aria-live="polite"{% unless section.settings.show_counter %} class="visually-hidden"{% endunless %}></span><button type="button" data-book-next>{{ section.settings.next_label | escape }}</button></div>
 <p class="visually-hidden" data-book-status role="status"></p>
 <script type="application/json" data-book-images>[{% assign separator = '' %}{% for page_key in page_keys %}{% assign page = preview[page_key].value %}{% if page != blank %}{{ separator }}{"src":{{ page | image_url: width: 1600 | json }},"alt":{{ page.alt | default: preview.name.value | json }}}{% assign separator = ',' %}{% endif %}{% endfor %}]</script>
</journal-flipbook>
{% else %}{% style %}#shopify-section-{{ section.id }}{display:none}{% endstyle %}{% endif %}
{% schema %}
{
  "name": "Journal page preview",
  "tag": "section",
  "class": "journal-preview-section",
  "limit": 1,
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Select a Journal Preview metaobject in Products → Metafields → Journal · Preview book. Edit its journal name, details, front image, pages 1–4 and back image in Content → Metaobjects → Journal Preview."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Flip through a few inner pages!"
    },
    {
      "type": "text",
      "id": "back_label",
      "label": "Back button",
      "default": "‹ Back"
    },
    {
      "type": "text",
      "id": "next_label",
      "label": "Next button",
      "default": "Next ›"
    },
    {
      "type": "text",
      "id": "peel_label",
      "label": "Corner tooltip",
      "default": "Flip page ›"
    },
    {
      "type": "text",
      "id": "counter_label",
      "label": "Page count label",
      "default": "Page"
    },
    {
      "type": "text",
      "id": "error_label",
      "label": "Fallback announcement",
      "default": "Use Back and Next to browse the page images."
    },
    {
      "type": "range",
      "id": "page_width",
      "label": "Desktop single-page width",
      "min": 280,
      "max": 440,
      "step": 10,
      "default": 380,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "turn_time",
      "label": "Page turn duration",
      "min": 400,
      "max": 1200,
      "step": 50,
      "default": 700,
      "unit": "ms"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Desk background",
      "default": "#F8F5ED"
    },
    {
      "type": "color",
      "id": "coffee",
      "label": "Control color",
      "default": "#4D351D"
    },
    {
      "type": "checkbox",
      "id": "peel_hint",
      "label": "Show animated page corner",
      "default": true
    },
    {
      "type": "header",
      "content": "Outer preview card"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#FDFCFA"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Card border",
      "default": "#E6D9C1"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Maximum card width",
      "min": 680,
      "max": 1100,
      "step": 20,
      "default": 840,
      "unit": "px"
    },
    {
      "type": "text",
      "id": "drag_back",
      "label": "Back instruction",
      "default": "← Drag corner or tap to turn back"
    },
    {
      "type": "text",
      "id": "drag_next",
      "label": "Next instruction",
      "default": "Drag corner or tap to turn next →"
    },
    {
      "type": "checkbox",
      "id": "show_counter",
      "label": "Show page counter",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Journal page preview"
    }
  ]
}
{% endschema %}