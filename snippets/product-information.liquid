{% doc %}
  Product information accordions controlled by customizer accordion blocks.
  Supports dynamic source metafields connected in the customizer.
{% enddoc %}
{% liquid
  assign has_accordions = false
  for block in section.blocks
    if block.type == 'accordion'
      assign block_content = block.settings.content | default: block.settings.page.content
      if block.settings.heading != blank or block_content != blank
        assign has_accordions = true
        break
      endif
    endif
  endfor
%}

{% if has_accordions %}
  <div class="atelier-pdp__accordions">
    {% for block in section.blocks %}
      {% if block.type == 'accordion' %}
        {% assign block_content = block.settings.content | default: block.settings.page.content %}
        {% if block.settings.heading != blank or block_content != blank %}
          <details{% if block.settings.open %} open{% endif %} {{ block.shopify_attributes }}>
            <summary>
              {{ block.settings.heading | default: 'Details' | escape }}
              <span class="atelier-pdp__accordion-chevron" aria-hidden="true">{% render 'header-icon', name: 'chevron' %}</span>
            </summary>
            <div class="atelier-pdp__accordion-content">
              {% if block_content != blank %}
                {{ block_content }}
              {% endif %}
            </div>
          </details>
        {% endif %}
      {% endif %}
    {% endfor %}
  </div>
{% endif %}
