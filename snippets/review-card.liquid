{% doc %}
  Renders a customer review or a labelled Theme Editor sample.
  @param {object} block - Review block.
  @param {object} section - Reviews section.
{% enddoc %}
<article class="atelier-review" role="listitem" data-review-id="{{ block.id }}" {{ block.shopify_attributes }}>
  {% if request.design_mode and block.settings.publish_review == false %}<p class="atelier-review__sample">{{ section.settings.sample_label | escape }}</p>{% endif %}
  <div class="atelier-review__stars" role="img" aria-label="{{ section.settings.rating_label | escape }}: {{ block.settings.rating }} / 5">
    {% for star in (1..5) %}<svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"{% if star > block.settings.rating %} class="atelier-review__star--empty"{% endif %}><path d="m12 2 3.09 6.26 6.91 1.01-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01Z"/></svg>{% endfor %}
  </div>
  <blockquote><p>{{ block.settings.quote | escape | newline_to_br }}</p></blockquote>
  <div class="atelier-review__author">
    <span class="atelier-review__avatar" aria-hidden="true">{% if block.settings.avatar != blank %}{{ block.settings.avatar | image_url: width: 88 | image_tag: loading: 'lazy', widths: '44,88', sizes: '44px', alt: '' }}{% else %}{{ block.settings.initials | default: block.settings.author | slice: 0, 2 | upcase | escape }}{% endif %}</span>
    <div><p class="atelier-review__name">{{ block.settings.author | escape }}</p>{% if block.settings.meta != blank %}<p class="atelier-review__meta">{{ block.settings.meta | escape }}</p>{% endif %}{% if block.settings.verified and block.settings.publish_review %}<span class="atelier-review__verified"><svg viewBox="0 0 20 20" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m4 10 4 4 8-8"/></svg>{{ section.settings.verified_label | escape }}</span>{% endif %}</div>
  </div>
</article>