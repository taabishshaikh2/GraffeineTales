{% doc %}
  Renders the tagged product pill inside a shoppable reel card.
  @param {product} product - Tagged product.
  @param {object} section - Reels section.
  @param {string} form_id - Unique form identifier.
{% enddoc %}

{% if product != blank %}
  {% assign reel_variant = product.selected_or_first_available_variant %}
  <div class="atelier-reel__pill" data-reel-product>
    <a class="atelier-reel__pill-left" href="{{ product.url }}">
      {% if product.featured_image != blank %}
        <img
          class="atelier-reel__pill-thumb"
          src="{{ product.featured_image | image_url: width: 140 }}"
          alt="{{ product.title | escape }}"
          width="44"
          height="44"
          loading="lazy"
        >
      {% else %}
        <div class="atelier-reel__pill-thumb atelier-reel__pill-thumb--placeholder"></div>
      {% endif %}
      <div class="atelier-reel__pill-info">
        <span class="atelier-reel__pill-title" title="{{ product.title | escape }}">{{ product.title | escape }}</span>
        <div class="atelier-reel__pill-price">
          <span class="atelier-reel__pill-current">{{ reel_variant.price | money }}</span>
          {% if reel_variant.compare_at_price > reel_variant.price %}
            <s class="atelier-reel__pill-compare">{{ reel_variant.compare_at_price | money }}</s>
          {% endif %}
        </div>
      </div>
    </a>

    {% if product.available and reel_variant.available and product.requires_selling_plan == false %}
      {% form 'product', product, id: form_id, data-atelier-product-form: '', class: 'atelier-reel__pill-form' %}
        <input type="hidden" name="id" value="{{ reel_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button
          type="submit"
          class="atelier-reel__pill-atc"
          data-preserve-button-content
          aria-label="{{ section.settings.add_label | default: 'Add to Cart' | escape }}: {{ product.title | escape }}"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="#F5C518" aria-hidden="true">
            <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/>
          </svg>
        </button>
      {% endform %}
    {% else %}
      <a href="{{ product.url }}" class="atelier-reel__pill-atc" aria-label="View product: {{ product.title | escape }}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="#F5C518" aria-hidden="true">
          <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/>
        </svg>
      </a>
    {% endif %}
    <p class="atelier-reel__cart-error" data-cart-error role="alert" hidden></p>
  </div>
{% endif %}
