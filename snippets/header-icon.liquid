{% doc %}
  Renders a stroke icon for storefront navigation.
  @param {string} name - Icon name.
  @param {string} [class] - Optional extra class.
{% enddoc %}
<svg class="{{ class }}" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{% case name %}
{% when 'menu' %}<path d="M4 6h16M4 12h16M4 18h16"/>
{% when 'close' %}<path d="m6 6 12 12M6 18 18 6"/>
{% when 'heart' %}<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"/>
{% when 'bag' %}<path d="M5 7h14l1 14H4L5 7ZM9 8V6a3 3 0 0 1 6 0v2"/>
{% when 'cart' %}<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
{% when 'chevron' %}<path d="m7 10 5 5 5-5"/>
{% when 'chevron-right' %}<path d="m9 6 6 6-6 6"/>
{% when 'arrow' %}<path d="M5 12h14m-6-6 6 6-6 6"/>
{% when 'account' or 'user' %}<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
{% when 'search' %}<circle cx="11" cy="11" r="7"/><path d="m20 20-4.35-4.35"/>
{% when 'phone' %}<path d="M5 4h3.2l1.6 4-2 1.3a10.5 10.5 0 0 0 4.9 4.9l1.3-2 4 1.6V17a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2Z"/>
{% when 'lock' %}<rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
{% endcase %}
</svg>
