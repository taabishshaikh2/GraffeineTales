      "blocks": {
        "faq_1": {
          "type": "faq",
          "settings": {
            "question": "What makes Graffeine Tales products unique?",
            "answer": "<p>Each piece is slow-crafted with intention in our Indian studio — from archival 120–350 GSM textured papers and vegan leather book bindings to die-cut weatherproof vinyl stickers and solid teakwood desk accessories.</p>",
            "open": true
          }
        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "question": "How long does shipping & delivery take?",
            "answer": "<p>Orders are dispatched within 2–3 business days. Delivery across major Indian cities typically takes 4–7 business days with end-to-end tracking provided via email and WhatsApp.</p>",
            "open": false
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "question": "Are the stickers waterproof & scratch-resistant?",
            "answer": "<p>Yes! All our stickers are precision die-cut on premium matte vinyl with UV-resistant inks. They are 100% waterproof, scratch-proof, and safe for laptops, water bottles, and journals.</p>",
            "open": false
          }
        },
        "faq_4": {
          "type": "faq",
          "settings": {
            "question": "What is your return & exchange policy?",
            "answer": "<p>We take immense pride in our craftsmanship. If your item arrives damaged or defective, please contact our support team within 48 hours for an instant replacement or full refund.</p>",
            "open": false
          }
        }
      },
