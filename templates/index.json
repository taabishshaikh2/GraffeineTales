        "review_2": {
          "type": "review",
          "settings": {
            "publish_review": false,
            "quote": "The 'Progress Not Perfection' 2026 desk calendar brings so much joy each morning. The illustrated cutout cards in the grooved wooden stand are pure genius. Best gifting find of the year.",
