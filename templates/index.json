        "review_3": {
          "type": "review",
          "settings": {
            "publish_review": false,
            "quote": "We ordered 150 'Chugli Over Chai' coasters and customized welcome kits for our creative agency. The witty desi humor paired with premium packaging had the whole team cheering.",
            "author": "Vikram Kapoor",
            "meta": "Managing Partner, Studio Kula",
            "initials": "VK",
            "rating": 5,
            "verified": false
          }
        },
        "review_4": {
          "type": "review",
          "settings": {
            "publish_review": false,
            "quote": "The tactile woven linen binding and 120 GSM bamboo paper take fountain pen ink without any feathering. It feels like an heirloom keepsake straight out of an old European bookshop.",
