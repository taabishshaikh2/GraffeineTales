    "about_story": {
      "type": "about-story",
      "blocks": {
        "paragraph_1": {
          "type": "paragraph",
          "settings": {
            "text": "<p>It all began with events big ideas, little details, tight deadlines, and a whole lot of hustle.</p>",
            "style": "body"
          }
        },
        "paragraph_2": {
          "type": "paragraph",
          "settings": {
            "text": "<p>From planning experiences to designing them, creativity slowly found a home beyond event spaces. Somewhere between the last-minute changes, late-night deadlines, and endless cups of coffee, a new idea began to brew.</p>",
            "style": "body"
          }
        }
      },
